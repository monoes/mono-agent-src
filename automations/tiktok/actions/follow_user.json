{
  "$schema": "../../../data/schemas/action.v1.schema.json",
  "actionType": "follow_user",
  "platform": "TIKTOK",
  "version": "1.1.0",
  "description": "Follow TikTok users from a list of profile URLs. If you and the account both have TikTok's profile view history on, it shows them that you viewed their profile.",
  "sideEffects": "write",
  "visibility": ["profile_view_visible_to_owner"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Profile URLs to follow"
      }
    ],
    "optional": [
      {
        "name": "delayBetweenFollows",
        "type": "number",
        "default": 5,
        "min": 2,
        "max": 60,
        "description": "Seconds to wait between follows"
      },
      {
        "name": "maxFollowsPerRun",
        "type": "number",
        "default": 10,
        "min": 1,
        "max": 50,
        "description": "Limit: max follows in one run (default 10, hard max 50)"
      }
    ]
  },
  "outputs": {
    "success": [
      "success",
      "profileURL",
      "username",
      "status"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "t1_follow_user",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "follow_user",
      "args": [
        "{{item.url or item}}"
      ],
      "variable_name": "followResult",
      "timeout": 60,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "wait",
      "type": "wait",
      "duration": "{{delayBetweenFollows or 5}}",
      "waitFor": "time"
    },
    {
      "id": "log_success",
      "type": "log",
      "value": "Followed: {{item.url or item}}"
    }
  ],
  "loops": [
    {
      "id": "process_profiles",
      "iterator": "selectedListItems",
      "maxItems": "{{maxFollowsPerRun or 10}}",
      "indexVar": "reachedIndex",
      "steps": [
        "t1_follow_user",
        "wait",
        "log_success"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 2,
    "retryDelay": 3000,
    "onFinalFailure": "log_and_continue"
  }
}
