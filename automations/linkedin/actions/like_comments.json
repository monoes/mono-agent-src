{
  "$schema": "../../../data/schemas/action.v1.schema.json",
  "actionType": "like_comments",
  "platform": "LINKEDIN",
  "version": "1.1.0",
  "description": "Like comments on a LinkedIn post by comment URN ID",
  "sideEffects": "write",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "postUrl",
        "type": "string",
        "description": "URL of the post containing the comments"
      },
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Comment URN IDs to like (from list_post_comments output)"
      }
    ],
    "optional": [
      {
        "name": "delayBetweenLikes",
        "type": "number",
        "default": 2,
        "min": 1,
        "max": 30
      },
      {
        "name": "maxLikesPerRun",
        "type": "number",
        "default": 10,
        "min": 1,
        "max": 50,
        "description": "Limit: max likes in one run (default 10, hard max 50)"
      }
    ]
  },
  "outputs": {
    "success": ["success", "postURL", "commentID", "already_liked"],
    "failure": ["failedItems"]
  },
  "steps": [
    {
      "id": "t1_like_comment",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "like_comment",
      "args": ["{{postUrl}}", "{{item.id or item.url or item}}"],
      "variable_name": "likeResult",
      "timeout": 60,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "wait",
      "type": "wait",
      "duration": "{{delayBetweenLikes or 2}}",
      "waitFor": "time"
    },
    {
      "id": "log",
      "type": "log",
      "value": "Liked comment: {{item.id or item.url or item}}"
    }
  ],
  "loops": [
    {
      "id": "process_comments",
      "iterator": "selectedListItems",
      "maxItems": "{{maxLikesPerRun or 10}}",
      "indexVar": "reachedIndex",
      "steps": ["t1_like_comment", "wait", "log"]
    }
  ],
  "errorHandling": {
    "globalRetries": 2,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
