{
  "$schema": "../../../data/schemas/action.v1.schema.json",
  "actionType": "like_posts",
  "platform": "LINKEDIN",
  "version": "1.1.0",
  "description": "React to LinkedIn posts (Like, Celebrate, Support, Love, Insightful, Funny)",
  "sideEffects": "write",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Post URLs to react to"
      }
    ],
    "optional": [
      {
        "name": "reaction",
        "type": "select",
        "default": "like",
        "options": ["like", "celebrate", "support", "love", "insightful", "funny"]
      },
      {
        "name": "delayBetweenLikes",
        "type": "number",
        "default": 3,
        "min": 1,
        "max": 60
      },
      {
        "name": "maxLikesPerRun",
        "type": "number",
        "default": 10,
        "min": 1,
        "max": 50,
        "description": "Limit: max likes in one run (default 10, hard max 50)"
      }
    ]
  },
  "outputs": {
    "success": ["success", "postURL", "reaction", "already_reacted", "current_reaction"],
    "failure": ["failedItems"]
  },
  "steps": [
    {
      "id": "t1_like_post",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "like_post",
      "args": ["{{item.url or item}}", "{{reaction or 'like'}}"],
      "variable_name": "likeResult",
      "timeout": 60,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "wait",
      "type": "wait",
      "duration": "{{delayBetweenLikes or 3}}",
      "waitFor": "time"
    },
    {
      "id": "log",
      "type": "log",
      "value": "Liked: {{item.url or item}}"
    }
  ],
  "loops": [
    {
      "id": "process_posts",
      "iterator": "selectedListItems",
      "maxItems": "{{maxLikesPerRun or 10}}",
      "indexVar": "reachedIndex",
      "steps": ["t1_like_post", "wait", "log"]
    }
  ],
  "errorHandling": {
    "globalRetries": 2,
    "retryDelay": 3000,
    "onFinalFailure": "log_and_continue"
  }
}
