{
  "name": "Telegram RSS Notify",
  "summary": "Sends the morning's top stories from a news feed to you on Telegram.",
  "description": "Every morning: read an RSS feed and send its items as one Telegram message from a bot. Set the bot token (from @BotFather) and chat ID before activating.",
  "version": 1,
  "is_active": false,
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger.schedule",
      "name": "Every Morning 8am",
      "position": { "x": 0, "y": 0 },
      "disabled": false,
      "config": {
        "cron": "0 0 8 * * *",
        "timezone": "UTC"
      }
    },
    {
      "id": "read_feed",
      "type": "system.rss_read",
      "name": "Read RSS Feed",
      "position": { "x": 320, "y": 0 },
      "disabled": false,
      "config": {
        "url": "https://hnrss.org/frontpage",
        "limit": 5
      }
    },
    {
      "id": "digest",
      "type": "core.code",
      "name": "Build Digest",
      "position": { "x": 600, "y": 0 },
      "disabled": false,
      "config": {
        "code": "(function () {\n  const lines = $input.all().map(function (item, i) {\n    return (i + 1) + '. ' + item.title + '\\n   ' + item.link;\n  });\n  return [{ text: 'Top stories:\\n' + lines.join('\\n') }];\n})()"
      }
    },
    {
      "id": "notify",
      "type": "comm.telegram",
      "name": "Send Telegram Message",
      "position": { "x": 900, "y": 0 },
      "disabled": false,
      "config": {
        "bot_token": "REPLACE_WITH_BOT_TOKEN",
        "operation": "send_message",
        "chat_id": "REPLACE_WITH_CHAT_ID",
        "message": "{{ $json.text }}",
        "parse_mode": "plain"
      }
    }
  ],
  "connections": [
    {
      "id": "trigger-to-read_feed",
      "source": "trigger",
      "source_handle": "main",
      "target": "read_feed",
      "target_handle": "main"
    },
    {
      "id": "read_feed-to-digest",
      "source": "read_feed",
      "source_handle": "main",
      "target": "digest",
      "target_handle": "main"
    },
    {
      "id": "digest-to-notify",
      "source": "digest",
      "source_handle": "main",
      "target": "notify",
      "target_handle": "main"
    }
  ]
}
