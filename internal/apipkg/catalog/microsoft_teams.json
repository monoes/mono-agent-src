    {
      "resource": "onlineMeeting",
      "operation": "update",
      "title": "Update an online meeting",
      "method": "PATCH",
      "path": "/{{ p.organizerId | rl | then:'users' | default:'me' }}{{ p.organizerId | rl | then:'/' }}{{ p.organizerId | rl }}/onlineMeetings/{{ pres.0.value.0.id | default:(p.meetingId | rl) }}",
      "fields": [
        {
          "key": "organizerId",
          "label": "Organizer (app-only)",
          "type": "text",
          "help": "Only with an Entra app connection: the user whose meetings to manage."
        },
        {
          "key": "meetingId",
          "label": "Meeting ID",
          "type": "text",
          "required": true,
          "help": "The online meeting's ID, or n8n's locator in url mode with the meeting's join URL (looked up first)."
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "subject",
            "startDateTime",
            "endDateTime",
            "attendees",
            "removeAllAttendees",
            "lobbyBypassScope",
            "allowAttendeeToEnableCamera",
            "allowAttendeeToEnableMic",
            "allowMeetingChat",
            "allowTeamworkReactions",
            "allowedPresenters",
            "isEntryExitAnnounced",
            "recordAutomatically"
          ],
          "help": "Start and end time go together; attendees: {attendee: [{userId, role}]} replaces the list."
        }
      ],
      "before": [
        {
          "when": "{{ p.meetingId.mode | eq:'url' }}",
          "method": "GET",
          "path": "/{{ p.organizerId | rl | then:'users' | default:'me' }}{{ p.organizerId | rl | then:'/' }}{{ p.organizerId | rl }}/onlineMeetings",
          "query": {
            "$filter": "JoinWebUrl eq '{{ p.meetingId | rl | replace:\"'\",\"''\" }}'"
          }
        },
        {
          "for_each": "{{ p.updateFields.attendees.attendee }}",
          "method": "GET",
          "path": "/users/{{ el.userId | rl }}",
          "query": {
            "$select": "id,userPrincipalName"
          }
        }
      ],
      "body": {
        "$merge": "{{ p.updateFields | pick:'allowAttendeeToEnableCamera,allowAttendeeToEnableMic,allowMeetingChat,allowTeamworkReactions,allowedPresenters,isEntryExitAnnounced,recordAutomatically' }}",
        "lobbyBypassSettings": {
          "scope": "{{ p.updateFields.lobbyBypassScope }}"
        },
        "subject": "{{ p.updateFields.subject }}",
        "startDateTime": "{{ p.updateFields.startDateTime | date:'YYYY-MM-DDTHH:mm:ssZ' }}",
        "endDateTime": "{{ p.updateFields.endDateTime | date:'YYYY-MM-DDTHH:mm:ssZ' }}",
        "participants": {
          "$when": "{{ p.updateFields.removeAllAttendees | default:p.updateFields.attendees.attendee }}",
          "!attendees": {
            "$map": "{{ p.updateFields.attendees.attendee }}",
            "$to": {
              "identity": {
                "user": {
                  "id": "{{ pre | get:(idx | string) | get:'id' }}"
                }
              },
              "upn": "{{ pre | get:(idx | string) | get:'userPrincipalName' }}",
              "role": "{{ el.role | default:'attendee' }}"
            }
          }
        }
      }
