{
  "$schema": "apipkg.v1",
  "id": "microsoft_teams",
  "node_type": "app.microsoft_teams",
  "title": "Microsoft Teams",
  "description": "Channels, messages, chats, online meetings, Planner tasks and activity notifications in Microsoft Teams (Microsoft Graph)",
  "category": "app",
  "docs_url": "https://learn.microsoft.com/en-us/graph/api/resources/teams-api-overview",
  "n8n_types": [
    "n8n-nodes-base.microsoftTeams"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.microsoftTeamsTrigger"
  ],
  "base_url": "https://graph.microsoft.com/v1.0",
  "credentials": [
    {
      "platform": "microsoft",
      "name": "Microsoft 365 (Teams)",
      "n8n_credential": "microsoftTeamsOAuth2Api",
      "n8n_credential_alt": [
        "microsoftOAuth2Api"
      ],
      "methods": [
        "oauth"
      ],
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      },
      "reuse_platform": "microsoft",
      "scope_group": "teams"
    },
    {
      "platform": "microsoft_entra_app",
      "name": "Microsoft Entra app (app-only Graph)",
      "n8n_credential": "microsoftEntraServicePrincipalApi",
      "n8n_field_map": {
        "tenantId": "tenant_id",
        "clientId": "client_id",
        "clientSecret": "client_secret"
      },
      "methods": [
        "client_credentials"
      ],
      "fields": [
        {
          "key": "tenant_id",
          "label": "Tenant ID",
          "required": true,
          "help": "Directory (tenant) GUID or a verified domain such as contoso.onmicrosoft.com."
        },
        {
          "key": "client_id",
          "label": "Application (client) ID",
          "required": true
        },
        {
          "key": "client_secret",
          "label": "Client secret",
          "secret": true,
          "required": true
        }
      ],
      "oauth": {
        "token_url": "https://login.microsoftonline.com/{{ cred.tenant_id }}/oauth2/v2.0/token",
        "scopes": [
          "https://graph.microsoft.com/.default"
        ]
      },
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "channel",
      "label": "Channel"
    },
    {
      "value": "channelMessage",
      "label": "Channel message"
    },
    {
      "value": "chat",
      "label": "Chat"
    },
    {
      "value": "chatMember",
      "label": "Chat member"
    },
    {
      "value": "chatMessage",
      "label": "Chat message"
    },
    {
      "value": "onlineMeeting",
      "label": "Online meeting"
    },
    {
      "value": "task",
      "label": "Task (Planner)"
    },
    {
      "value": "activityNotification",
      "label": "Activity notification"
    }
  ],
  "operations": [
    {
      "resource": "channel",
      "operation": "create",
      "title": "Create a channel",
      "scope_group": "teams_admin",
      "method": "POST",
      "path": "/teams/{{ p.teamId | rl }}/channels",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "description",
            "type"
          ],
          "help": "type: standard or private."
        }
      ],
      "body": {
        "displayName": "{{ p.name }}",
        "description": "{{ p.options.description }}",
        "membershipType": "{{ p.options.type }}"
      }
    },
    {
      "resource": "channel",
      "operation": "deleteChannel",
      "title": "Delete a channel",
      "scope_group": "teams_admin",
      "method": "DELETE",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "channel",
      "operation": "get",
      "title": "Get a channel",
      "method": "GET",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "channel",
      "operation": "getAll",
      "title": "Get many channels",
      "method": "GET",
      "path": "/teams/{{ p.teamId | rl }}/channels",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "pagination": {
        "type": "next_url",
        "next_url_path": "@odata.nextLink",
        "results_path": "value"
      }
    },
    {
      "resource": "channel",
      "operation": "update",
      "title": "Update a channel",
      "scope_group": "teams_admin",
      "method": "PATCH",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        },
        {
          "key": "name",
          "label": "New name",
          "type": "text"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "description"
          ]
        }
      ],
      "body": {
        "displayName": "{{ p.name }}",
        "description": "{{ p.options.description }}"
      },
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "channelMessage",
      "operation": "create",
      "title": "Send a channel message",
      "method": "POST",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}/messages{{ p.options.makeReply | then:'/' }}{{ p.options.makeReply }}{{ p.options.makeReply | then:'/replies' }}",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        },
        {
          "key": "contentType",
          "label": "Content type",
          "type": "select",
          "default": "text",
          "options": [
            "text",
            "html"
          ]
        },
        {
          "key": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "makeReply",
            "includeLinkToWorkflow",
            "mentionPlacement"
          ],
          "help": "makeReply: ID of a message to reply to. @mentions and the workflow link are not added."
        }
      ],
      "base_url": "https://graph.microsoft.com/beta",
      "body": {
        "body": {
          "contentType": "{{ p.contentType }}",
          "content": "{{ p.message }}"
        }
      }
    },
    {
      "resource": "channelMessage",
      "operation": "softDeleteMessage",
      "title": "Delete a channel message",
      "scope_group": "teams_admin",
      "method": "POST",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}/messages/{{ p.options.parentMessageId | then:(p.options.parentMessageId) }}{{ p.options.parentMessageId | then:'/replies/' }}{{ p.messageId }}/softDelete",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        },
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "parentMessageId"
          ],
          "help": "parentMessageId: set when the message is a reply."
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "channelMessage",
      "operation": "get",
      "title": "Get a channel message",
      "scope_group": "teams_admin",
      "method": "GET",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}/messages/{{ p.messageId }}",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        },
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        }
      ],
      "base_url": "https://graph.microsoft.com/beta"
    },
    {
      "resource": "channelMessage",
      "operation": "getAll",
      "title": "Get many channel messages",
      "scope_group": "teams_admin",
      "method": "GET",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}/messages",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "base_url": "https://graph.microsoft.com/beta",
      "pagination": {
        "type": "next_url",
        "next_url_path": "@odata.nextLink",
        "results_path": "value",
        "limit_param": "$top",
        "page_size": 50
      }
    },
    {
      "resource": "channelMessage",
      "operation": "getAllReplies",
      "title": "Get many replies",
      "scope_group": "teams_admin",
      "method": "GET",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}/messages/{{ p.messageId }}/replies",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        },
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "base_url": "https://graph.microsoft.com/beta",
      "pagination": {
        "type": "next_url",
        "next_url_path": "@odata.nextLink",
        "results_path": "value",
        "limit_param": "$top",
        "page_size": 50
      }
    },
    {
      "resource": "channelMessage",
      "operation": "reply",
      "title": "Reply to a channel message",
      "method": "POST",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}/messages/{{ p.messageId }}/replies",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        },
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "contentType",
          "label": "Content type",
          "type": "select",
          "default": "text",
          "options": [
            "text",
            "html"
          ]
        },
        {
          "key": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "includeLinkToWorkflow",
            "mentionPlacement"
          ]
        }
      ],
      "base_url": "https://graph.microsoft.com/beta",
      "body": {
        "body": {
          "contentType": "{{ p.contentType }}",
          "content": "{{ p.message }}"
        }
      }
    },
    {
      "resource": "channelMessage",
      "operation": "undoSoftDeleteMessage",
      "title": "Restore a deleted channel message",
      "scope_group": "teams_admin",
      "method": "POST",
      "path": "/teams/{{ p.teamId | rl }}/channels/{{ p.channelId | rl }}/messages/{{ p.options.parentMessageId | then:(p.options.parentMessageId) }}{{ p.options.parentMessageId | then:'/replies/' }}{{ p.messageId }}/undoSoftDelete",
      "fields": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "text",
          "required": true
        },
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "text",
          "required": true
        },
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "parentMessageId"
          ],
          "help": "parentMessageId: set when the message is a reply."
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "chat",
      "operation": "create",
      "title": "Create a chat",
      "method": "POST",
      "path": "/chats",
      "fields": [
        {
          "key": "chatType",
          "label": "Chat type",
          "type": "select",
          "default": "oneOnOne",
          "options": [
            "oneOnOne",
            "group"
          ]
        },
        {
          "key": "members",
          "label": "Other participants",
          "type": "collection",
          "default": {},
          "options": [
            "member"
          ],
          "help": "{member: [{userId, role (owner|guest), tenantId}]} — you are added automatically."
        },
        {
          "key": "topic",
          "label": "Topic",
          "type": "text",
          "help": "Group chats only."
        }
      ],
      "before": {
        "method": "GET",
        "path": "/me",
        "query": {
          "$select": "id,userPrincipalName,userType"
        }
      },
      "body": {
        "chatType": "{{ p.chatType }}",
        "topic": "{{ p.chatType | eq:'group' | then:p.topic }}",
        "members": {
          "$concat": [
            {
              "@odata.type": "#microsoft.graph.aadUserConversationMember",
              "roles": [
                "{{ pre.userType | eq:'Guest' | then:'guest' | default:'owner' }}"
              ],
              "user@odata.bind": "https://graph.microsoft.com/v1.0/users('{{ pre.id }}')"
            },
            {
              "$map": "{{ p.members.member }}",
              "$to": {
                "@odata.type": "#microsoft.graph.aadUserConversationMember",
                "roles": [
                  "{{ el.role | default:'owner' }}"
                ],
                "user@odata.bind": "https://graph.microsoft.com/v1.0/users('{{ el.userId | rl }}')",
                "tenantId": "{{ el.tenantId }}"
              }
            }
          ]
        }
      }
    },
    {
      "resource": "chat",
      "operation": "get",
      "title": "Get a chat",
      "method": "GET",
      "path": "/chats/{{ p.chatId | rl }}",
      "fields": [
        {
          "key": "chatId",
          "label": "Chat ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "chat",
      "operation": "getAll",
      "title": "Get many chats",
      "method": "GET",
      "path": "/chats",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "pagination": {
        "type": "next_url",
        "next_url_path": "@odata.nextLink",
        "results_path": "value",
        "limit_param": "$top",
        "page_size": 50
      }
    },
    {
      "resource": "chatMember",
      "operation": "getAll",
      "title": "Get many chat members",
      "method": "GET",
      "path": "/chats/{{ p.chatId | rl }}/members",
      "fields": [
        {
          "key": "chatId",
          "label": "Chat ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "pagination": {
        "type": "next_url",
        "next_url_path": "@odata.nextLink",
        "results_path": "value"
      }
    },
    {
      "resource": "chatMember",
      "operation": "add",
      "title": "Add a chat member",
      "method": "POST",
      "path": "/chats/{{ p.chatId | rl }}/members",
      "fields": [
        {
          "key": "chatId",
          "label": "Chat ID",
          "type": "text",
          "required": true
        },
        {
          "key": "userId",
          "label": "User ID",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "role",
            "shareHistory",
            "historyStartDate"
          ],
          "help": "role: owner or guest; shareHistory: none, all or fromDate (with historyStartDate)."
        }
      ],
      "body": {
        "@odata.type": "#microsoft.graph.aadUserConversationMember",
        "roles": [
          "{{ p.options.role | eq:'guest' | then:'guest' | default:'owner' }}"
        ],
        "user@odata.bind": "https://graph.microsoft.com/v1.0/users('{{ p.userId | rl }}')",
        "visibleHistoryStartDateTime": "{{ p.options.shareHistory | eq:'all' | then:'0001-01-01T00:00:00Z' | default:(p.options.shareHistory | eq:'fromDate' | then:p.options.historyStartDate) }}"
      },
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "chatMember",
      "operation": "remove",
      "title": "Remove a chat member",
      "method": "DELETE",
      "path": "/chats/{{ p.chatId | rl }}/members/{{ p.membershipId | rl }}",
      "fields": [
        {
          "key": "chatId",
          "label": "Chat ID",
          "type": "text",
          "required": true
        },
        {
          "key": "membershipId",
          "label": "Membership ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "chatMessage",
      "operation": "create",
      "title": "Send a chat message",
      "method": "POST",
      "path": "/chats/{{ p.chatId | rl }}/messages",
      "fields": [
        {
          "key": "chatId",
          "label": "Chat ID",
          "type": "text",
          "required": true
        },
        {
          "key": "contentType",
          "label": "Content type",
          "type": "select",
          "default": "text",
          "options": [
            "text",
            "html"
          ]
        },
        {
          "key": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "includeLinkToWorkflow",
            "mentionPlacement"
          ],
          "help": "@mentions and the workflow link are not added."
        }
      ],
      "body": {
        "body": {
          "contentType": "{{ p.contentType }}",
          "content": "{{ p.message }}"
        }
      }
    },
    {
      "resource": "chatMessage",
      "operation": "softDeleteMessage",
      "title": "Delete a chat message",
      "method": "POST",
      "path": "/users/{{ pre.id }}/chats/{{ p.chatId | rl }}/messages/{{ p.messageId }}/softDelete",
      "fields": [
        {
          "key": "chatId",
          "label": "Chat ID",
          "type": "text",
          "required": true
        },
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        }
      ],
      "before": {
        "method": "GET",
        "path": "/me",
        "query": {
          "$select": "id"
        }
      },
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "chatMessage",
      "operation": "get",
      "title": "Get a chat message",
      "method": "GET",
      "path": "/chats/{{ p.chatId | rl }}/messages/{{ p.messageId }}",
      "fields": [
        {
          "key": "chatId",
          "label": "Chat ID",
          "type": "text",
          "required": true
        },
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "chatMessage",
      "operation": "getAll",
      "title": "Get many chat messages",
      "method": "GET",
      "path": "/chats/{{ p.chatId | rl }}/messages",
      "fields": [
        {
          "key": "chatId",
          "label": "Chat ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
