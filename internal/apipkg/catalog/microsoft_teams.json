    {
      "resource": "onlineMeeting",
      "operation": "create",
      "title": "Create an online meeting",
      "method": "POST",
      "path": "/{{ p.organizerId | rl | then:'users' | default:'me' }}{{ p.organizerId | rl | then:'/' }}{{ p.organizerId | rl }}/onlineMeetings",
      "fields": [
        {
          "key": "organizerId",
          "label": "Organizer (app-only)",
          "type": "text",
          "help": "Only with an Entra app connection: the user whose meetings to manage."
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "text",
          "required": true
        },
        {
          "key": "startDateTime",
          "label": "Start time",
          "type": "datetime",
          "required": true
        },
        {
          "key": "endDateTime",
          "label": "End time",
          "type": "datetime",
          "required": true
        },
        {
          "key": "attendees",
          "label": "Attendees",
          "type": "collection",
          "default": {},
          "options": [
            "attendee"
          ],
          "help": "{attendee: [{userId, role (attendee|presenter)}]}"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "passcodeRequired",
            "lobbyBypassScope",
            "allowAttendeeToEnableCamera",
            "allowAttendeeToEnableMic",
            "allowMeetingChat",
            "allowTeamworkReactions",
            "allowedPresenters",
            "isEntryExitAnnounced",
            "recordAutomatically"
          ]
        }
      ],
      "before": {
        "for_each": "{{ p.attendees.attendee }}",
        "method": "GET",
        "path": "/users/{{ el.userId | rl }}",
        "query": {
          "$select": "id,userPrincipalName"
        }
      },
      "body": {
        "$merge": "{{ p.options | pick:'allowAttendeeToEnableCamera,allowAttendeeToEnableMic,allowMeetingChat,allowTeamworkReactions,allowedPresenters,isEntryExitAnnounced,recordAutomatically' }}",
        "lobbyBypassSettings": {
          "scope": "{{ p.options.lobbyBypassScope }}"
        },
        "subject": "{{ p.subject }}",
        "startDateTime": "{{ p.startDateTime | date:'YYYY-MM-DDTHH:mm:ssZ' }}",
        "endDateTime": "{{ p.endDateTime | date:'YYYY-MM-DDTHH:mm:ssZ' }}",
        "joinMeetingIdSettings": {
          "isPasscodeRequired": "{{ p.options.passcodeRequired }}"
        },
        "participants": {
          "attendees": {
            "$map": "{{ p.attendees.attendee }}",
            "$to": {
              "identity": {
                "user": {
                  "id": "{{ pre | get:(idx | string) | get:'id' }}"
                }
              },
              "upn": "{{ pre | get:(idx | string) | get:'userPrincipalName' }}",
              "role": "{{ el.role | default:'attendee' }}"
            }
          }
        }
      }
    },
