{
  "$schema": "apipkg.v1",
  "id": "intercom",
  "node_type": "app.intercom",
  "title": "Intercom",
  "description": "Users, leads and companies in Intercom",
  "category": "app",
  "docs_url": "https://developers.intercom.com/docs/references/rest-api/api.intercom.io/",
  "n8n_types": [
    "n8n-nodes-base.intercom"
  ],
  "base_url": "https://api.intercom.io",
  "headers": {
    "Accept": "application/json"
  },
  "credentials": [
    {
      "platform": "intercom",
      "name": "Intercom",
      "n8n_credential": "intercomApi",
      "n8n_field_map": {
        "apiKey": "access_token"
      },
      "methods": [
        "bearer"
      ],
      "fields": [
        {
          "key": "access_token",
          "label": "Access token",
          "secret": true,
          "required": true,
          "help": "Developer Hub → your app → Authentication"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "user",
      "label": "User"
    },
    {
      "value": "lead",
      "label": "Lead"
    },
    {
      "value": "company",
      "label": "Company"
    }
  ],
  "operations": [
    {
      "resource": "user",
      "operation": "create",
      "title": "Create a user",
      "method": "POST",
      "path": "/users",
      "fields": [
        {
          "key": "identifierType",
          "label": "Identifier type",
          "type": "select",
          "options": [
            "userId",
            "email"
          ],
          "default": ""
        },
        {
          "key": "idValue",
          "label": "Identifier value",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "avatar",
            "companies",
            "email",
            "name",
            "phone",
            "sessionCount",
            "userId",
            "unsubscribedFromEmails",
            "updateLastRequestAt",
            "utmCampaign",
            "utmContent",
            "utmMedium",
            "utmSource",
            "utmTerm"
          ],
          "help": "companies: list of company IDs; avatar: image URL"
        },
        {
          "key": "jsonParameters",
          "label": "JSON parameters",
          "type": "boolean",
          "default": false,
          "help": "Give custom attributes as JSON instead of name/value rows"
        },
        {
          "key": "customAttributesJson",
          "label": "Custom attributes (JSON)",
          "type": "json",
          "default": ""
        },
        {
          "key": "customAttributesUi",
          "label": "Custom attributes",
          "type": "collection",
          "default": {},
          "options": [
            "customAttributesValues"
          ],
          "help": "customAttributesValues: list of {name, value}"
        }
      ],
      "body": {
        "email": "{{ p.additionalFields.email | default:(p.identifierType | eq:'email' | then:p.idValue) }}",
        "phone": "{{ p.additionalFields.phone }}",
        "name": "{{ p.additionalFields.name }}",
        "unsubscribed_from_emails": "{{ p.additionalFields.unsubscribedFromEmails | eq:'true' | then:true }}",
        "update_last_request_at": "{{ p.additionalFields.updateLastRequestAt | eq:'true' | then:true }}",
        "utm_source": "{{ p.additionalFields.utmSource }}",
        "utm_medium": "{{ p.additionalFields.utmMedium }}",
        "utm_campaign": "{{ p.additionalFields.utmCampaign }}",
        "utm_term": "{{ p.additionalFields.utmTerm }}",
        "utm_content": "{{ p.additionalFields.utmContent }}",
        "avatar": {
          "$when": "{{ p.additionalFields.avatar }}",
          "type": "avatar",
          "image_url": "{{ p.additionalFields.avatar }}"
        },
        "companies": {
          "$map": "{{ p.additionalFields.companies }}",
          "$to": {
            "company_id": "{{ el }}"
          }
        },
        "custom_attributes": {
          "$merge": [
            "{{ p.jsonParameters | eq:'true' | then:(p.customAttributesJson | fromjson) }}",
            "{{ p.jsonParameters | ne:'true' | then:(p.customAttributesUi.customAttributesValues | kv:'name,value') }}"
          ]
        },
        "user_id": "{{ p.additionalFields.userId | default:(p.identifierType | eq:'userId' | then:p.idValue) }}",
        "session_count": "{{ p.additionalFields.sessionCount }}"
      }
    },
    {
      "resource": "user",
      "operation": "delete",
      "title": "Delete a user",
      "method": "DELETE",
      "path": "/users/{{ p.id }}",
      "fields": [
        {
          "key": "id",
          "label": "Intercom user ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "user",
      "operation": "get",
      "title": "Get a user",
      "method": "GET",
      "path": "/users{{ p.selectBy | eq:'id' | then:'/' }}{{ p.selectBy | eq:'id' | then:p.value }}",
      "fields": [
        {
          "key": "selectBy",
          "label": "Select by",
          "type": "select",
          "options": [
            "id",
            "userId"
          ],
          "default": "id"
        },
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "required": true
        }
      ],
      "query": {
        "user_id": "{{ p.selectBy | eq:'userId' | then:p.value }}"
      }
    },
    {
      "resource": "user",
      "operation": "getAll",
      "title": "Get many users",
      "method": "GET",
      "path": "/users",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 60
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "company_id",
            "email",
            "segment_id",
            "tag_id"
          ]
        }
      ],
      "query": {
        "$merge": "{{ p.filters }}"
      },
      "pagination": {
        "type": "next_url",
        "next_url_path": "pages.next",
        "limit_param": "per_page",
        "page_size": 60,
        "results_path": "users"
      },
      "output": {
        "path": "users"
      }
    },
    {
      "resource": "user",
      "operation": "update",
      "title": "Update a user",
      "method": "POST",
      "path": "/users",
      "fields": [
        {
          "key": "updateBy",
          "label": "Update by",
          "type": "select",
          "options": [
            "id",
            "email",
            "userId"
          ],
          "default": "id"
