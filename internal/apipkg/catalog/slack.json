        {
          "key": "userGroupId",
          "label": "User group ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "channels",
            "description",
            "handle",
            "include_count",
            "name"
          ]
        }
      ],
      "body": {
        "usergroup": "{{ p.userGroupId }}",
        "$merge": "{{ p.updateFields | omit:'channels' }}",
        "channels": "{{ p.updateFields.channels | csv }}"
      },
      "output": {
        "path": "usergroup"
      }
    },
    {
      "resource": "userGroup",
      "operation": "updateUsers",
      "title": "Add users to a user group",
      "description": "Keeps the current members and adds the given users",
      "method": "POST",
      "path": "/usergroups.users.update",
      "fields": [
        {
          "key": "userGroupId",
          "label": "User group ID",
          "type": "text",
          "required": true
        },
        {
          "key": "users",
          "label": "User IDs",
          "type": "array",
          "item_type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "include_count"
          ]
        }
      ],
      "before": {
        "method": "GET",
        "path": "/usergroups.list",
        "query": {
          "include_users": "true",
          "usergroup": "{{ p.userGroupId }}"
        }
      },
      "body": {
        "usergroup": "{{ p.userGroupId }}",
        "users": {
          "$join": [
            "{{ pre.usergroups | find:'id',p.userGroupId | get:'users' | csv }}",
            "{{ p.users | csv }}"
          ],
          "$sep": ","
        },
        "$merge": "{{ p.options }}"
      },
      "output": {
        "path": "usergroup"
      }
    }
  ]
}
