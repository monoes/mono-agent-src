{
  "$schema": "apipkg.v1",
  "id": "slack",
  "extends": "comm.slack",
  "title": "Slack",
  "description": "Channels, messages, files, reactions, stars, users and user groups in Slack (n8n operations)",
  "category": "app",
  "docs_url": "https://api.slack.com/methods",
  "n8n_types": [
    "n8n-nodes-base.slack"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.slackTrigger"
  ],
  "base_url": "https://slack.com/api",
  "error_when": "{{ res.ok | eq:'false' }}",
  "error_message": "{{ res.error }}",
  "credentials": [
    {
      "platform": "slack",
      "reuse_platform": "slack",
      "name": "Slack",
      "n8n_credential": "slackApi",
      "n8n_credential_alt": [
        "slackOAuth2Api"
      ],
      "n8n_field_map": {
        "accessToken": "access_token"
      },
      "methods": [
        "oauth",
        "bearer"
      ],
      "fields": [
        {
          "key": "access_token",
          "label": "Bot or user token",
          "secret": true,
          "required": true,
          "help": "xoxb-… or xoxp-…"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "message",
      "label": "Message"
    },
    {
      "value": "channel",
      "label": "Channel"
    },
    {
      "value": "file",
      "label": "File"
    },
    {
      "value": "reaction",
      "label": "Reaction"
    },
    {
      "value": "star",
      "label": "Star"
    },
    {
      "value": "user",
      "label": "User"
    },
    {
      "value": "userGroup",
      "label": "User Group"
    }
  ],
  "operations": [
    {
      "resource": "message",
      "operation": "post",
      "title": "Send a message",
      "method": "POST",
      "path": "/chat.{{ p.otherOptions.ephemeral | then:'postEphemeral' | default:'postMessage' }}",
      "fields": [
        {
          "key": "select",
          "label": "Send to",
          "type": "select",
          "options": [
            "channel",
            "user"
          ],
          "default": "channel"
        },
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": false,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "user",
          "label": "User",
          "type": "text",
          "help": "User ID (or a resource locator), when sending to a user"
        },
        {
          "key": "messageType",
          "label": "Message type",
          "type": "select",
          "options": [
            "text",
            "block",
            "attachment"
          ],
          "default": "text"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "help": "Message text (with block: notification fallback text)"
        },
        {
          "key": "blocksUi",
          "label": "Blocks",
          "type": "json",
          "help": "Block Kit JSON: {\"blocks\": [...]}"
        },
        {
          "key": "attachments",
          "label": "Attachments",
          "type": "json",
          "help": "List of legacy attachments; fields as {\"item\": [{\"title\", \"value\", \"short\"}]}"
        },
        {
          "key": "otherOptions",
          "label": "Other options",
          "type": "collection",
          "default": {},
          "options": [
            "botProfile",
            "ephemeral",
            "link_names",
            "mrkdwn",
            "sendAsUser",
            "thread_ts",
            "unfurl_links",
            "unfurl_media",
            "includeLinkToWorkflow"
          ],
          "help": "thread_ts: {\"replyValues\": {\"thread_ts\", \"reply_broadcast\"}}; botProfile: {\"imageValues\": {\"profilePhotoType\": \"image|emoji\", \"icon_url\", \"icon_emoji\"}}; ephemeral: {\"ephemeralValues\": {\"user\": \"U123\"}} (channel) or true (user)"
        }
      ],
      "body": {
        "$merge": [
          "{{ p.messageType | eq:'block' | then:(p.blocksUi | fromjson) }}",
          "{{ p.otherOptions | omit:'includeLinkToWorkflow,ephemeral,thread_ts,botProfile,sendAsUser' }}"
        ],
        "thread_ts": "{{ p.otherOptions.thread_ts.replyValues.thread_ts | string }}",
        "reply_broadcast": "{{ p.otherOptions.thread_ts.replyValues.reply_broadcast }}",
        "icon_url": "{{ p.otherOptions.botProfile.imageValues.profilePhotoType | eq:'image' | then:p.otherOptions.botProfile.imageValues.icon_url }}",
        "icon_emoji": "{{ p.otherOptions.botProfile.imageValues.profilePhotoType | ne:'image' | then:p.otherOptions.botProfile.imageValues.icon_emoji }}",
        "username": "{{ p.otherOptions.sendAsUser }}",
        "text": "{{ p.messageType | ne:'attachment' | then:p.text }}",
        "attachments": {
          "$map": "{{ p.messageType | eq:'attachment' | then:p.attachments }}",
          "$to": {
            "$merge": "{{ el | omit:'fields' }}",
            "fields": "{{ el.fields.item }}"
          }
        },
        "channel": "{{ p.select | eq:'user' | then:(p.user | rl) | default:(p.channelId | rl) }}",
        "user": "{{ p.otherOptions.ephemeral | then:(p.select | eq:'user' | then:(p.user | rl) | default:(p.otherOptions.ephemeral.ephemeralValues.user | rl)) }}"
      }
    },
    {
      "resource": "message",
      "operation": "delete",
      "title": "Delete a message",
      "method": "POST",
      "path": "/chat.delete",
      "fields": [
        {
          "key": "select",
          "label": "Send to",
          "type": "select",
          "options": [
            "channel",
            "user"
          ],
          "default": "channel"
        },
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": false,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "user",
          "label": "User",
          "type": "text",
          "help": "User ID (or a resource locator), when sending to a user"
        },
        {
          "key": "timestamp",
          "label": "Message timestamp",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "channel": "{{ p.select | eq:'user' | then:(p.user | rl) | default:(p.channelId | rl) }}",
        "ts": "{{ p.timestamp | string }}"
      }
    },
    {
      "resource": "message",
      "operation": "deleteScheduled",
      "title": "Delete a scheduled message",
      "method": "POST",
      "path": "/chat.deleteScheduledMessage",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "scheduledMessageId",
          "label": "Scheduled message ID",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "channel": "{{ p.channelId | rl }}",
        "scheduled_message_id": "{{ p.scheduledMessageId }}"
      }
    },
    {
      "resource": "message",
      "operation": "getManyScheduled",
      "title": "Get many scheduled messages",
      "method": "GET",
      "path": "/chat.scheduledMessages.list",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 100
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "channelId",
            "latest",
            "oldest"
          ]
        }
      ],
      "query": {
        "channel": "{{ p.filters.channelId | rl }}",
        "latest": "{{ p.filters.latest | epoch }}",
        "oldest": "{{ p.filters.oldest | epoch }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "cursor",
        "cursor_path": "response_metadata.next_cursor",
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "scheduled_messages"
      }
    },
    {
      "resource": "message",
      "operation": "getPermalink",
      "title": "Get a message permalink",
      "method": "GET",
      "path": "/chat.getPermalink",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "timestamp",
          "label": "Message timestamp",
          "type": "text",
          "required": true
        }
      ],
      "query": {
        "channel": "{{ p.channelId | rl }}",
        "message_ts": "{{ p.timestamp | string }}"
      }
    },
    {
      "resource": "message",
      "operation": "schedule",
      "title": "Schedule a message",
      "method": "POST",
      "path": "/chat.scheduleMessage",
      "fields": [
        {
          "key": "select",
          "label": "Send to",
          "type": "select",
          "options": [
            "channel",
            "user"
          ],
          "default": "channel"
        },
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": false,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "user",
          "label": "User",
          "type": "text",
          "help": "User ID (or a resource locator), when sending to a user"
        },
        {
          "key": "messageType",
          "label": "Message type",
          "type": "select",
          "options": [
            "text",
            "block",
            "attachment"
          ],
          "default": "text"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "help": "Message text (with block: notification fallback text)"
        },
        {
          "key": "blocksUi",
          "label": "Blocks",
          "type": "json",
          "help": "Block Kit JSON: {\"blocks\": [...]}"
        },
        {
          "key": "attachments",
          "label": "Attachments",
          "type": "json",
          "help": "List of legacy attachments; fields as {\"item\": [{\"title\", \"value\", \"short\"}]}"
        },
        {
          "key": "postAt",
          "label": "Send at",
          "type": "datetime",
          "required": true
        },
        {
          "key": "otherOptions",
          "label": "Other options",
          "type": "collection",
          "default": {},
          "options": [
            "botProfile",
            "ephemeral",
            "link_names",
            "mrkdwn",
            "sendAsUser",
            "thread_ts",
            "unfurl_links",
            "unfurl_media",
            "includeLinkToWorkflow"
          ],
          "help": "thread_ts: {\"replyValues\": {\"thread_ts\", \"reply_broadcast\"}}; botProfile: {\"imageValues\": {\"profilePhotoType\": \"image|emoji\", \"icon_url\", \"icon_emoji\"}}; ephemeral: {\"ephemeralValues\": {\"user\": \"U123\"}} (channel) or true (user)"
        }
      ],
      "body": {
        "$merge": [
          "{{ p.messageType | eq:'block' | then:(p.blocksUi | fromjson) }}",
          "{{ p.otherOptions | omit:'includeLinkToWorkflow,ephemeral,thread_ts,botProfile,sendAsUser' }}"
        ],
        "thread_ts": "{{ p.otherOptions.thread_ts.replyValues.thread_ts | string }}",
        "reply_broadcast": "{{ p.otherOptions.thread_ts.replyValues.reply_broadcast }}",
        "icon_url": "{{ p.otherOptions.botProfile.imageValues.profilePhotoType | eq:'image' | then:p.otherOptions.botProfile.imageValues.icon_url }}",
        "icon_emoji": "{{ p.otherOptions.botProfile.imageValues.profilePhotoType | ne:'image' | then:p.otherOptions.botProfile.imageValues.icon_emoji }}",
        "username": "{{ p.otherOptions.sendAsUser }}",
        "text": "{{ p.messageType | ne:'attachment' | then:p.text }}",
        "attachments": {
          "$map": "{{ p.messageType | eq:'attachment' | then:p.attachments }}",
          "$to": {
            "$merge": "{{ el | omit:'fields' }}",
            "fields": "{{ el.fields.item }}"
          }
        },
        "channel": "{{ p.select | eq:'user' | then:(p.user | rl) | default:(p.channelId | rl) }}",
        "post_at": "{{ p.postAt | epoch }}"
      }
    },
    {
      "resource": "message",
      "operation": "search",
      "title": "Search messages",
      "method": "GET",
      "path": "/search.messages",
      "description": "Uses search.messages (needs a user token)",
      "fields": [
        {
          "key": "query",
          "label": "Search query",
          "type": "text",
          "required": true
        },
        {
          "key": "sort",
          "label": "Sort",
          "type": "select",
          "options": [
            "desc",
            "asc",
            "relevance"
          ],
          "default": "desc"
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 25,
          "min": 1,
          "max": 50
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "searchChannel"
          ],
          "help": "searchChannel: list of channel names to search in"
        }
      ],
      "query": {
        "query": {
          "$join": [
            "{{ p.query }}",
            {
              "$join": {
                "$map": "{{ p.options.searchChannel }}",
                "$to": "in:{{ el }}"
              },
              "$sep": " "
            }
          ],
          "$sep": " "
        },
        "sort": "{{ p.sort | eq:'relevance' | then:'score' | default:'timestamp' }}",
        "sort_dir": "{{ p.sort | eq:'asc' | then:'asc' | default:'desc' }}"
      },
      "pagination": {
        "type": "page",
        "page_param": "page",
        "limit_param": "count",
        "page_size": 100,
        "results_path": "messages.matches"
      }
    },
    {
      "resource": "message",
      "operation": "update",
      "title": "Update a message",
      "method": "POST",
      "path": "/chat.update",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "ts",
          "label": "Message timestamp",
          "type": "text",
          "required": true
        },
        {
          "key": "messageType",
          "label": "Message type",
          "type": "select",
          "options": [
            "text",
            "block",
            "attachment"
          ],
          "default": "text"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "help": "Message text (with block: notification fallback text)"
        },
        {
          "key": "blocksUi",
          "label": "Blocks",
          "type": "json",
          "help": "Block Kit JSON: {\"blocks\": [...]}"
        },
        {
          "key": "attachments",
          "label": "Attachments",
          "type": "json",
          "help": "List of legacy attachments; fields as {\"item\": [{\"title\", \"value\", \"short\"}]}"
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "link_names",
            "parse"
          ]
        },
        {
          "key": "otherOptions",
          "label": "Other options",
          "type": "collection",
          "default": {},
          "options": [
            "includeLinkToWorkflow"
          ]
        }
      ],
      "body": {
        "text": "{{ p.messageType | ne:'attachment' | then:p.text }}",
        "attachments": {
          "$map": "{{ p.messageType | eq:'attachment' | then:p.attachments }}",
          "$to": {
            "$merge": "{{ el | omit:'fields' }}",
            "fields": "{{ el.fields.item }}"
          }
        },
        "channel": "{{ p.channelId | rl }}",
        "ts": "{{ p.ts | string }}",
        "$merge": [
          "{{ p.messageType | eq:'block' | then:(p.blocksUi | fromjson) }}",
          "{{ p.updateFields }}"
        ]
      }
    },
    {
      "resource": "channel",
      "operation": "create",
      "title": "Create a channel",
      "method": "POST",
      "path": "/conversations.create",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "channelVisibility",
          "label": "Visibility",
          "type": "select",
          "options": [
            "public",
            "private"
          ],
          "default": "public"
        }
      ],
      "body": {
        "name": "{{ p.channelId | rl | replace:'#','' }}",
        "is_private": "{{ p.channelVisibility | eq:'private' | then:true | default:false }}"
      },
      "output": {
        "path": "channel"
      }
    },
    {
      "resource": "channel",
      "operation": "archive",
      "title": "Archive a channel",
      "method": "POST",
      "path": "/conversations.archive",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        }
      ],
      "body": {
        "channel": "{{ p.channelId | rl }}"
      }
    },
    {
      "resource": "channel",
      "operation": "close",
      "title": "Close a direct message or multi-person direct message",
      "method": "POST",
      "path": "/conversations.close",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        }
      ],
      "body": {
        "channel": "{{ p.channelId | rl }}"
      }
    },
    {
      "resource": "channel",
      "operation": "get",
      "title": "Get a channel",
      "method": "POST",
      "path": "/conversations.info",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "includeNumMembers"
          ]
        }
      ],
      "query": {
        "channel": "{{ p.channelId | rl }}",
        "include_num_members": "{{ p.options.includeNumMembers }}"
      },
      "output": {
        "path": "channel"
      }
    },
    {
      "resource": "channel",
      "operation": "getAll",
      "title": "Get many channels",
      "method": "GET",
      "path": "/conversations.list",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 100
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "excludeArchived",
            "types"
          ],
          "help": "types: list of public_channel, private_channel, mpim, im"
        }
      ],
      "query": {
        "types": "{{ p.filters.types | csv }}",
        "exclude_archived": "{{ p.filters.excludeArchived | eq:'true' | then:'true' }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "cursor",
        "cursor_path": "response_metadata.next_cursor",
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "channels"
      }
    },
    {
      "resource": "channel",
      "operation": "history",
      "title": "Get a channel's message history",
      "method": "GET",
      "path": "/conversations.history",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 100
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "inclusive",
            "latest",
            "oldest"
          ]
        }
      ],
      "query": {
        "inclusive": "{{ p.filters.inclusive }}",
        "latest": "{{ p.filters.latest | epoch }}",
        "oldest": "{{ p.filters.oldest | epoch }}",
        "channel": "{{ p.channelId | rl }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "cursor",
        "cursor_path": "response_metadata.next_cursor",
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "messages"
      }
    },
    {
      "resource": "channel",
      "operation": "invite",
      "title": "Invite users to a channel",
      "method": "POST",
      "path": "/conversations.invite",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "userIds",
          "label": "User IDs",
          "type": "array",
          "item_type": "text",
          "required": true
        }
      ],
      "body": {
        "channel": "{{ p.channelId | rl }}",
        "users": "{{ p.userIds | csv }}"
      },
      "output": {
        "path": "channel"
      }
    },
    {
      "resource": "channel",
      "operation": "join",
      "title": "Join a channel",
      "method": "POST",
      "path": "/conversations.join",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        }
      ],
      "body": {
        "channel": "{{ p.channelId | rl }}"
      },
      "output": {
        "path": "channel"
      }
    },
    {
      "resource": "channel",
      "operation": "kick",
      "title": "Remove a user from a channel",
      "method": "POST",
      "path": "/conversations.kick",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
          "type": "text",
          "required": true,
          "help": "Channel ID (or a resource locator)"
        },
        {
          "key": "userId",
          "label": "User ID",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "channel": "{{ p.channelId | rl }}",
        "user": "{{ p.userId }}"
      }
    },
    {
      "resource": "channel",
      "operation": "leave",
      "title": "Leave a channel",
      "method": "POST",
      "path": "/conversations.leave",
      "fields": [
        {
          "key": "channelId",
          "label": "Channel",
