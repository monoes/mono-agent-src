            ],
            "channels": "{{ p.options.channelIds | csv }}",
            "channel_id": "{{ p.options.channelId }}",
            "initial_comment": "{{ p.options.initialComment }}",
            "thread_ts": "{{ p.options.threadTs }}"
          }
        }
