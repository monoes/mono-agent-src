        "upload_field": "binaryPropertyName",
        "upload_text": "{{ p.binaryData | ne:'true' | then:p.fileContent }}",
        "upload_when": "false"
      },
      "also": [
        {
          "upload": true,
          "method": "POST",
          "path": "{{ res.upload_url }}"
        },
        {
