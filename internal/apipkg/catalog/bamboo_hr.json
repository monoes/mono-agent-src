    {
      "resource": "employeeDocument",
      "operation": "delete",
      "title": "Delete an employee document",
      "method": "DELETE",
      "path": "/employees/{{ p.employeeId }}/files/{{ p.fileId }}",
      "fields": [
        {
          "key": "employeeId",
          "label": "Employee ID",
          "type": "text",
          "required": true
        },
        {
          "key": "fileId",
          "label": "File ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "employeeDocument",
      "operation": "download",
      "title": "Download an employee document",
      "method": "GET",
      "path": "/employees/{{ p.employeeId }}/files/{{ p.fileId }}/",
      "binary": {
        "download": true,
        "property_field": "output"
      },
      "fields": [
        {
          "key": "employeeId",
          "label": "Employee ID",
          "type": "text",
          "required": true
        },
        {
          "key": "fileId",
          "label": "File ID",
          "type": "text",
          "required": true
        },
        {
          "key": "output",
          "label": "Put output file in field",
          "type": "text",
          "default": "data"
        }
      ]
    },
    {
      "resource": "employeeDocument",
      "operation": "getAll",
      "title": "Get an employee's document categories",
      "method": "GET",
      "path": "/employees/{{ p.employeeId }}/files/view/",
      "pagination": {
        "type": "cursor",
        "cursor_param": "page",
        "cursor_path": "no_next_page",
        "results_path": "categories"
      },
      "fields": [
        {
          "key": "employeeId",
          "label": "Employee ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false,
          "help": "Fetch every page instead of stopping at Limit."
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 5,
          "help": "Maximum number of results when Return all is off.",
          "min": 1
        },
        {
          "key": "simplifyOutput",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Accepted for n8n compatibility; categories (with their files) are returned."
        }
      ]
    },
    {
      "resource": "employeeDocument",
      "operation": "update",
      "title": "Update an employee document",
      "method": "POST",
      "path": "/employees/{{ p.employeeId }}/files/{{ p.fileId }}",
      "body": {
        "category": "{{ p.updateFields.categoryId }}",
        "name": "{{ p.updateFields.name }}",
        "shareWithEmployee": "{{ p.updateFields.shareWithEmployee | eq:'false' | then:'no' | default:'yes' }}"
      },
      "fields": [
        {
          "key": "employeeId",
          "label": "Employee ID",
          "type": "text",
          "required": true
        },
        {
          "key": "fileId",
          "label": "File ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "categoryId",
            "name",
            "shareWithEmployee"
          ]
        }
      ]
    },
    {
      "resource": "employeeDocument",
      "operation": "upload",
      "title": "Upload an employee document",
      "method": "POST",
      "path": "/employees/{{ p.employeeId }}/files",
      "body_type": "multipart",
      "body": {
        "fileName": "{{ item.file_name | default:p.binaryPropertyName }}",
        "category": "{{ p.categoryId }}",
        "share": "{{ p.options.share | eq:'false' | then:'no' | default:'yes' }}"
      },
      "binary": {
        "upload_field": "binaryPropertyName",
        "multipart_field": "file"
      },
      "fields": [
        {
          "key": "employeeId",
          "label": "Employee ID",
          "type": "text",
          "required": true
        },
        {
          "key": "categoryId",
          "label": "Category ID",
          "type": "text",
          "required": true
        },
        {
          "key": "binaryPropertyName",
          "label": "Input binary field",
          "type": "text",
          "default": "data"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "share"
          ]
        }
      ]
    },
    {
      "resource": "file",
      "operation": "delete",
      "title": "Delete a company file",
      "method": "DELETE",
      "path": "/files/{{ p.fileId }}",
      "fields": [
        {
          "key": "fileId",
          "label": "File ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "file",
      "operation": "download",
      "title": "Download a company file",
      "method": "GET",
      "path": "/files/{{ p.fileId }}/",
      "binary": {
        "download": true,
        "property_field": "output"
      },
      "fields": [
        {
          "key": "fileId",
          "label": "File ID",
          "type": "text",
          "required": true
        },
        {
          "key": "output",
          "label": "Put output file in field",
          "type": "text",
          "default": "data"
        }
      ]
    },
    {
      "resource": "file",
      "operation": "getAll",
      "title": "Get company file categories",
      "method": "GET",
      "path": "/files/view",
      "pagination": {
        "type": "cursor",
        "cursor_param": "page",
        "cursor_path": "no_next_page",
        "results_path": "categories"
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false,
          "help": "Fetch every page instead of stopping at Limit."
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 5,
          "help": "Maximum number of results when Return all is off.",
          "min": 1
        },
        {
          "key": "simplifyOutput",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Accepted for n8n compatibility; categories (with their files) are returned."
        }
      ]
    },
    {
      "resource": "file",
      "operation": "update",
      "title": "Update a company file",
      "method": "POST",
      "path": "/files/{{ p.fileId }}",
      "body": {
        "category": "{{ p.updateFields.categoryId }}",
        "name": "{{ p.updateFields.name }}",
        "shareWithEmployee": "{{ p.updateFields.shareWithEmployee | eq:'false' | then:'no' | default:'yes' }}"
      },
      "fields": [
        {
          "key": "fileId",
          "label": "File ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "categoryId",
            "name",
            "shareWithEmployee"
          ]
        }
      ]
    },
    {
      "resource": "file",
      "operation": "upload",
      "title": "Upload a company file",
      "method": "POST",
      "path": "/files",
      "body_type": "multipart",
      "body": {
        "fileName": "{{ item.file_name | default:p.binaryPropertyName }}",
        "category": "{{ p.categoryId }}",
        "share": "{{ p.options.share | eq:'false' | then:'no' | default:'yes' }}"
      },
      "binary": {
        "upload_field": "binaryPropertyName",
        "multipart_field": "file"
      },
      "fields": [
        {
          "key": "binaryPropertyName",
          "label": "Input binary field",
          "type": "text",
          "default": "data"
        },
        {
          "key": "categoryId",
          "label": "Category ID",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "share"
          ]
        }
      ]
    },
    {
      "resource": "companyReport",
      "operation": "get",
      "title": "Get a company report",
      "method": "GET",
      "path": "/reports/{{ p.reportId }}/",
      "query": {
        "format": "{{ p.format }}",
        "fd": "{{ p.options.fd | default:true }}",
        "onlyCurrent": "{{ p.options.onlyCurrent | default:true }}"
      },
      "fields": [
        {
          "key": "reportId",
          "label": "Report ID",
          "type": "text",
          "required": true
        },
        {
          "key": "format",
          "label": "Format",
          "type": "select",
          "default": "JSON",
          "options": [
            "CSV",
            "JSON",
            "PDF",
            "XLS",
            "XML"
          ],
          "help": "JSON is returned as data; other formats come back as text."
        },
        {
          "key": "output",
          "label": "Put output file in field",
          "type": "text",
          "default": "data"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "fd",
            "onlyCurrent"
          ]
        }
      ]
    }
  ]
}
