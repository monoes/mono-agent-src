{
  "$schema": "apipkg.v1",
  "id": "copper",
  "node_type": "app.copper",
  "title": "Copper",
  "description": "Companies, leads, opportunities, people, projects, tasks and users in Copper CRM",
  "category": "app",
  "docs_url": "https://developer.copper.com/",
  "n8n_types": [
    "n8n-nodes-base.copper"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.copperTrigger"
  ],
  "base_url": "https://api.copper.com/developer_api/v1",
  "headers": {
    "Accept": "application/json"
  },
  "credentials": [
    {
      "platform": "copper",
      "name": "Copper",
      "n8n_credential": "copperApi",
      "n8n_field_map": {
        "apiKey": "api_key",
        "email": "email"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "secret": true,
          "required": true,
          "help": "Copper: Settings → Integrations → API keys"
        },
        {
          "key": "email",
          "label": "User email",
          "required": true,
          "help": "Email of the user who owns the key"
        }
      ],
      "inject": {
        "headers": {
          "X-PW-AccessToken": "{{ cred.api_key }}",
          "X-PW-Application": "developer_api",
          "X-PW-UserEmail": "{{ cred.email }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "company",
      "label": "Company"
    },
    {
      "value": "customerSource",
      "label": "Customer Source"
    },
    {
      "value": "lead",
      "label": "Lead"
    },
    {
      "value": "opportunity",
      "label": "Opportunity"
    },
    {
      "value": "person",
      "label": "Person"
    },
    {
      "value": "project",
      "label": "Project"
    },
    {
      "value": "task",
      "label": "Task"
    },
    {
      "value": "user",
      "label": "User"
    }
  ],
  "operations": [
    {
      "resource": "company",
      "operation": "create",
      "title": "Create a company",
      "method": "POST",
      "path": "/companies",
      "body": {
        "$merge": "{{ p.additionalFields | omit:'address,phone_numbers,emails,email,project_ids' }}",
        "address": "{{ p.additionalFields.address.addressFields }}",
        "phone_numbers": "{{ p.additionalFields.phone_numbers.phoneFields }}",
        "emails": "{{ p.additionalFields.emails.emailFields }}",
        "email": "{{ p.additionalFields.email.emailFields }}",
        "project_ids": "{{ p.additionalFields.project_ids | split }}",
        "name": "{{ p.name }}"
      },
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "address",
            "details",
            "email_domain",
            "phone_numbers"
          ],
          "help": "address: {\"addressFields\": {\"street\": \"\", \"city\": \"\", \"state\": \"\", \"postal_code\": \"\", \"country\": \"\"}}; phone_numbers: {\"phoneFields\": [{\"number\": \"\", \"category\": \"work\"}]}; emails / email: {\"emailFields\": [{\"email\": \"\", \"category\": \"work\"}]} (email: one object)"
        }
      ]
    },
    {
      "resource": "company",
      "operation": "delete",
      "title": "Delete a company",
      "method": "DELETE",
      "path": "/companies/{{ p.companyId }}",
      "fields": [
        {
          "key": "companyId",
          "label": "Company ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "company",
      "operation": "get",
      "title": "Get a company",
      "method": "GET",
      "path": "/companies/{{ p.companyId }}",
      "fields": [
        {
          "key": "companyId",
          "label": "Company ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "company",
      "operation": "getAll",
      "title": "Search companys",
      "method": "POST",
      "path": "/companies/search",
      "body": {
        "$merge": "{{ p.filterFields | omit:'project_ids,assignee_ids,company_ids,customer_source_ids' }}"
      },
      "pagination": {
        "type": "page",
        "page_param": "page_number",
        "limit_param": "page_size",
        "page_size": 200,
        "param_in": "body",
        "results_path": ""
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false,
          "help": "Fetch every page instead of stopping at Limit."
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 5,
          "min": 1,
          "help": "Maximum number of results when Return all is off."
        },
        {
          "key": "filterFields",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "country",
            "name"
          ],
          "help": "*_ids filters take comma-separated IDs"
        }
      ]
    },
    {
      "resource": "company",
