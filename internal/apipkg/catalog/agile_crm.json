                "subtype": "{{ el.subtype }}",
                "name": "{{ el.name }}",
                "value": "{{ el.value }}"
              }
            }
          ]
        },
        "type": "{{ p.jsonParameters | ne:'true' | then:'COMPANY' }}"
      },
      "fields": [
        {
          "key": "jsonParameters",
          "label": "JSON parameters",
          "type": "boolean",
          "default": false
        },
        {
          "key": "additionalFieldsJson",
          "label": "Additional fields (JSON)",
          "type": "json",
          "default": "",
          "help": "Used when JSON parameters is on: the raw Agile CRM payload."
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "addressOptions",
            "email",
            "name",
            "phone",
            "starValue",
            "tags",
            "websiteOptions",
            "customProperties"
          ]
        }
      ]
    },
