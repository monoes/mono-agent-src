    {
      "resource": "deal",
      "operation": "get",
      "title": "Get a deal",
      "method": "GET",
      "path": "/api/opportunity/{{ p.dealId }}",
      "fields": [
        {
          "key": "dealId",
          "label": "Deal ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "deal",
      "operation": "create",
      "title": "Create a deal",
      "method": "POST",
      "path": "/api/opportunity",
      "body": {
        "$merge": "{{ p.jsonParameters | eq:'true' | then:p.additionalFieldsJson | fromjson }}",
        "close_date": "{{ p.jsonParameters | ne:'true' | then:p.closeDate | epoch_ms }}",
        "expected_value": "{{ p.jsonParameters | ne:'true' | then:p.expectedValue }}",
        "milestone": "{{ p.jsonParameters | ne:'true' | then:p.milestone }}",
        "probability": "{{ p.jsonParameters | ne:'true' | then:p.probability }}",
        "name": "{{ p.jsonParameters | ne:'true' | then:p.name }}",
        "contactIds": "{{ p.additionalFields.contactIds }}",
        "customData": "{{ p.additionalFields.customData.customProperty }}"
      },
      "fields": [
        {
          "key": "closeDate",
          "label": "Close date",
