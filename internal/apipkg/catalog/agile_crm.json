              }
            },
            {
              "type": "{{ p.additionalFields.phone | then:'SYSTEM' }}",
              "name": "{{ p.additionalFields.phone | then:'phone' }}",
              "value": "{{ p.additionalFields.phone }}"
            },
            {
              "type": "{{ p.additionalFields.name | then:'SYSTEM' }}",
