    {
      "resource": "email",
      "operation": "send",
      "title": "Send an email",
      "description": "Attachments from binary properties (attachmentsBinary) are not sent yet; give base64 data in attachmentsValues.",
      "method": "POST",
      "path": "/emails/queue",
      "fields": [
        {
          "key": "userId",
          "label": "User ID",
          "type": "text",
          "required": true
        },
        {
          "key": "contactIds",
          "label": "Contact IDs",
          "type": "text",
          "required": true,
          "help": "Comma-separated"
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "addressField",
            "htmlContent",
            "plainContent"
          ]
        },
        {
          "key": "attachmentsUi",
          "label": "Attachments",
          "type": "collection",
          "default": {},
          "options": [
            "attachmentsValues",
            "attachmentsBinary"
          ],
          "help": "attachmentsValues: list of {fileData (base64), fileName}"
        }
      ],
      "body": {
        "user_id": "{{ p.userId | numeric }}",
        "contacts": {
          "$map": "{{ p.contactIds | split }}",
          "$to": "{{ el | int }}"
        },
        "subject": "{{ p.subject }}",
        "address_field": "{{ p.additionalFields.addressField }}",
        "html_content": "{{ p.additionalFields.htmlContent }}",
        "plain_content": "{{ p.additionalFields.plainContent }}",
        "attachments": {
          "$map": "{{ p.attachmentsUi.attachmentsValues }}",
          "$to": {
            "file_data": "{{ el.fileData }}",
            "file_name": "{{ el.fileName }}"
          }
        }
      },
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "file",
      "operation": "delete",
      "title": "Delete a file",
      "method": "DELETE",
      "path": "/files/{{ p.fileId | int }}",
      "fields": [
        {
          "key": "fileId",
          "label": "File ID",
