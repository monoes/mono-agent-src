    {
      "resource": "file",
      "operation": "getAll",
      "title": "Get many files",
      "method": "GET",
      "path": "/files",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "contactId",
            "name",
            "permission",
            "type",
            "viewable"
          ],
          "help": "permission: user, company, both; viewable: public, private, both"
        }
      ],
      "query": {
        "contact_id": "{{ p.filters.contactId }}",
        "name": "{{ p.filters.name }}",
        "permission": "{{ p.filters.permission | upper }}",
        "viewable": "{{ p.filters.viewable | upper }}",
        "type": "{{ p.filters.type | prefix:'~' | replace:'~templateThumnail','TemplateThumnail' | replace:'~digitalProduct','DigitalProduct' | replace:'~reSampledImage','ReSampledImage' | replace:'~logoThumnail','LogoThumnail' | replace:'~application','Application' | replace:'~attachment','Attachment' | replace:'~styleCart','StyleCart' | replace:'~contact','Contact' | replace:'~webform','WebForm' | replace:'~funnel','Funnel' | replace:'~hidden','Hidden' | replace:'~import','Import' | replace:'~ticket','Ticket' | replace:'~image','Image' | replace:'~fax','Fax' | replace:'~','' }}"
      },
      "pagination": {
        "type": "next_url",
        "next_url_path": "next",
        "limit_param": "limit",
        "page_size": 50,
        "results_path": "files"
      },
      "output": {
        "path": "files"
      }
    },
    {
      "resource": "file",
      "operation": "upload",
      "title": "Upload a file",
      "method": "POST",
      "path": "/files",
      "body_type": "json",
      "fields": [
        {
          "key": "binaryData",
          "label": "Binary file",
          "type": "boolean",
          "default": false
        },
        {
          "key": "binaryPropertyName",
          "label": "Input binary field",
          "type": "text",
          "default": "data"
        },
        {
          "key": "fileAssociation",
          "label": "Attach to",
          "type": "select",
          "options": [
            "company",
            "contact",
            "user"
          ],
          "required": true
        },
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "text",
          "default": ""
        },
        {
          "key": "fileName",
          "label": "File name",
          "type": "text",
          "default": ""
        },
        {
          "key": "fileData",
          "label": "File data (base64)",
          "type": "textarea",
          "default": ""
        },
        {
          "key": "isPublic",
          "label": "Public",
          "type": "boolean",
          "default": false
        }
      ],
      "body": {
        "!is_public": "{{ p.isPublic }}",
        "file_association": "{{ p.fileAssociation | upper }}",
        "contact_id": "{{ p.fileAssociation | eq:'contact' | then:(p.contactId | int) }}",
        "file_name": "{{ p.binaryData | eq:'true' | then:bin.file_name | default:p.fileName }}",
        "file_data": "{{ p.binaryData | eq:'true' | then:bin.base64 | default:p.fileData }}"
      },
      "binary": {
        "upload_field": "binaryPropertyName",
        "upload_when": "{{ p.binaryData }}"
      }
    }
  ],
  "webhook": {
    "fields": [
      {
        "key": "eventId",
        "label": "Event",
        "type": "text",
        "required": true,
        "help": "A Keap event key, e.g. contact.add"
      }
    ],
    "create": [
      {
        "method": "POST",
        "path": "/hooks",
        "body": {
          "eventKey": "{{ p.eventId }}",
          "hookUrl": "{{ hook.url }}"
        }
      }
    ],
    "id": "{{ res.key }}",
    "delete": [
      {
        "method": "DELETE",
        "path": "/hooks/{{ hook.id }}"
      }
    ]
  }
}
