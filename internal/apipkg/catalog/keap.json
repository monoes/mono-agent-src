        "received_date": "{{ p.additionalFields.receivedDate }}",
        "sent_date": "{{ p.additionalFields.sentDate }}",
        "sent_from_reply_address": "{{ p.additionalFields.sentFromReplyAddress }}",
        "sent_to_bcc_addresses": "{{ p.additionalFields.sentToBccAddresses }}",
        "sent_to_cc_addresses": "{{ p.additionalFields.sentToCCAddresses }}",
