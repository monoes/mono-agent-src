          "label": "Sent to",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "clickedDate",
            "contactId",
            "headers",
            "htmlContent",
            "openedDate",
            "originalProvider",
            "originalProviderId",
            "plainContent",
            "providerSourceId",
            "receivedDate",
            "sentDate",
            "sentFromReplyAddress",
            "sentToBccAddresses",
            "sentToCCAddresses",
            "subject"
          ]
        }
      ],
      "body": {
        "sent_to_address": "{{ p.sentToAddress }}",
        "sent_from_address": "{{ p.sentFromAddress }}",
        "clicked_date": "{{ p.additionalFields.clickedDate }}",
        "contact_id": "{{ p.additionalFields.contactId }}",
        "headers": "{{ p.additionalFields.headers }}",
        "html_content": "{{ p.additionalFields.htmlContent }}",
        "opened_date": "{{ p.additionalFields.openedDate }}",
        "original_provider": "{{ p.additionalFields.originalProvider }}",
        "original_provider_id": "{{ p.additionalFields.originalProviderId }}",
        "plain_content": "{{ p.additionalFields.plainContent }}",
