      "path": "/cards/{{ p.cardId | rl | re:'trello.com/c/([^/]+)' }}/checkItem/{{ p.checkItemId }}",
      "query": {
        "$merge": "{{ p.additionalFields }}"
      },
      "fields": [
        {
          "key": "cardId",
          "label": "Card ID",
          "type": "text",
