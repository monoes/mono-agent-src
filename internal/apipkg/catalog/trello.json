      "query": {
        "text": "{{ p.text }}"
      },
      "fields": [
        {
          "key": "cardId",
          "label": "Card ID",
          "type": "text",
          "required": true,
          "help": "ID, URL or n8n resource locator"
        },
        {
          "key": "commentId",
          "label": "Comment ID",
          "type": "text",
          "required": true
        },
        {
          "key": "text",
          "label": "Text",
