{
  "$schema": "apipkg.v1",
  "id": "gmail_more",
  "extends": "service.gmail",
  "title": "Gmail (n8n operations)",
  "description": "n8n Gmail operations (messages, labels, drafts, threads) on the native Gmail node",
  "category": "app",
  "docs_url": "https://developers.google.com/gmail/api/reference/rest",
  "n8n_types": [
    "n8n-nodes-base.gmail"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.gmailTrigger"
  ],
  "base_url": "https://gmail.googleapis.com/gmail/v1/users/me",
  "credentials": [
    {
      "platform": "google",
      "name": "Google (Gmail scope group)",
      "n8n_credential": "gmailOAuth2",
      "n8n_credential_alt": [
        "googleApi",
        "googleOAuth2Api"
      ],
      "methods": [
        "oauth"
      ],
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      },
      "reuse_platform": "google",
      "scope_group": "gmail"
    }
  ],
  "resources": [
    {
      "value": "message",
      "label": "Message"
    },
    {
      "value": "label",
      "label": "Label"
    },
    {
      "value": "draft",
      "label": "Draft"
    },
    {
      "value": "thread",
      "label": "Thread"
    }
  ],
  "operations": [
    {
      "resource": "message",
      "operation": "send",
      "title": "Send a message",
      "method": "POST",
      "base_url": "https://gmail.googleapis.com/upload/gmail/v1/users/me",
      "path": "/messages/send",
      "description": "Sends an e-mail (HTML or text) with attachments from the item's binary properties; senderName reads your address from the profile.",
      "fields": [
        {
          "key": "sendTo",
          "label": "To",
          "type": "text",
          "required": true,
          "help": "Comma-separated recipients."
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "text",
          "required": true
        },
        {
          "key": "emailType",
          "label": "Email type",
          "type": "select",
          "options": [
            "html",
            "text"
          ],
          "default": "html"
        },
        {
          "key": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "attachmentsUi",
            "bccList",
            "ccList",
            "senderName",
            "replyTo",
            "appendAttribution"
          ]
        }
      ],
      "before": [
        {
          "when": "{{ p.options.senderName }}",
          "method": "GET",
          "path": "/profile"
        }
      ],
      "query": {
        "uploadType": "media"
      },
      "headers": {
        "Content-Type": "message/rfc822"
      },
      "body_type": "raw",
      "body": "{{ p.options.senderName | prefix:'From: ' }}{{ p.options.senderName | then:pre.emailAddress | prefix:' <' | suffix:'>\r\n' }}{{ p.sendTo | prefix:'To: ' | suffix:'\r\n' }}{{ p.options.ccList | prefix:'Cc: ' | suffix:'\r\n' }}{{ p.options.bccList | prefix:'Bcc: ' | suffix:'\r\n' }}{{ p.options.replyTo | prefix:'Reply-To: ' | suffix:'\r\n' }}Subject: =?UTF-8?B?{{ p.subject | base64 }}?=\r\nMIME-Version: 1.0\r\n{{ bin.files | then:'Content-Type: multipart/mixed; boundary=\"monoagent_mixed\"\r\n\r\n--monoagent_mixed\r\n' }}Content-Type: text/{{ p.emailType | default:'html' | eq:'text' | then:'plain' | default:'html' }}; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n{{ p.message | base64 | wrap:76 }}\r\n{{ bin.files | mime_parts:'monoagent_mixed' }}",
      "binary": {
        "properties": "{{ p.options.attachmentsUi.attachmentsBinary | pluck:'property' | join:',' }}"
      }
    },
    {
      "resource": "message",
      "operation": "reply",
      "title": "Reply to a message",
      "method": "POST",
      "base_url": "https://gmail.googleapis.com/upload/gmail/v1/users/me",
      "path": "/messages/send",
      "description": "Reads the original message, then sends the reply in its thread with In-Reply-To/References set.",
      "fields": [
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "emailType",
          "label": "Email type",
          "type": "select",
          "options": [
            "html",
            "text"
          ],
          "default": "html"
        },
        {
          "key": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "attachmentsUi",
            "bccList",
            "ccList",
            "senderName",
            "replyToSenderOnly",
            "replyToRecipientsOnly"
          ]
        }
      ],
      "before": [
        {
          "method": "GET",
          "path": "/messages/{{ p.messageId }}",
          "query": {
            "format": "metadata",
            "metadataHeaders": [
              "Subject",
              "Message-ID",
              "From",
              "Reply-To",
              "To",
              "References"
            ]
          }
        },
        {
          "method": "GET",
          "path": "/profile"
        }
      ],
      "query": {
        "uploadType": "multipart"
      },
      "headers": {
        "Content-Type": "multipart/related; boundary=monoagent_mime_boundary"
      },
      "body_type": "raw",
      "body": "--monoagent_mime_boundary\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{\"threadId\":\"{{ pres.0.threadId }}\"}\r\n--monoagent_mime_boundary\r\nContent-Type: message/rfc822\r\n\r\n{{ p.options.senderName | prefix:'From: ' }}{{ p.options.senderName | then:pres.1.emailAddress | prefix:' <' | suffix:'>\r\n' }}To: {{ p.options.replyToRecipientsOnly | ne:'true' | then:(pres.0.payload.headers | find:'name','Reply-To' | default:(pres.0.payload.headers | find:'name','reply-to') | default:(pres.0.payload.headers | find:'name','Reply-To') | get:'value' | default:(pres.0.payload.headers | find:'name','From' | default:(pres.0.payload.headers | find:'name','from') | default:(pres.0.payload.headers | find:'name','From') | get:'value')) }}{{ p.options.replyToSenderOnly | ne:'true' | then:(pres.0.payload.headers | find:'name','To' | default:(pres.0.payload.headers | find:'name','to') | default:(pres.0.payload.headers | find:'name','To') | get:'value') | prefix:', ' }}\r\n{{ p.options.ccList | prefix:'Cc: ' | suffix:'\r\n' }}{{ p.options.bccList | prefix:'Bcc: ' | suffix:'\r\n' }}{{ pres.0.payload.headers | find:'name','Message-ID' | default:(pres.0.payload.headers | find:'name','message-id') | default:(pres.0.payload.headers | find:'name','Message-Id') | get:'value' | prefix:'In-Reply-To: ' | suffix:'\r\n' }}{{ pres.0.payload.headers | find:'name','Message-ID' | default:(pres.0.payload.headers | find:'name','message-id') | default:(pres.0.payload.headers | find:'name','Message-Id') | get:'value' | prefix:'References: ' | suffix:'\r\n' }}Subject: =?UTF-8?B?{{ pres.0.payload.headers | find:'name','Subject' | default:(pres.0.payload.headers | find:'name','subject') | default:(pres.0.payload.headers | find:'name','Subject') | get:'value' | base64 }}?=\r\nMIME-Version: 1.0\r\n{{ bin.files | then:'Content-Type: multipart/mixed; boundary=\"monoagent_mixed\"\r\n\r\n--monoagent_mixed\r\n' }}Content-Type: text/{{ p.emailType | default:'html' | eq:'text' | then:'plain' | default:'html' }}; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n{{ p.message | base64 | wrap:76 }}\r\n{{ bin.files | mime_parts:'monoagent_mixed' }}--monoagent_mime_boundary--\r\n",
      "binary": {
        "properties": "{{ p.options.attachmentsUi.attachmentsBinary | pluck:'property' | join:',' }}"
      }
    },
    {
      "resource": "message",
      "operation": "get",
      "title": "Get a message",
      "method": "GET",
      "path": "/messages/{{ p.messageId }}",
      "fields": [
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "On: headers From/To/Cc/Bcc/Subject only (format=metadata). Off: the full message (format=full)."
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "dataPropertyAttachmentsPrefixName",
            "downloadAttachments"
          ],
          "help": "Accepted for n8n compatibility; attachments are not downloaded."
        }
      ],
      "query": {
        "format": "{{ p.simple | eq:'false' | then:'full' | default:'metadata' }}",
        "metadataHeaders": [
          "{{ p.simple | ne:'false' | then:'From' }}",
          "{{ p.simple | ne:'false' | then:'To' }}",
          "{{ p.simple | ne:'false' | then:'Cc' }}",
          "{{ p.simple | ne:'false' | then:'Bcc' }}",
          "{{ p.simple | ne:'false' | then:'Subject' }}"
        ]
      }
    },
    {
      "resource": "message",
      "operation": "getAll",
      "title": "Get many messages",
      "method": "GET",
      "path": "/messages",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "On: headers From/To/Cc/Bcc/Subject only (format=metadata). Off: the full message (format=full)."
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "includeSpamTrash",
            "labelIds",
            "q",
            "readStatus",
            "receivedAfter",
            "receivedBefore",
            "sender"
          ],
          "help": "readStatus: unread, read or both; q uses Gmail search syntax."
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "dataPropertyAttachmentsPrefixName",
            "downloadAttachments"
          ]
        }
      ],
      "query": {
        "q": "{{ p.filters.q }}{{ p.filters.sender | prefix:' from:' }}{{ p.filters.readStatus | ne:'both' | then:p.filters.readStatus | prefix:' is:' }}{{ p.filters.receivedAfter | epoch | prefix:' after:' }}{{ p.filters.receivedBefore | epoch | prefix:' before:' }}",
        "labelIds": "{{ p.filters.labelIds }}",
        "includeSpamTrash": "{{ p.filters.includeSpamTrash }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "pageToken",
        "cursor_path": "nextPageToken",
        "limit_param": "maxResults",
        "page_size": 100,
        "results_path": "messages"
      },
      "output": {
        "path": "messages",
        "expand": {
          "method": "GET",
          "path": "/messages/{{ el.id }}",
          "query": {
            "format": "{{ p.simple | eq:'false' | then:'full' | default:'metadata' }}",
            "metadataHeaders": [
              "{{ p.simple | ne:'false' | then:'From' }}",
              "{{ p.simple | ne:'false' | then:'To' }}",
              "{{ p.simple | ne:'false' | then:'Cc' }}",
              "{{ p.simple | ne:'false' | then:'Bcc' }}",
              "{{ p.simple | ne:'false' | then:'Subject' }}"
            ]
          }
        }
      }
    },
    {
      "resource": "message",
      "operation": "delete",
      "title": "Delete a message",
      "method": "DELETE",
      "path": "/messages/{{ p.messageId }}",
      "fields": [
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "message",
      "operation": "markAsRead",
      "title": "Mark as read",
      "method": "POST",
      "path": "/messages/{{ p.messageId }}/modify",
      "fields": [
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "removeLabelIds": [
          "UNREAD"
        ]
      }
    },
    {
      "resource": "message",
      "operation": "markAsUnread",
      "title": "Mark as unread",
      "method": "POST",
      "path": "/messages/{{ p.messageId }}/modify",
      "fields": [
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "addLabelIds": [
          "UNREAD"
        ]
      }
    },
    {
      "resource": "message",
      "operation": "addLabels",
      "title": "Add labels",
      "method": "POST",
      "path": "/messages/{{ p.messageId }}/modify",
      "fields": [
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "labelIds",
          "label": "Label IDs",
          "type": "array",
          "item_type": "text",
          "required": true,
          "default": []
        }
      ],
      "body": {
        "addLabelIds": "{{ p.labelIds }}"
      }
    },
    {
      "resource": "message",
      "operation": "removeLabels",
      "title": "Remove labels",
      "method": "POST",
      "path": "/messages/{{ p.messageId }}/modify",
      "fields": [
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "labelIds",
          "label": "Label IDs",
          "type": "array",
          "item_type": "text",
          "required": true,
          "default": []
        }
      ],
      "body": {
        "removeLabelIds": "{{ p.labelIds }}"
      }
    },
    {
      "resource": "label",
      "operation": "getAll",
      "title": "Get many labels",
      "method": "GET",
      "path": "/labels",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "pagination": {
        "type": "cursor",
        "cursor_param": "pageToken",
        "cursor_path": "nextPageToken",
        "results_path": "labels"
      }
    },
    {
      "resource": "label",
      "operation": "create",
      "title": "Create a label",
      "method": "POST",
      "path": "/labels",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "labelListVisibility",
            "messageListVisibility"
          ],
          "help": "labelListVisibility: labelHide, labelShow (default), labelShowIfUnread; messageListVisibility: hide or show (default)."
        }
      ],
      "body": {
        "name": "{{ p.name }}",
        "labelListVisibility": "{{ p.options.labelListVisibility | default:'labelShow' }}",
        "messageListVisibility": "{{ p.options.messageListVisibility | default:'show' }}"
      }
    },
    {
      "resource": "label",
      "operation": "delete",
      "title": "Delete a label",
      "method": "DELETE",
      "path": "/labels/{{ p.labelId }}",
      "fields": [
        {
          "key": "labelId",
          "label": "Label ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "label",
      "operation": "get",
      "title": "Get a label",
      "method": "GET",
      "path": "/labels/{{ p.labelId }}",
      "fields": [
        {
          "key": "labelId",
          "label": "Label ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "draft",
      "operation": "create",
      "title": "Create a draft",
      "method": "POST",
      "base_url": "https://gmail.googleapis.com/upload/gmail/v1/users/me",
      "path": "/drafts",
      "description": "With threadId the draft is filed in that thread.",
      "fields": [
        {
          "key": "subject",
          "label": "Subject",
          "type": "text",
          "required": true
        },
        {
          "key": "emailType",
          "label": "Email type",
          "type": "select",
          "options": [
            "html",
            "text"
          ],
          "default": "text"
        },
        {
          "key": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "attachmentsUi",
            "bccList",
            "ccList",
            "fromAlias",
            "replyTo",
            "threadId",
            "sendTo"
          ]
        }
      ],
      "query": {
        "uploadType": "multipart"
      },
      "headers": {
        "Content-Type": "multipart/related; boundary=monoagent_mime_boundary"
      },
      "body_type": "raw",
      "body": "--monoagent_mime_boundary\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{\"message\":{\"threadId\":\"{{ p.options.threadId }}\"}}\r\n--monoagent_mime_boundary\r\nContent-Type: message/rfc822\r\n\r\n{{ p.options.fromAlias | prefix:'From: ' | suffix:'\r\n' }}{{ p.options.sendTo | prefix:'To: ' | suffix:'\r\n' }}{{ p.options.ccList | prefix:'Cc: ' | suffix:'\r\n' }}{{ p.options.bccList | prefix:'Bcc: ' | suffix:'\r\n' }}{{ p.options.replyTo | prefix:'Reply-To: ' | suffix:'\r\n' }}Subject: =?UTF-8?B?{{ p.subject | base64 }}?=\r\nMIME-Version: 1.0\r\n{{ bin.files | then:'Content-Type: multipart/mixed; boundary=\"monoagent_mixed\"\r\n\r\n--monoagent_mixed\r\n' }}Content-Type: text/{{ p.emailType | default:'html' | eq:'text' | then:'plain' | default:'html' }}; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n{{ p.message | base64 | wrap:76 }}\r\n{{ bin.files | mime_parts:'monoagent_mixed' }}--monoagent_mime_boundary--\r\n",
      "binary": {
        "properties": "{{ p.options.attachmentsUi.attachmentsBinary | pluck:'property' | join:',' }}"
      }
    },
    {
      "resource": "draft",
      "operation": "delete",
      "title": "Delete a draft",
      "method": "DELETE",
      "path": "/drafts/{{ p.messageId }}",
      "fields": [
        {
          "key": "messageId",
          "label": "Draft ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "draft",
      "operation": "get",
      "title": "Get a draft",
      "method": "GET",
      "path": "/drafts/{{ p.messageId }}",
      "query": {
        "format": "full"
      },
      "fields": [
        {
          "key": "messageId",
          "label": "Draft ID",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "dataPropertyAttachmentsPrefixName",
            "downloadAttachments"
          ]
        }
      ]
    },
    {
      "resource": "draft",
      "operation": "getAll",
      "title": "Get many drafts",
      "method": "GET",
      "path": "/drafts",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "dataPropertyAttachmentsPrefixName",
            "downloadAttachments",
            "includeSpamTrash"
          ]
        }
      ],
      "query": {
        "includeSpamTrash": "{{ p.options.includeSpamTrash }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "pageToken",
        "cursor_path": "nextPageToken",
        "limit_param": "maxResults",
        "page_size": 100,
        "results_path": "drafts"
      },
      "output": {
        "path": "drafts",
        "expand": {
          "method": "GET",
          "path": "/drafts/{{ el.id }}",
          "query": {
            "format": "full"
          }
        }
      }
    },
    {
      "resource": "thread",
      "operation": "getAll",
      "title": "Get many threads",
      "method": "GET",
      "path": "/threads",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "includeSpamTrash",
            "labelIds",
            "q",
            "readStatus",
            "receivedAfter",
            "receivedBefore",
            "sender"
          ],
          "help": "readStatus: unread, read or both; q uses Gmail search syntax."
        }
      ],
      "query": {
        "q": "{{ p.filters.q }}{{ p.filters.sender | prefix:' from:' }}{{ p.filters.readStatus | ne:'both' | then:p.filters.readStatus | prefix:' is:' }}{{ p.filters.receivedAfter | epoch | prefix:' after:' }}{{ p.filters.receivedBefore | epoch | prefix:' before:' }}",
        "labelIds": "{{ p.filters.labelIds }}",
        "includeSpamTrash": "{{ p.filters.includeSpamTrash }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "pageToken",
        "cursor_path": "nextPageToken",
        "limit_param": "maxResults",
        "page_size": 100,
        "results_path": "threads"
      }
    },
    {
      "resource": "thread",
      "operation": "addLabels",
      "title": "Add labels",
      "method": "POST",
      "path": "/threads/{{ p.threadId }}/modify",
      "fields": [
        {
          "key": "threadId",
          "label": "Thread ID",
          "type": "text",
          "required": true
        },
        {
          "key": "labelIds",
          "label": "Label IDs",
          "type": "array",
          "item_type": "text",
          "required": true,
          "default": []
        }
      ],
      "body": {
        "addLabelIds": "{{ p.labelIds }}"
      }
    },
    {
      "resource": "thread",
      "operation": "delete",
      "title": "Delete a thread",
      "method": "DELETE",
      "path": "/threads/{{ p.threadId }}",
      "fields": [
        {
          "key": "threadId",
          "label": "Thread ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "thread",
      "operation": "get",
      "title": "Get a thread",
      "method": "GET",
      "path": "/threads/{{ p.threadId }}",
      "fields": [
        {
          "key": "threadId",
          "label": "Thread ID",
          "type": "text",
          "required": true
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "On: headers From/To/Cc/Bcc/Subject only (format=metadata). Off: the full message (format=full)."
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "returnOnlyMessages"
          ],
          "help": "returnOnlyMessages: one item per message instead of the thread."
        }
      ],
      "query": {
        "format": "{{ p.simple | eq:'false' | then:'full' | default:'metadata' }}",
        "metadataHeaders": [
          "{{ p.simple | ne:'false' | then:'From' }}",
          "{{ p.simple | ne:'false' | then:'To' }}",
          "{{ p.simple | ne:'false' | then:'Cc' }}",
          "{{ p.simple | ne:'false' | then:'Bcc' }}",
          "{{ p.simple | ne:'false' | then:'Subject' }}"
        ]
      }
    },
    {
      "resource": "thread",
      "operation": "removeLabels",
      "title": "Remove labels",
      "method": "POST",
      "path": "/threads/{{ p.threadId }}/modify",
      "fields": [
        {
          "key": "threadId",
          "label": "Thread ID",
          "type": "text",
          "required": true
        },
        {
          "key": "labelIds",
          "label": "Label IDs",
          "type": "array",
          "item_type": "text",
          "required": true,
          "default": []
        }
      ],
      "body": {
        "removeLabelIds": "{{ p.labelIds }}"
      }
    },
    {
      "resource": "thread",
      "operation": "reply",
      "title": "Reply to a message",
      "method": "POST",
      "base_url": "https://gmail.googleapis.com/upload/gmail/v1/users/me",
      "path": "/messages/send",
      "description": "Reads the original message, then sends the reply in its thread with In-Reply-To/References set.",
      "fields": [
        {
          "key": "threadId",
          "label": "Thread ID",
          "type": "text",
          "required": true
        },
        {
          "key": "messageId",
          "label": "Message ID",
          "type": "text",
          "required": true
        },
        {
          "key": "emailType",
          "label": "Email type",
          "type": "select",
          "options": [
            "html",
            "text"
          ],
          "default": "html"
        },
        {
          "key": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "attachmentsUi",
            "bccList",
            "ccList",
            "senderName",
            "replyToSenderOnly",
            "replyToRecipientsOnly"
          ]
        }
      ],
      "before": [
        {
          "method": "GET",
          "path": "/messages/{{ p.messageId }}",
          "query": {
            "format": "metadata",
            "metadataHeaders": [
              "Subject",
              "Message-ID",
              "From",
              "Reply-To",
              "To",
              "References"
            ]
          }
        },
        {
          "method": "GET",
          "path": "/profile"
        }
      ],
      "query": {
        "uploadType": "multipart"
      },
      "headers": {
        "Content-Type": "multipart/related; boundary=monoagent_mime_boundary"
      },
      "body_type": "raw",
      "body": "--monoagent_mime_boundary\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{\"threadId\":\"{{ pres.0.threadId }}\"}\r\n--monoagent_mime_boundary\r\nContent-Type: message/rfc822\r\n\r\n{{ p.options.senderName | prefix:'From: ' }}{{ p.options.senderName | then:pres.1.emailAddress | prefix:' <' | suffix:'>\r\n' }}To: {{ p.options.replyToRecipientsOnly | ne:'true' | then:(pres.0.payload.headers | find:'name','Reply-To' | default:(pres.0.payload.headers | find:'name','reply-to') | default:(pres.0.payload.headers | find:'name','Reply-To') | get:'value' | default:(pres.0.payload.headers | find:'name','From' | default:(pres.0.payload.headers | find:'name','from') | default:(pres.0.payload.headers | find:'name','From') | get:'value')) }}{{ p.options.replyToSenderOnly | ne:'true' | then:(pres.0.payload.headers | find:'name','To' | default:(pres.0.payload.headers | find:'name','to') | default:(pres.0.payload.headers | find:'name','To') | get:'value') | prefix:', ' }}\r\n{{ p.options.ccList | prefix:'Cc: ' | suffix:'\r\n' }}{{ p.options.bccList | prefix:'Bcc: ' | suffix:'\r\n' }}{{ pres.0.payload.headers | find:'name','Message-ID' | default:(pres.0.payload.headers | find:'name','message-id') | default:(pres.0.payload.headers | find:'name','Message-Id') | get:'value' | prefix:'In-Reply-To: ' | suffix:'\r\n' }}{{ pres.0.payload.headers | find:'name','Message-ID' | default:(pres.0.payload.headers | find:'name','message-id') | default:(pres.0.payload.headers | find:'name','Message-Id') | get:'value' | prefix:'References: ' | suffix:'\r\n' }}Subject: =?UTF-8?B?{{ pres.0.payload.headers | find:'name','Subject' | default:(pres.0.payload.headers | find:'name','subject') | default:(pres.0.payload.headers | find:'name','Subject') | get:'value' | base64 }}?=\r\nMIME-Version: 1.0\r\n{{ bin.files | then:'Content-Type: multipart/mixed; boundary=\"monoagent_mixed\"\r\n\r\n--monoagent_mixed\r\n' }}Content-Type: text/{{ p.emailType | default:'html' | eq:'text' | then:'plain' | default:'html' }}; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n{{ p.message | base64 | wrap:76 }}\r\n{{ bin.files | mime_parts:'monoagent_mixed' }}--monoagent_mime_boundary--\r\n",
      "binary": {
        "properties": "{{ p.options.attachmentsUi.attachmentsBinary | pluck:'property' | join:',' }}"
      }
    },
    {
      "resource": "thread",
      "operation": "trash",
      "title": "Trash a thread",
      "method": "POST",
      "path": "/threads/{{ p.threadId }}/trash",
      "fields": [
        {
          "key": "threadId",
          "label": "Thread ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "thread",
      "operation": "untrash",
      "title": "Untrash a thread",
      "method": "POST",
      "path": "/threads/{{ p.threadId }}/untrash",
      "fields": [
        {
          "key": "threadId",
          "label": "Thread ID",
          "type": "text",
          "required": true
        }
      ]
    }
  ]
}
