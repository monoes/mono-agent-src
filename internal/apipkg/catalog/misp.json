{
  "$schema": "apipkg.v1",
  "id": "misp",
  "node_type": "app.misp",
  "title": "MISP",
  "description": "Attributes, events, feeds, galaxies, tags, users and more in a MISP threat-sharing instance",
  "category": "app",
  "docs_url": "https://www.misp-project.org/openapi/",
  "n8n_types": [
    "n8n-nodes-base.misp"
  ],
  "base_url": "{{ cred.base_url }}",
  "credentials": [
    {
      "platform": "misp",
      "name": "MISP",
      "n8n_credential": "mispApi",
      "n8n_field_map": {
        "apiKey": "api_key",
        "baseUrl": "base_url",
        "allowUnauthorizedCerts": "allow_unauthorized_certs"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "secret": true,
          "required": true
        },
        {
          "key": "base_url",
          "label": "Base URL",
          "required": true,
          "help": "e.g. https://misp.example.com"
        },
        {
          "key": "allow_unauthorized_certs",
          "label": "Ignore SSL issues",
          "help": "true to accept self-signed or invalid TLS certificates (self-hosted servers)"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "{{ cred.api_key }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "attribute",
      "label": "Attribute"
    },
    {
      "value": "event",
      "label": "Event"
    },
    {
      "value": "eventTag",
      "label": "EventTag"
    },
    {
      "value": "feed",
      "label": "Feed"
    },
    {
      "value": "galaxy",
      "label": "Galaxy"
    },
    {
      "value": "noticelist",
      "label": "Noticelist"
    },
    {
      "value": "object",
      "label": "Object"
    },
    {
      "value": "organisation",
      "label": "Organisation"
    },
    {
      "value": "tag",
      "label": "Tag"
    },
    {
      "value": "user",
      "label": "User"
    },
    {
      "value": "warninglist",
      "label": "Warninglist"
    }
  ],
  "operations": [
    {
      "resource": "attribute",
      "operation": "create",
      "title": "Create an attribute",
      "method": "POST",
      "path": "/attributes/add/{{ p.eventId }}",
      "fields": [
        {
          "key": "eventId",
          "label": "Event ID",
          "type": "text",
          "required": true
        },
        {
          "key": "type",
          "label": "Type",
          "type": "select",
          "required": true,
          "default": "text",
          "options": [
            "text",
            "url",
            "comment"
          ]
        },
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "distribution",
            "sharing_group_id"
          ],
          "help": "distribution: 0 (your organisation) … 5 (inherit); sharing_group_id is needed with distribution 4"
        }
      ],
      "body": {
        "type": "{{ p.type }}",
        "value": "{{ p.value }}",
        "$merge": "{{ p.additionalFields }}"
      },
      "output": {
        "path": "Attribute"
      }
    },
    {
      "resource": "attribute",
      "operation": "delete",
      "title": "Delete an attribute",
      "method": "DELETE",
      "path": "/attributes/delete/{{ p.attributeId }}",
      "fields": [
        {
          "key": "attributeId",
          "label": "Attribute ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "attribute",
      "operation": "get",
      "title": "Get an attribute",
      "method": "GET",
      "path": "/attributes/view/{{ p.attributeId }}",
      "fields": [
        {
          "key": "attributeId",
          "label": "Attribute ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "Attribute"
      }
    },
    {
      "resource": "attribute",
      "operation": "getAll",
      "title": "Get many attributes",
      "method": "GET",
      "path": "/attributes",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "output": {
        "limit": true
      }
    },
    {
      "resource": "attribute",
      "operation": "search",
      "title": "Search attributes",
      "method": "POST",
      "path": "/attributes/restSearch",
      "fields": [
        {
          "key": "useJson",
          "label": "Use JSON",
          "type": "boolean",
          "default": false
        },
        {
          "key": "jsonOutput",
          "label": "Search (JSON)",
          "type": "json",
          "default": "{\"value\": \"search value\", \"type\": \"text\"}"
        },
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "default": ""
        },
        {
          "key": "additionalFields",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "category",
            "deleted",
            "published",
            "searchall",
            "tags",
            "type"
          ],
          "help": "tags: comma-separated"
        }
      ],
      "body": {
        "$merge": [
          "{{ p.useJson | eq:'true' | then:(p.jsonOutput | fromjson) }}",
          "{{ p.useJson | ne:'true' | then:(p.additionalFields | omit:'tags') }}"
        ],
        "value": "{{ p.useJson | ne:'true' | then:p.value }}",
        "tags": "{{ p.useJson | ne:'true' | then:(p.additionalFields.tags | split) }}"
      },
      "output": {
        "path": "response.Attribute"
      }
    },
    {
      "resource": "attribute",
      "operation": "update",
      "title": "Update an attribute",
      "method": "PUT",
      "path": "/attributes/edit/{{ p.attributeId }}",
      "fields": [
        {
          "key": "attributeId",
          "label": "Attribute ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "distribution",
            "sharing_group_id"
          ],
          "help": "distribution: 0 (your organisation) … 5 (inherit); sharing_group_id is needed with distribution 4"
        }
      ],
      "body": {
        "$merge": "{{ p.updateFields }}"
      },
      "output": {
        "path": "Attribute"
      }
    },
    {
      "resource": "event",
      "operation": "create",
      "title": "Create an event",
      "method": "POST",
      "path": "/events",
      "fields": [
        {
          "key": "org_id",
          "label": "Organisation ID",
          "type": "text",
          "required": true
        },
        {
          "key": "information",
          "label": "Information",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "analysis",
            "distribution",
            "sharing_group_id",
            "threat_level_id"
          ],
          "help": "analysis: 0 initial, 1 ongoing, 2 completed; threat_level_id: 1 high … 4 undefined; distribution: 0 (your organisation) … 5 (inherit); sharing_group_id is needed with distribution 4"
        }
      ],
      "body": {
        "org_id": "{{ p.org_id }}",
        "info": "{{ p.information }}",
        "$merge": "{{ p.additionalFields }}"
      },
      "output": {
        "path": "Event",
        "to": "{{ el | omit:'Attribute' }}"
      }
    },
    {
      "resource": "event",
      "operation": "delete",
      "title": "Delete an event",
      "method": "DELETE",
      "path": "/events/delete/{{ p.eventId }}",
      "fields": [
        {
          "key": "eventId",
          "label": "Event ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "event",
      "operation": "get",
      "title": "Get an event",
      "method": "GET",
      "path": "/events/view/{{ p.eventId }}",
      "fields": [
        {
          "key": "eventId",
          "label": "Event ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "Event",
        "to": "{{ el | omit:'Attribute' }}"
      }
    },
    {
      "resource": "event",
      "operation": "getAll",
      "title": "Get many events",
      "method": "GET",
      "path": "/events",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "output": {
        "limit": true
      }
    },
    {
      "resource": "event",
      "operation": "publish",
      "title": "Publish an event",
      "method": "POST",
      "path": "/events/publish/{{ p.eventId }}",
      "fields": [
        {
          "key": "eventId",
          "label": "Event ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "event",
      "operation": "search",
      "title": "Search events",
      "method": "POST",
      "path": "/events/restSearch",
      "fields": [
        {
          "key": "useJson",
          "label": "Use JSON",
          "type": "boolean",
          "default": false
        },
        {
          "key": "jsonOutput",
          "label": "Search (JSON)",
          "type": "json",
          "default": "{\"value\": \"search value\", \"type\": \"text\"}"
        },
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "default": ""
        },
        {
          "key": "additionalFields",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "category",
            "deleted",
            "published",
            "searchall",
            "tags",
            "type"
          ],
          "help": "tags: comma-separated"
        }
      ],
      "body": {
        "$merge": [
          "{{ p.useJson | eq:'true' | then:(p.jsonOutput | fromjson) }}",
          "{{ p.useJson | ne:'true' | then:(p.additionalFields | omit:'tags') }}"
        ],
        "value": "{{ p.useJson | ne:'true' | then:p.value }}",
        "tags": "{{ p.useJson | ne:'true' | then:(p.additionalFields.tags | split) }}"
      },
      "output": {
        "path": "response",
        "each": "Event"
      }
    },
    {
      "resource": "event",
      "operation": "unpublish",
      "title": "Unpublish an event",
      "method": "POST",
      "path": "/events/unpublish/{{ p.eventId }}",
      "fields": [
        {
          "key": "eventId",
          "label": "Event ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "event",
      "operation": "update",
      "title": "Update an event",
      "method": "PUT",
      "path": "/events/edit/{{ p.eventId }}",
      "fields": [
        {
          "key": "eventId",
          "label": "Event ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "analysis",
            "distribution",
            "information",
            "sharing_group_id",
            "threat_level_id"
          ]
        }
      ],
      "body": {
        "$merge": "{{ p.updateFields | omit:'information' }}",
        "info": "{{ p.updateFields.information }}"
      },
      "output": {
        "path": "Event",
        "to": "{{ el | omit:'Attribute' }}"
      }
    },
    {
      "resource": "eventTag",
      "operation": "add",
      "title": "Add a tag to an event",
      "method": "POST",
      "path": "/events/addTag",
      "fields": [
        {
          "key": "eventId",
          "label": "Event ID",
          "type": "text",
          "required": true
        },
        {
          "key": "tagId",
          "label": "Tag ID",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "event": "{{ p.eventId }}",
        "tag": "{{ p.tagId }}"
      }
    },
    {
      "resource": "eventTag",
      "operation": "remove",
      "title": "Remove a tag from an event",
      "method": "POST",
      "path": "/events/removeTag/{{ p.eventId }}/{{ p.tagId }}",
      "fields": [
        {
          "key": "eventId",
          "label": "Event ID",
          "type": "text",
          "required": true
        },
        {
          "key": "tagId",
          "label": "Tag ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "feed",
      "operation": "create",
      "title": "Create a feed",
      "method": "POST",
      "path": "/feeds/add",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "provider",
          "label": "Provider",
          "type": "text",
          "required": true
        },
        {
          "key": "url",
          "label": "URL",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "distribution",
            "json"
          ],
          "help": "json: rules as JSON"
        }
      ],
      "body": {
        "name": "{{ p.name }}",
        "provider": "{{ p.provider }}",
        "url": "{{ p.url }}",
        "$merge": "{{ p.additionalFields }}"
      },
      "output": {
        "path": "Feed"
      }
    },
    {
      "resource": "feed",
      "operation": "disable",
