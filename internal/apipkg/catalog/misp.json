    },
    {
      "resource": "feed",
      "operation": "enable",
      "title": "Enable a feed",
      "method": "POST",
      "path": "/feeds/enable/{{ p.feedId }}",
      "fields": [
        {
          "key": "feedId",
          "label": "Feed ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "feed",
      "operation": "get",
      "title": "Get a feed",
      "method": "GET",
      "path": "/feeds/view/{{ p.feedId }}",
      "fields": [
        {
          "key": "feedId",
          "label": "Feed ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "Feed"
      }
    },
    {
      "resource": "feed",
      "operation": "getAll",
      "title": "Get many feeds",
      "method": "GET",
      "path": "/feeds",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "output": {
        "limit": true,
        "each": "Feed"
      }
    },
    {
      "resource": "feed",
      "operation": "update",
