    {
      "resource": "vectorSearch",
      "operation": "queryIndex",
      "title": "Query an index",
      "method": "POST",
      "path": "/api/2.0/vector-search/indexes/{{ p.indexName }}/query",
      "fields": [
        {
          "key": "indexName",
          "label": "Index name",
          "type": "text",
          "required": true
        },
        {
          "key": "queryType",
          "label": "Query by",
          "type": "select",
          "default": "text",
          "options": [
            "text",
            "vector"
          ]
        },
        {
          "key": "queryText",
          "label": "Query text",
          "type": "text",
          "required": false,
          "default": ""
        },
        {
          "key": "queryVector",
          "label": "Query vector",
          "type": "json",
          "default": "[]",
          "required": false
        },
        {
          "key": "searchMode",
          "label": "Search mode",
          "type": "select",
          "default": "ANN",
          "options": [
            "ANN",
            "HYBRID",
            "FULL_TEXT"
          ]
        },
        {
          "key": "columns",
          "label": "Columns",
          "type": "text",
          "required": true,
          "help": "Comma-separated columns to return"
        },
        {
          "key": "numResults",
          "label": "Number of results",
          "type": "number",
          "default": 10
        },
        {
          "key": "enableReranking",
          "label": "Rerank",
          "type": "boolean",
          "default": false
        },
        {
          "key": "rerankerModel",
          "label": "Reranker model",
          "type": "text",
          "required": false,
          "default": "databricks_reranker"
        },
        {
          "key": "columnsToRerank",
          "label": "Columns to rerank",
          "type": "text",
          "required": false,
          "default": "",
          "help": "Comma-separated"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "filterExpression",
            "scoreThreshold"
          ]
        }
      ],
      "body": {
        "num_results": "{{ p.numResults }}",
        "query_type": "{{ p.searchMode }}",
        "query_text": "{{ p.queryType | ne:'vector' | then:p.queryText }}",
        "query_vector": "{{ p.queryType | eq:'vector' | then:(p.queryVector | fromjson) }}",
        "!columns": "{{ p.columns | split }}",
        "filters_json": "{{ p.options.filterExpression }}",
        "score_threshold": "{{ p.options.scoreThreshold }}",
        "reranker": {
          "$when": "{{ p.enableReranking | eq:'true' }}",
          "model": "{{ p.rerankerModel | default:'databricks_reranker' }}",
          "parameters": {
            "columns_to_rerank": "{{ p.columnsToRerank | split }}"
          }
        }
      }
    }
