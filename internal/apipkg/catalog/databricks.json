        "delta_sync_index_spec": "{{ p.indexType | eq:'DELTA_SYNC' | then:(p.deltaSyncIndexSpec | fromjson) }}",
        "direct_access_index_spec": "{{ p.indexType | eq:'DIRECT_ACCESS' | then:(p.directAccessIndexSpec | fromjson) }}"
      }
