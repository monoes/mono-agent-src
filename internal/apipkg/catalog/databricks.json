    {
      "resource": "unityCatalog",
      "operation": "createFunction",
      "title": "Create a function",
      "method": "POST",
      "path": "/api/2.1/unity-catalog/functions",
      "fields": [
        {
          "key": "catalogName",
          "label": "Catalog",
          "type": "text",
          "required": true
        },
        {
          "key": "schemaName",
          "label": "Schema",
          "type": "text",
          "required": true
        },
        {
          "key": "functionName",
          "label": "Function name",
          "type": "text",
          "required": true
        },
        {
          "key": "inputParams",
          "label": "Input parameters",
          "type": "json",
          "default": "[]",
          "required": false,
          "help": "[{\"name\", \"type_name\", \"position\"}] or {\"parameters\": [...]}"
        },
        {
          "key": "returnType",
          "label": "Return type",
          "type": "text",
          "required": false,
          "default": "STRING"
        },
        {
          "key": "routineBody",
          "label": "Routine body",
          "type": "text",
          "required": false,
          "default": "SQL"
        },
        {
          "key": "routineDefinition",
          "label": "Routine definition",
          "type": "textarea",
          "required": true
        }
      ],
      "body": {
        "function_info": {
          "name": "{{ p.functionName }}",
          "catalog_name": "{{ p.catalogName | rl }}",
          "schema_name": "{{ p.schemaName | rl }}",
          "!input_params": {
            "!parameters": {
              "$map": "{{ p.inputParams | fromjson | get:'parameters' | default:(p.inputParams | fromjson) }}",
              "$to": {
                "$merge": "{{ el }}",
                "type_text": "{{ el.type_text | default:el.type_name }}",
                "type_json": "{{ el.type_json | default:(el.type_name | prefix:'{\"name\":\"' | suffix:'\"}') }}"
              }
            }
          },
          "data_type": "{{ p.returnType | default:'STRING' }}",
          "full_data_type": "{{ p.returnType | default:'STRING' }}",
          "specific_name": "{{ p.functionName }}",
          "parameter_style": "S",
          "security_type": "DEFINER",
          "sql_data_access": "CONTAINS_SQL",
          "is_deterministic": false,
          "is_null_call": true,
          "routine_body": "{{ p.routineBody | default:'SQL' }}",
          "routine_definition": "{{ p.routineDefinition }}"
        }
      }
    },
    {
      "resource": "unityCatalog",
