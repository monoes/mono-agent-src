{
  "$schema": "apipkg.v1",
  "id": "azure_storage",
  "node_type": "app.azure_storage",
  "title": "Azure Storage",
  "description": "Containers and blobs in Azure Blob Storage",
  "category": "app",
  "docs_url": "https://learn.microsoft.com/en-us/rest/api/storageservices/blob-service-rest-api",
  "n8n_types": [
    "n8n-nodes-base.azureStorage"
  ],
  "base_url": "{{ cred.custom_endpoint | re:'^(.*?)/*$' }}{{ cred.custom_endpoint | default:'' | eq:'' | then:'https://' }}{{ cred.custom_endpoint | default:'' | eq:'' | then:cred.account }}{{ cred.custom_endpoint | default:'' | eq:'' | then:'.' }}{{ cred.custom_endpoint | default:'' | eq:'' | then:(cred.environment | default:'blob.core.windows.net') }}",
  "headers": {
    "x-ms-version": "2021-12-02"
  },
  "credentials": [
    {
      "platform": "azure_storage",
      "name": "Azure Storage (shared key)",
      "n8n_credential": "azureStorageSharedKeyApi",
      "n8n_credential_alt": [
        "azureStorageOAuth2Api"
      ],
      "n8n_field_map": {
        "account": "account",
        "key": "key",
        "environment": "environment",
        "customEndpoint": "custom_endpoint"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "account",
          "label": "Storage account name",
          "required": true
        },
        {
          "key": "key",
          "label": "Account key",
          "secret": true,
          "required": true,
          "help": "Base64 access key from the storage account's Access keys page."
        },
        {
          "key": "environment",
          "label": "Blob host suffix",
          "help": "blob.core.windows.net (default), blob.core.usgovcloudapi.net or blob.core.chinacloudapi.cn."
        },
        {
          "key": "custom_endpoint",
          "label": "Custom endpoint",
          "help": "https URL of a private endpoint or custom domain; overrides account + host suffix."
        }
      ],
      "inject": {
        "azure_shared_key": {
          "account": "{{ cred.account }}",
          "key": "{{ cred.key }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "container",
      "label": "Container"
    },
    {
      "value": "blob",
      "label": "Blob"
    }
  ],
  "operations": [
    {
      "resource": "container",
      "operation": "getAll",
      "title": "Get many containers",
      "method": "GET",
      "path": "/",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "fields",
            "filter"
          ],
          "help": "fields: extra data to include (metadata, deleted, system); filter: name prefix."
        }
      ],
      "query": {
        "comp": "list",
        "include": "{{ p.options.fields | csv }}",
        "prefix": "{{ p.options.filter }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "marker",
        "cursor_path": "EnumerationResults.NextMarker",
        "limit_param": "maxresults",
        "page_size": 100,
        "results_path": "EnumerationResults.Containers.Container"
      },
      "output": {
        "path": "EnumerationResults.Containers.Container"
      }
    },
    {
      "resource": "container",
      "operation": "create",
      "title": "Create a container",
      "method": "PUT",
      "path": "/{{ p.containerCreate }}",
      "fields": [
        {
          "key": "containerCreate",
          "label": "Container name",
          "type": "text",
          "required": true,
          "help": "3-63 lowercase letters, digits and single hyphens."
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "accessLevel",
            "metadata"
          ],
          "help": "accessLevel: blob or container for public read access (empty = private); metadata: {\"metadataValues\": [{\"fieldName\": \"owner\", \"fieldValue\": \"ada\"}]} sent as x-ms-meta-* headers."
        }
      ],
      "query": {
        "restype": "container"
      },
      "headers": {
        "$merge": "{{ p.options.metadata | kv:'fieldName,fieldValue,x-ms-meta-' }}",
        "x-ms-blob-public-access": "{{ p.options.accessLevel }}"
      },
      "output": {
        "to": {
          "lastModified": "{{ hdr.Last-Modified }}",
          "etag": "{{ hdr.ETag }}",
          "requestId": "{{ hdr.x-ms-request-id }}",
          "version": "{{ hdr.x-ms-version }}",
          "date": "{{ hdr.Date }}"
        }
      }
    },
    {
      "resource": "container",
      "operation": "delete",
      "title": "Delete a container",
      "method": "DELETE",
      "path": "/{{ p.container | rl }}",
      "fields": [
        {
          "key": "container",
          "label": "Container",
          "type": "text",
          "required": true
        }
      ],
      "query": {
        "restype": "container"
      },
      "output": {
        "to": {
          "requestId": "{{ hdr.x-ms-request-id }}",
          "version": "{{ hdr.x-ms-version }}",
          "date": "{{ hdr.Date }}"
        }
      }
    },
    {
      "resource": "container",
      "operation": "get",
      "title": "Get a container",
      "method": "GET",
      "path": "/{{ p.container | rl }}",
      "fields": [
        {
          "key": "container",
          "label": "Container",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "simplify"
          ]
        }
      ],
      "query": {
        "restype": "container"
      },
      "output": {
        "to": {
          "name": "{{ p.container | rl }}",
          "properties": {
            "lastModified": "{{ hdr.Last-Modified }}",
            "etag": "{{ hdr.ETag }}",
            "leaseStatus": "{{ hdr.x-ms-lease-status }}",
            "leaseState": "{{ hdr.x-ms-lease-state }}",
            "hasImmutabilityPolicy": "{{ hdr.x-ms-has-immutability-policy | bool }}",
            "hasLegalHold": "{{ hdr.x-ms-has-legal-hold | bool }}",
            "defaultEncryptionScope": "{{ hdr.x-ms-default-encryption-scope }}",
            "publicAccess": "{{ hdr.x-ms-blob-public-access }}"
          }
        }
      }
    },
    {
      "resource": "blob",
      "operation": "getAll",
      "title": "Get many blobs",
      "method": "GET",
      "path": "/{{ p.container | rl }}",
      "fields": [
        {
          "key": "container",
          "label": "Container",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "fields",
            "filter"
          ],
          "help": "fields: include (copy, deleted, deletedwithversions, immutabilitypolicy, legalhold, metadata, permissions, snapshots, tags, uncommittedblobs, versions); filter: showonly (deleted, files, directories)."
        }
      ],
      "query": {
        "restype": "container",
        "comp": "list",
        "include": "{{ p.options.fields | csv }}",
        "showonly": "{{ p.options.filter | csv }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "marker",
        "cursor_path": "EnumerationResults.NextMarker",
        "limit_param": "maxresults",
        "page_size": 100,
        "results_path": "EnumerationResults.Blobs.Blob"
      },
      "output": {
        "path": "EnumerationResults.Blobs.Blob"
      }
    },
    {
      "resource": "blob",
      "operation": "create",
      "title": "Create a blob",
      "method": "PUT",
      "path": "/{{ p.container | rl }}/{{ p.blobCreate }}",
      "fields": [
        {
          "key": "container",
          "label": "Container",
          "type": "text",
          "required": true
        },
        {
          "key": "blobCreate",
          "label": "Blob name",
          "type": "text",
          "required": true
        },
        {
          "key": "from",
          "label": "From",
          "type": "select",
          "default": "binary",
          "options": [
            "binary",
            "url"
          ]
        },
        {
          "key": "binaryPropertyName",
          "label": "Input binary field",
          "type": "text",
          "default": "data"
        },
        {
          "key": "url",
          "label": "Source URL",
          "type": "text",
          "help": "With From url: the blob is copied from this URL."
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "accessTier",
            "blobType",
            "cacheControl",
            "contentCrc64",
            "contentEncoding",
            "contentLanguage",
            "contentMd5",
            "contentType",
            "encryptionContext",
            "encryptionScope",
            "expiryOption",
            "expiryTime",
            "filename",
            "immutabilityPolicyUntilDate",
            "immutabilityPolicyMode",
            "leaseId",
            "legalHold",
            "metadata",
            "origin",
            "tags"
          ],
          "help": "Blob properties sent as x-ms-* headers; metadata ({\"metadataValues\": [{\"fieldName\", \"fieldValue\"}]}) as x-ms-meta-<name>, tags ({\"tagValues\": [{\"tagName\", \"tagValue\"}]}) as x-ms-tags."
        }
      ],
      "headers": {
        "$merge": "{{ p.options.metadata | kv:'fieldName,fieldValue,x-ms-meta-' }}",
        "x-ms-blob-type": "{{ p.options.blobType | default:'BlockBlob' }}",
        "x-ms-copy-source": "{{ p.from | eq:'url' | then:p.url }}",
        "x-ms-blob-content-disposition": "{{ p.options.filename | default:(p.from | ne:'url' | then:bin.file_name) | prefix:'attachment; filename=\"' | suffix:'\"' }}",
        "x-ms-access-tier": "{{ p.options.accessTier }}",
        "x-ms-blob-cache-control": "{{ p.options.cacheControl }}",
        "x-ms-content-crc64": "{{ p.options.contentCrc64 }}",
        "x-ms-blob-content-encoding": "{{ p.options.contentEncoding }}",
        "x-ms-blob-content-language": "{{ p.options.contentLanguage }}",
        "x-ms-blob-content-md5": "{{ p.options.contentMd5 }}",
        "x-ms-blob-content-type": "{{ p.options.contentType }}",
        "x-ms-encryption-context": "{{ p.options.encryptionContext }}",
        "x-ms-encryption-scope": "{{ p.options.encryptionScope }}",
        "x-ms-expiry-option": "{{ p.options.expiryOption }}",
        "x-ms-expiry-time": "{{ p.options.expiryTime }}",
        "x-ms-immutability-policy-until-date": "{{ p.options.immutabilityPolicyUntilDate }}",
        "x-ms-immutability-policy-mode": "{{ p.options.immutabilityPolicyMode }}",
        "x-ms-lease-id": "{{ p.options.leaseId }}",
        "x-ms-legal-hold": "{{ p.options.legalHold | string }}",
        "Origin": "{{ p.options.origin }}",
        "x-ms-tags": "{{ p.options.tags | kv:'tagName,tagValue' | urlencode }}"
      },
      "binary": {
        "upload_field": "binaryPropertyName",
        "upload_when": "{{ p.from | ne:'url' }}"
      },
      "output": {
        "to": {
          "lastModified": "{{ hdr.Last-Modified }}",
          "etag": "{{ hdr.ETag }}",
          "contentMd5": "{{ hdr.Content-MD5 }}",
          "versionId": "{{ hdr.x-ms-version-id }}",
          "requestServerEncrypted": "{{ hdr.x-ms-request-server-encrypted | bool }}",
          "requestId": "{{ hdr.x-ms-request-id }}",
          "version": "{{ hdr.x-ms-version }}",
          "date": "{{ hdr.Date }}"
        }
      }
    },
    {
      "resource": "blob",
      "operation": "delete",
      "title": "Delete a blob",
      "method": "DELETE",
      "path": "/{{ p.container | rl }}/{{ p.blob | rl }}",
      "fields": [
        {
          "key": "container",
          "label": "Container",
          "type": "text",
          "required": true
        },
        {
          "key": "blob",
          "label": "Blob name",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "leaseId"
          ]
        }
      ],
      "headers": {
        "x-ms-lease-id": "{{ p.options.leaseId }}"
      },
      "output": {
        "to": {
          "deleteTypePermanent": "{{ hdr.x-ms-delete-type-permanent | bool }}",
          "requestId": "{{ hdr.x-ms-request-id }}",
          "version": "{{ hdr.x-ms-version }}",
          "date": "{{ hdr.Date }}"
        }
      }
    },
    {
      "resource": "blob",
      "operation": "get",
      "title": "Get (download) a blob",
      "method": "GET",
      "path": "/{{ p.container | rl }}/{{ p.blob | rl }}",
      "fields": [
        {
          "key": "container",
          "label": "Container",
          "type": "text",
          "required": true
        },
        {
          "key": "blob",
          "label": "Blob name",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "leaseId",
            "origin",
            "simplify",
            "upn"
          ]
        }
      ],
      "headers": {
        "x-ms-lease-id": "{{ p.options.leaseId }}",
        "Origin": "{{ p.options.origin }}",
        "x-ms-upn": "{{ p.options.upn | string }}"
      },
      "binary": {
        "download": true,
        "file_name": "{{ p.blob | rl }}"
      }
    }
  ]
}
