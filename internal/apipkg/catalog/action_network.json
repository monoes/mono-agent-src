          "key": "tagId",
          "label": "Tag ID",
          "type": "text",
          "required": true
        },
        {
          "key": "personId",
          "label": "Person ID",
          "type": "text",
          "required": true
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Kept for n8n compatibility; the full OSDI record is returned."
        }
      ]
    },
    {
      "resource": "personTag",
      "operation": "remove",
      "title": "Remove a tag from a person",
      "method": "DELETE",
      "path": "/tags/{{ p.tagId }}/taggings/{{ p.taggingId }}",
      "fields": [
        {
          "key": "tagId",
          "label": "Tag ID",
          "type": "text",
          "required": true
        },
        {
          "key": "taggingId",
          "label": "Tagging ID",
          "type": "text",
          "required": true
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Kept for n8n compatibility; the full OSDI record is returned."
        }
      ]
    },
    {
      "resource": "petition",
      "operation": "create",
      "title": "Create a petition",
      "method": "POST",
      "path": "/petitions",
      "body": {
        "origin_system": "{{ p.originSystem }}",
        "title": "{{ p.title }}",
        "$merge": "{{ p.additionalFields | omit:'target' }}",
        "target": [
          {
            "name": "{{ p.additionalFields.target }}"
          }
        ]
      },
      "fields": [
        {
          "key": "originSystem",
          "label": "Origin system",
          "type": "text",
          "required": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "browser_url",
            "featured_image_url",
            "name",
            "petition_text",
            "target"
          ],
          "help": "target: comma-separated target names"
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Kept for n8n compatibility; the full OSDI record is returned."
        }
      ]
    },
