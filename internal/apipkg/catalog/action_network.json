      "operation": "create",
      "title": "Create a signature",
      "method": "POST",
      "path": "/petitions/{{ p.petitionId }}/signatures",
      "body": {
        "_links": {
          "osdi:person": {
            "href": "https://actionnetwork.org/api/v2/people/{{ p.personId }}"
          }
        },
        "$merge": "{{ p.additionalFields }}"
      },
      "fields": [
