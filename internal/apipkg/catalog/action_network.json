      "path": "/petitions/{{ p.petitionId }}/signatures/{{ p.signatureId }}",
      "body": {
        "$merge": "{{ p.updateFields }}"
      },
      "fields": [
        {
          "key": "petitionId",
          "label": "Petition ID",
          "type": "text",
