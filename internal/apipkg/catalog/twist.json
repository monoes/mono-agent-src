{
  "$schema": "apipkg.v1",
  "id": "twist",
  "node_type": "app.twist",
  "title": "Twist",
  "description": "Channels, threads, comments and conversation messages in Twist",
  "category": "app",
  "docs_url": "https://developer.twist.com/v3/",
  "n8n_types": [
    "n8n-nodes-base.twist"
  ],
  "base_url": "https://api.twist.com/api/v3",
  "credentials": [
    {
      "platform": "twist",
      "name": "Twist",
      "n8n_credential": "twistOAuth2Api",
      "n8n_field_map": {},
      "methods": [
        "oauth"
      ],
      "fields": [
        {
          "key": "access_token",
          "label": "Access token",
          "secret": true,
          "required": true
        }
      ],
      "oauth": {
        "auth_url": "https://twist.com/oauth/authorize",
        "token_url": "https://twist.com/oauth/access_token",
        "extra_params": {
          "scope": "attachments:write,channels:remove,comments:remove,messages:remove,threads:remove,workspaces:read"
        }
      },
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "messageConversation",
      "label": "Message conversation"
    },
    {
      "value": "channel",
      "label": "Channel"
    },
    {
      "value": "comment",
      "label": "Comment"
    },
    {
      "value": "thread",
      "label": "Thread"
    }
  ],
  "operations": [
    {
      "resource": "messageConversation",
      "operation": "create",
      "title": "Send a message in a conversation",
      "method": "POST",
      "path": "/conversation_messages/add",
      "body": {
        "conversation_id": "{{ p.conversationId }}",
        "workspace_id": "{{ p.workspaceId }}",
        "content": {
          "$join": [
            {
              "$join": {
                "$map": "{{ p.additionalFields.direct_mentions }}",
                "$to": "[name](twist-mention://{{ el }})"
              },
              "$sep": " "
            },
            "{{ p.content }}"
          ],
          "$sep": " "
        },
        "$merge": "{{ p.additionalFields | omit:'actionsUi,binaryProperties' }}",
        "actions": "{{ p.additionalFields.actionsUi.actionValues }}",
        "attachments": "{{ pres.0 }}"
      },
      "fields": [
        {
          "key": "workspaceId",
          "label": "Workspace ID",
          "type": "text",
          "required": true
        },
        {
          "key": "conversationId",
          "label": "Conversation ID",
          "type": "text",
          "required": true
        },
        {
          "key": "content",
          "label": "Content",
          "type": "textarea",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "actionsUi",
            "binaryProperties",
            "direct_mentions"
          ],
          "help": "actionsUi.actionValues: [{action, button_text, message, type, url}]; direct_mentions: user IDs to mention; binaryProperties: comma-separated binary properties, each uploaded and attached"
        }
      ],
      "before": [
        {
          "for_each": "{{ p.additionalFields.binaryProperties | split }}",
          "upload": true,
          "method": "POST",
          "path": "/attachments/upload",
          "body_type": "multipart",
          "body": {
            "attachment_id": "{{ uuid }}"
          }
        }
      ],
      "binary": {
        "upload_field": "additionalFields",
        "upload_when": "false",
        "multipart_field": "file_name"
      }
    },
    {
      "resource": "messageConversation",
      "operation": "delete",
      "title": "Delete a conversation message",
      "method": "POST",
      "path": "/conversation_messages/remove",
      "query": {
        "id": "{{ p.id }}"
      },
      "fields": [
        {
          "key": "id",
          "label": "Message ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "messageConversation",
      "operation": "get",
      "title": "Get a conversation message",
      "method": "GET",
      "path": "/conversation_messages/getone",
      "query": {
        "id": "{{ p.id }}"
      },
      "fields": [
        {
          "key": "id",
          "label": "Message ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "messageConversation",
      "operation": "getAll",
      "title": "Get many conversation messages",
      "method": "GET",
      "path": "/conversation_messages/get",
      "query": {
        "conversation_id": "{{ p.conversationId }}",
        "$merge": "{{ p.additionalFields }}"
      },
      "fields": [
        {
          "key": "workspaceId",
          "label": "Workspace ID",
          "type": "text",
          "required": true
        },
        {
          "key": "conversationId",
          "label": "Conversation ID",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "from_obj_index",
            "limit",
            "order_by",
            "to_obj_index"
          ]
        }
      ]
    },
    {
      "resource": "messageConversation",
      "operation": "update",
