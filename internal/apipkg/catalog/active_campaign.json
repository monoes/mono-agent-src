      "fields": [
        {
          "key": "dealId",
          "label": "Deal ID",
          "type": "number",
          "required": true,
          "default": 0
        }
      ]
    },
    {
      "resource": "deal",
      "operation": "getAll",
      "title": "Get many deals",
      "method": "GET",
      "path": "/api/3/deals",
      "pagination": {
        "type": "offset",
        "offset_param": "offset",
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "deals"
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false,
