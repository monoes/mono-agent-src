{
  "$schema": "apipkg.v1",
  "id": "active_campaign",
  "node_type": "app.active_campaign",
  "title": "ActiveCampaign",
  "description": "Contacts, accounts, deals, lists, tags, connections and e-commerce data in ActiveCampaign",
  "category": "app",
  "docs_url": "https://developers.activecampaign.com/reference/overview",
  "n8n_types": [
    "n8n-nodes-base.activeCampaign"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.activeCampaignTrigger"
  ],
  "base_url": "{{ cred.api_url }}",
  "error_when": "{{ res.success | eq:'false' }}",
  "error_message": "{{ res.message | default:res.error }}",
  "headers": {
    "Accept": "application/json"
  },
  "credentials": [
    {
      "platform": "active_campaign",
      "name": "ActiveCampaign",
      "n8n_credential": "activeCampaignApi",
      "n8n_field_map": {
        "apiUrl": "api_url",
        "apiKey": "api_key"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "api_url",
          "label": "API URL",
          "required": true,
          "help": "e.g. https://youraccount.api-us1.com (Settings → Developer)"
        },
        {
          "key": "api_key",
          "label": "API key",
          "secret": true,
          "required": true,
          "help": "Settings → Developer"
        }
      ],
      "inject": {
        "headers": {
          "Api-Token": "{{ cred.api_key }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "contact",
      "label": "Contact"
    },
    {
      "value": "account",
      "label": "Account"
    },
    {
      "value": "accountContact",
      "label": "Account Contact"
    },
    {
      "value": "connection",
      "label": "Connection"
    },
    {
      "value": "contactList",
      "label": "Contact List"
    },
    {
      "value": "contactTag",
      "label": "Contact Tag"
    },
    {
      "value": "deal",
      "label": "Deal"
    },
    {
      "value": "ecommerceCustomer",
      "label": "E-commerce Customer"
    },
    {
      "value": "ecommerceOrder",
      "label": "E-commerce Order"
    },
    {
      "value": "ecommerceOrderProducts",
      "label": "E-commerce Order Products"
    },
    {
      "value": "list",
      "label": "List"
    },
    {
      "value": "tag",
      "label": "Tag"
    }
  ],
  "operations": [
    {
      "resource": "contact",
      "operation": "create",
      "title": "Create a contact",
      "method": "POST",
      "path": "/api/3/contact{{ p.updateIfExists | eq:'true' | then:'/sync' | default:'s' }}",
      "body": {
        "contact": {
          "email": "{{ p.email }}",
          "$merge": [
            "{{ p.additionalFields | omit:'fieldValues,fields,customProperties' }}",
            "{{ p.additionalFields.customProperties.property | kv:'name,value' }}"
          ],
          "fieldValues": "{{ p.additionalFields.fieldValues.property }}",
          "fields": "{{ p.additionalFields.fields.property }}"
        }
      },
      "output": {
        "path": "contact"
      },
      "fields": [
        {
          "key": "email",
          "label": "Email",
          "type": "text",
          "required": true
        },
        {
          "key": "updateIfExists",
          "label": "Update if exists",
          "type": "boolean",
          "default": false,
          "help": "Update the contact when one with this email already exists."
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "fieldValues",
            "firstName",
            "lastName",
            "phone"
          ],
          "help": "fieldValues: {\"property\": [{\"field\": \"1\", \"value\": \"x\"}]}"
        }
      ]
    },
    {
      "resource": "contact",
      "operation": "delete",
      "title": "Delete a contact",
      "method": "DELETE",
      "path": "/api/3/contacts/{{ p.contactId }}",
      "fields": [
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "number",
          "required": true,
          "default": 0
        }
      ]
    },
    {
      "resource": "contact",
      "operation": "get",
      "title": "Get a contact",
      "method": "GET",
      "path": "/api/3/contacts/{{ p.contactId }}",
      "fields": [
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "number",
          "required": true,
          "default": 0
        }
      ]
    },
    {
      "resource": "contact",
      "operation": "getAll",
      "title": "Get many contacts",
      "method": "GET",
      "path": "/api/3/contacts",
      "pagination": {
        "type": "offset",
        "offset_param": "offset",
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "contacts"
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false,
          "help": "Fetch every page instead of stopping at Limit."
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "help": "Maximum number of results when Return all is off.",
          "min": 1
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Return only the records (kept for n8n compatibility)."
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "datetime",
            "email",
            "email_like",
            "exclude",
            "formid",
            "listid",
            "search",
            "segmentid",
            "seriesid",
            "status",
            "tagid",
            "filters[created_before]",
            "filters[created_after]",
            "filters[updated_before]",
            "filters[updated_after]",
            "waitid",
            "orderBy"
          ]
        }
      ],
      "query": {
        "$merge": "{{ p.additionalFields | omit:'orderBy' }}",
        "orders[cdate]": "{{ p.additionalFields.orderBy | eq:'orders[cdate]' }}",
        "orders[email]": "{{ p.additionalFields.orderBy | eq:'orders[email]' }}",
        "orders[first_name]": "{{ p.additionalFields.orderBy | eq:'orders[first_name]' }}",
        "orders[last_name]": "{{ p.additionalFields.orderBy | eq:'orders[last_name]' }}",
        "orders[name]": "{{ p.additionalFields.orderBy | eq:'orders[name]' }}",
        "orders[score]": "{{ p.additionalFields.orderBy | eq:'orders[score]' }}"
      }
    },
    {
      "resource": "contact",
      "operation": "update",
      "title": "Update a contact",
      "method": "PUT",
      "path": "/api/3/contacts/{{ p.contactId }}",
      "body": {
        "contact": {
          "$merge": [
            "{{ p.updateFields | omit:'fieldValues,fields,customProperties' }}",
            "{{ p.updateFields.customProperties.property | kv:'name,value' }}"
          ],
          "fieldValues": "{{ p.updateFields.fieldValues.property }}",
          "fields": "{{ p.updateFields.fields.property }}"
        }
      },
      "output": {
        "path": "contact"
      },
      "fields": [
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "number",
          "required": true,
          "default": 0
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "email",
            "fieldValues",
            "firstName",
            "lastName",
            "phone"
          ]
        }
      ]
    },
    {
      "resource": "account",
      "operation": "create",
      "title": "Create an account",
      "method": "POST",
      "path": "/api/3/accounts",
      "body": {
        "account": {
          "name": "{{ p.name }}",
          "$merge": "{{ p.additionalFields | omit:'fieldValues,fields,customProperties' }}",
          "fieldValues": "{{ p.additionalFields.fieldValues.property }}",
          "fields": "{{ p.additionalFields.fields.property }}"
        }
      },
      "output": {
        "path": "account"
      },
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "accountUrl",
            "fields"
          ],
          "help": "fields: {\"property\": [{\"customFieldId\": 1, \"fieldValue\": \"x\"}]}"
        }
      ]
    },
    {
      "resource": "account",
      "operation": "delete",
      "title": "Delete an account",
      "method": "DELETE",
      "path": "/api/3/accounts/{{ p.accountId }}",
      "fields": [
        {
          "key": "accountId",
          "label": "Account ID",
          "type": "number",
          "required": true,
          "default": 0
        }
      ]
    },
    {
      "resource": "account",
      "operation": "get",
      "title": "Get an account",
      "method": "GET",
      "path": "/api/3/accounts/{{ p.accountId }}",
      "fields": [
        {
          "key": "accountId",
          "label": "Account ID",
          "type": "number",
          "required": true,
          "default": 0
        }
      ]
    },
    {
      "resource": "account",
      "operation": "getAll",
      "title": "Get many accounts",
      "method": "GET",
      "path": "/api/3/accounts",
      "pagination": {
        "type": "offset",
        "offset_param": "offset",
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "accounts"
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false,
          "help": "Fetch every page instead of stopping at Limit."
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "help": "Maximum number of results when Return all is off.",
          "min": 1
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Return only the records (kept for n8n compatibility)."
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "search"
          ]
        }
      ],
      "query": {
        "$merge": "{{ p.filters }}"
      }
    },
    {
      "resource": "account",
      "operation": "update",
      "title": "Update an account",
      "method": "PUT",
      "path": "/api/3/accounts/{{ p.accountId }}",
      "body": {
        "account": {
          "$merge": "{{ p.updateFields | omit:'fieldValues,fields,customProperties' }}",
          "fieldValues": "{{ p.updateFields.fieldValues.property }}",
          "fields": "{{ p.updateFields.fields.property }}"
        }
      },
      "output": {
        "path": "account"
      },
      "fields": [
        {
          "key": "accountId",
          "label": "Account ID",
          "type": "number",
          "required": true,
          "default": 0
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "name",
            "accountUrl",
            "fields"
          ]
        }
      ]
    },
    {
      "resource": "accountContact",
      "operation": "create",
      "title": "Associate a contact with an account",
      "method": "POST",
      "path": "/api/3/accountContacts",
      "body": {
        "accountContact": {
          "contact": "{{ p.contact }}",
          "account": "{{ p.account }}",
          "$merge": "{{ p.additionalFields }}"
        }
      },
      "output": {
        "path": "accountContact"
      },
      "fields": [
        {
          "key": "account",
          "label": "Account ID",
          "type": "number",
          "required": true
        },
        {
          "key": "contact",
          "label": "Contact ID",
          "type": "number",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "jobTitle"
          ]
        }
      ]
    },
    {
      "resource": "accountContact",
      "operation": "delete",
      "title": "Remove an account association",
      "method": "DELETE",
      "path": "/api/3/accountContacts/{{ p.accountContactId }}",
      "fields": [
        {
          "key": "accountContactId",
          "label": "Account contact ID",
          "type": "number",
          "required": true,
          "default": 0
        }
      ]
    },
    {
      "resource": "accountContact",
      "operation": "update",
      "title": "Update an account association",
      "method": "PUT",
      "path": "/api/3/accountContacts/{{ p.accountContactId }}",
      "body": {
        "accountContact": {
          "$merge": "{{ p.updateFields }}"
        }
      },
      "output": {
        "path": "accountContact"
      },
      "fields": [
        {
          "key": "accountContactId",
          "label": "Account contact ID",
          "type": "number",
          "required": true,
          "default": 0
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "jobTitle"
          ]
        }
      ]
    },
    {
      "resource": "connection",
      "operation": "create",
      "title": "Create a connection",
      "method": "POST",
      "path": "/api/3/connections",
      "body": {
        "connection": {
          "service": "{{ p.service }}",
          "externalid": "{{ p.externalid }}",
          "name": "{{ p.name }}",
          "logoUrl": "{{ p.logoUrl }}",
          "linkUrl": "{{ p.linkUrl }}"
        }
      },
      "fields": [
        {
          "key": "service",
          "label": "Service",
          "type": "text",
          "required": true
        },
        {
          "key": "externalid",
          "label": "External ID",
          "type": "text",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "logoUrl",
          "label": "Logo URL",
          "type": "text",
          "required": true
        },
        {
          "key": "linkUrl",
          "label": "Link URL",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "connection",
      "operation": "delete",
      "title": "Delete a connection",
      "method": "DELETE",
      "path": "/api/3/connections/{{ p.connectionId }}",
      "fields": [
        {
          "key": "connectionId",
          "label": "Connection ID",
          "type": "number",
          "required": true,
          "default": 0
        }
      ]
    },
    {
      "resource": "connection",
      "operation": "get",
      "title": "Get a connection",
      "method": "GET",
      "path": "/api/3/connections/{{ p.connectionId }}",
      "fields": [
        {
          "key": "connectionId",
          "label": "Connection ID",
          "type": "number",
          "required": true,
          "default": 0
        }
      ]
    },
    {
      "resource": "connection",
      "operation": "getAll",
      "title": "Get many connections",
      "method": "GET",
      "path": "/api/3/connections",
      "pagination": {
        "type": "offset",
        "offset_param": "offset",
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "connections"
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false,
          "help": "Fetch every page instead of stopping at Limit."
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "help": "Maximum number of results when Return all is off.",
          "min": 1
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Return only the records (kept for n8n compatibility)."
        }
      ]
    },
    {
      "resource": "connection",
      "operation": "update",
      "title": "Update a connection",
      "method": "PUT",
      "path": "/api/3/connections/{{ p.connectionId }}",
      "body": {
        "connection": {
          "$merge": "{{ p.updateFields }}"
        }
      },
      "fields": [
        {
          "key": "connectionId",
          "label": "Connection ID",
          "type": "number",
          "required": true,
          "default": 0
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "service",
            "externalid",
            "name",
            "logoUrl",
            "linkUrl",
            "status",
            "syncStatus"
          ]
        }
      ]
    },
    {
      "resource": "contactList",
      "operation": "add",
      "title": "Add a contact to a list",
      "method": "POST",
      "path": "/api/3/contactLists",
      "body": {
        "contactList": {
          "list": "{{ p.listId }}",
          "contact": "{{ p.contactId }}",
          "status": 1
        }
      },
      "fields": [
        {
          "key": "listId",
          "label": "List ID",
          "type": "number",
          "required": true
        },
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "resource": "contactList",
      "operation": "remove",
      "title": "Remove a contact from a list",
      "method": "POST",
      "path": "/api/3/contactLists",
      "body": {
        "contactList": {
          "list": "{{ p.listId }}",
          "contact": "{{ p.contactId }}",
          "status": 2
        }
      },
      "output": {
        "path": "contacts"
      },
      "fields": [
        {
          "key": "listId",
          "label": "List ID",
          "type": "number",
          "required": true
        },
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "resource": "contactTag",
      "operation": "add",
      "title": "Add a tag to a contact",
      "method": "POST",
      "path": "/api/3/contactTags",
      "body": {
        "contactTag": {
          "contact": "{{ p.contactId }}",
          "tag": "{{ p.tagId }}"
        }
      },
      "output": {
        "path": "contactTag"
      },
      "fields": [
        {
          "key": "tagId",
          "label": "Tag ID",
          "type": "text",
          "required": true
        },
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "resource": "contactTag",
      "operation": "remove",
      "title": "Remove a tag from a contact",
      "method": "DELETE",
      "path": "/api/3/contactTags/{{ p.contactTagId }}",
