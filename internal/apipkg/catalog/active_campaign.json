        }
      ]
    },
    {
      "resource": "deal",
      "operation": "create",
      "title": "Create a deal",
      "method": "POST",
      "path": "/api/3/deals",
      "body": {
        "deal": {
          "title": "{{ p.title }}",
          "contact": "{{ p.contact }}",
          "value": "{{ p.value }}",
          "currency": "{{ p.currency }}",
          "group": "{{ p.group }}",
          "stage": "{{ p.stage }}",
          "owner": "{{ p.owner }}",
          "$merge": "{{ p.additionalFields }}"
        }
      },
      "fields": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "contact",
          "label": "Contact ID",
          "type": "number",
          "required": true,
          "default": 0
        },
        {
          "key": "value",
          "label": "Value",
          "type": "number",
          "required": true,
          "default": 0,
          "help": "Deal value in cents."
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "text",
          "required": true,
          "default": "eur",
          "help": "Three-letter currency code, e.g. eur or usd."
        },
        {
          "key": "group",
          "label": "Pipeline ID",
          "type": "text"
        },
        {
          "key": "stage",
          "label": "Stage ID",
          "type": "text"
        },
        {
          "key": "owner",
          "label": "Owner ID",
          "type": "text"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "description",
            "percent",
            "status"
          ]
        }
      ]
    },
    {
      "resource": "deal",
      "operation": "createNote",
      "title": "Add a note to a deal",
      "method": "POST",
      "path": "/api/3/deals/{{ p.dealId }}/notes",
      "body": {
        "note": {
          "note": "{{ p.dealNote }}"
        }
      },
      "fields": [
