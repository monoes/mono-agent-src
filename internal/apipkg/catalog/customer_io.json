{
  "$schema": "apipkg.v1",
  "id": "customer_io",
  "node_type": "app.customer_io",
  "title": "Customer.io",
  "description": "Customers, events, campaigns and segments in Customer.io",
  "category": "app",
  "docs_url": "https://customer.io/docs/api/",
  "n8n_types": [
    "n8n-nodes-base.customerIo"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.customerIoTrigger"
  ],
  "base_url": "https://{{ cred.region | default:'track.customer.io' }}/api/v1",
  "headers": {
    "Accept": "application/json"
  },
  "credentials": [
    {
      "platform": "customer_io",
      "name": "Customer.io",
      "n8n_credential": "customerIoApi",
      "n8n_field_map": {
        "trackingApiKey": "tracking_api_key",
        "region": "region",
        "trackingSiteId": "tracking_site_id",
        "appApiKey": "app_api_key"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "tracking_site_id",
          "label": "Tracking site ID",
          "help": "Used with the tracking API key for customer, event and segment calls"
        },
        {
          "key": "tracking_api_key",
          "label": "Tracking API key",
          "secret": true,
          "required": true
        },
        {
          "key": "region",
          "label": "Tracking host",
          "help": "track.customer.io (US, default) or track-eu.customer.io (EU)"
        },
        {
          "key": "app_api_key",
          "label": "App API key",
          "secret": true,
          "help": "Needed for campaign operations"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "{{ p.resource | eq:'campaign' | then:'Bearer ' | suffix:cred.app_api_key | default:(cred.tracking_site_id | default:'' | suffix:':' | suffix:cred.tracking_api_key | base64 | prefix:'Basic ') }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "customer",
      "label": "Customer"
    },
    {
      "value": "event",
      "label": "Event"
    },
    {
      "value": "campaign",
      "label": "Campaign"
    },
    {
      "value": "segment",
      "label": "Segment"
    }
  ],
  "operations": [
    {
      "resource": "customer",
      "operation": "upsert",
      "title": "Create or update a customer",
      "method": "PUT",
      "path": "/customers/{{ p.id }}",
      "fields": [
        {
          "key": "id",
          "label": "Customer ID",
          "type": "text",
          "required": true,
          "help": "Your identifier for the customer"
        },
        {
          "key": "jsonParameters",
          "label": "Fields as JSON",
          "type": "boolean",
          "default": false
        },
        {
          "key": "additionalFieldsJson",
          "label": "Fields (JSON)",
          "type": "json",
          "default": "",
          "help": "Used when Fields as JSON is on"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "customProperties",
            "email",
            "createdAt"
          ],
          "help": "customProperties: {\"customProperty\": [{\"key\", \"value\"}]}; createdAt: a date"
        }
      ],
      "body": {
        "$merge": "{{ p.jsonParameters | eq:'true' | then:p.additionalFieldsJson | fromjson }}",
        "data": "{{ p.additionalFields.customProperties | kv:'key,value' }}",
        "email": "{{ p.additionalFields.email }}",
        "created_at": "{{ p.additionalFields.createdAt | epoch }}"
      }
    },
    {
      "resource": "customer",
      "operation": "delete",
      "title": "Delete a customer",
      "method": "DELETE",
      "path": "/customers/{{ p.id }}",
      "fields": [
        {
          "key": "id",
          "label": "Customer ID",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "id": "{{ p.id }}"
      }
    },
    {
      "resource": "event",
      "operation": "track",
      "title": "Track a customer event",
      "method": "POST",
      "path": "/customers/{{ p.customerId }}/events",
      "fields": [
        {
          "key": "customerId",
          "label": "Customer ID",
          "type": "text",
          "required": true
        },
        {
          "key": "eventName",
          "label": "Event name",
          "type": "text",
          "required": true
        },
        {
          "key": "jsonParameters",
          "label": "Fields as JSON",
          "type": "boolean",
          "default": false
        },
        {
          "key": "additionalFieldsJson",
          "label": "Fields (JSON)",
          "type": "json",
          "default": ""
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "customAttributes",
            "type"
          ],
          "help": "customAttributes: {\"customAttribute\": [{\"key\", \"value\"}]}; type: e.g. page"
        }
      ],
      "body": {
        "name": "{{ p.eventName }}",
        "$merge": "{{ p.jsonParameters | eq:'true' | then:p.additionalFieldsJson | fromjson }}",
        "data": {
          "$merge": "{{ p.additionalFields.customAttributes | kv:'key,value' }}",
          "type": "{{ p.additionalFields.type }}"
        }
      }
    },
    {
      "resource": "event",
      "operation": "trackAnonymous",
      "title": "Track an anonymous event",
      "method": "POST",
      "path": "/events",
      "fields": [
        {
          "key": "eventName",
          "label": "Event name",
          "type": "text",
          "required": true
        },
        {
          "key": "jsonParameters",
          "label": "Fields as JSON",
          "type": "boolean",
          "default": false
        },
        {
          "key": "additionalFieldsJson",
          "label": "Fields (JSON)",
          "type": "json",
          "default": ""
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "customAttributes"
          ]
        }
      ],
      "body": {
        "name": "{{ p.eventName }}",
        "$merge": "{{ p.jsonParameters | eq:'true' | then:p.additionalFieldsJson | fromjson }}",
        "data": "{{ p.additionalFields.customAttributes | kv:'key,value' }}"
      }
    },
    {
      "resource": "campaign",
      "operation": "get",
      "title": "Get a campaign",
      "method": "GET",
      "path": "/campaigns/{{ p.campaignId }}",
      "base_url": "https://{{ cred.region | eq:'track-eu.customer.io' | then:'api-eu' | default:'api' }}.customer.io/v1",
      "fields": [
        {
          "key": "campaignId",
          "label": "Campaign ID",
          "type": "number",
          "required": true
        }
      ],
      "output": {
        "path": "campaign"
      }
    },
    {
      "resource": "campaign",
      "operation": "getAll",
      "title": "Get many campaigns",
      "method": "GET",
      "path": "/campaigns",
      "base_url": "https://{{ cred.region | eq:'track-eu.customer.io' | then:'api-eu' | default:'api' }}.customer.io/v1",
      "output": {
        "path": "campaigns"
      }
    },
    {
      "resource": "campaign",
      "operation": "getMetrics",
      "title": "Get campaign metrics",
      "method": "GET",
      "path": "/campaigns/{{ p.campaignId }}/metrics",
      "base_url": "https://{{ cred.region | eq:'track-eu.customer.io' | then:'api-eu' | default:'api' }}.customer.io/v1",
      "fields": [
        {
          "key": "campaignId",
          "label": "Campaign ID",
          "type": "number",
          "required": true
        },
        {
          "key": "period",
          "label": "Period",
          "type": "select",
          "default": "days",
          "options": [
            "hours",
            "days",
            "weeks",
            "months"
          ]
        },
        {
          "key": "jsonParameters",
          "label": "Options as JSON",
          "type": "boolean",
          "default": false
        },
        {
          "key": "additionalFieldsJson",
          "label": "Options (JSON)",
          "type": "json",
          "default": "",
          "help": "Query parameters as a JSON object"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "steps",
            "type"
          ],
          "help": "type: email, empty, push, slack, twilio, urbanAirship or webhook"
        }
      ],
      "query": {
        "period": "{{ p.period }}",
        "steps": "{{ p.additionalFields.steps }}",
        "type": "{{ p.additionalFields.type | eq:'urbanAirship' | then:'urban_airship' | default:p.additionalFields.type }}",
        "$merge": "{{ p.jsonParameters | eq:'true' | then:p.additionalFieldsJson | fromjson }}"
      },
      "output": {
        "path": "metric"
      }
    },
    {
      "resource": "segment",
      "operation": "add",
      "title": "Add customers to a segment",
      "method": "POST",
      "path": "/segments/{{ p.segmentId }}/add_customers",
      "fields": [
        {
          "key": "segmentId",
          "label": "Segment ID",
          "type": "number",
          "required": true,
          "help": "A manual segment"
        },
        {
          "key": "customerIds",
          "label": "Customer IDs",
          "type": "text",
          "required": true,
          "help": "Comma-separated"
        }
      ],
      "body": {
        "id": "{{ p.segmentId }}",
        "ids": "{{ p.customerIds | split }}"
      }
    },
    {
      "resource": "segment",
      "operation": "remove",
      "title": "Remove customers from a segment",
      "method": "POST",
      "path": "/segments/{{ p.segmentId }}/remove_customers",
      "fields": [
        {
          "key": "segmentId",
          "label": "Segment ID",
          "type": "number",
          "required": true
        },
        {
          "key": "customerIds",
          "label": "Customer IDs",
          "type": "text",
          "required": true,
          "help": "Comma-separated"
        }
      ],
      "body": {
        "id": "{{ p.segmentId }}",
        "ids": "{{ p.customerIds | split }}"
      }
    }
  ],
  "webhook": {
    "fields": [
      {
        "key": "events",
        "label": "Events",
        "type": "array",
        "required": true
      }
    ],
    "create": [
      {
        "method": "POST",
        "path": "/reporting_webhooks",
        "body": {
          "name": "mono-agent webhook - {{ hook.url }}",
          "endpoint": "{{ hook.url }}",
          "events": {
            "$map": "{{ p.events }}",
            "$to": "{{ el | replace:'.','_' }}"
          }
        },
        "base_url": "https://{{ cred.region | matches:'eu' | then:'api-eu.customer.io' | default:'api.customer.io' }}/v1",
        "auth": false,
        "headers": {
          "Authorization": "Bearer {{ cred.app_api_key }}"
        }
      }
    ],
    "id": "{{ res.id }}",
    "delete": [
      {
        "method": "DELETE",
        "path": "/reporting_webhooks/{{ hook.id }}",
        "base_url": "https://{{ cred.region | matches:'eu' | then:'api-eu.customer.io' | default:'api.customer.io' }}/v1",
        "auth": false,
        "headers": {
          "Authorization": "Bearer {{ cred.app_api_key }}"
        }
      }
    ]
  }
}
