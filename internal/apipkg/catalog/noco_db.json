        }
      ],
      "output": {
        "path": "records"
      }
    },
    {
      "resource": "row",
      "operation": "search",
      "title": "Search rows",
      "method": "GET",
      "path": "/api/v3/data/{{ p.projectId | rl }}/{{ p.table | rl }}/records",
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "nocoDb",
          "options": [
            "nocoDbApiToken",
            "nocoDb"
          ],
          "help": "Kept for n8n compatibility; the connection decides."
        },
        {
          "key": "workspaceId",
          "label": "Workspace ID",
          "type": "text",
          "default": "",
          "help": "Optional; an n8n resource locator is accepted."
        },
        {
          "key": "projectId",
          "label": "Base ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "table",
          "label": "Table ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 100
        },
        {
          "key": "downloadAttachments",
          "label": "Download attachments",
          "type": "boolean",
          "default": false,
          "help": "Download the files of the attachment fields below onto the item (binary <field>_<index>)."
        },
        {
          "key": "downloadFieldNames",
          "label": "Attachment fields",
          "type": "array",
          "default": [],
          "item_type": "text"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "viewId",
            "fields",
            "sort",
            "where",
            "page",
            "shuffle"
          ],
          "help": "sort: {\"property\": [{\"field\": \"Title\", \"direction\": \"asc\"}]}; where: (Title,eq,x)"
        }
      ],
      "query": {
        "viewId": "{{ p.options.viewId | rl }}",
        "fields": "{{ p.options.fields | csv }}",
        "sort": {
          "$json": {
            "$map": "{{ p.options.sort.property }}",
            "$to": {
              "field": "{{ el.field | rl }}",
              "direction": "{{ el.direction }}"
            }
          }
        },
        "where": "{{ p.options.where }}",
        "page": "{{ p.options.page }}",
        "shuffle": "{{ p.options.shuffle | eq:'true' | then:1 }}"
      },
      "pagination": {
        "type": "offset",
        "offset_param": "offset",
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "records"
      },
      "output": {
        "download": {
          "when": "{{ p.downloadAttachments }}",
          "files": {
            "$map": "{{ p.downloadFieldNames | split }}",
            "$to": {
              "$map": "{{ up.fields | get:el | fromjson }}",
              "$to": {
                "url": "{{ el.signedUrl | default:el.url }}",
                "property": "{{ up }}_{{ idx }}",
                "title": "{{ el.title }}",
                "mimetype": "{{ el.mimetype }}"
              }
            }
          },
          "method": "GET",
          "path": "{{ el.url }}",
          "property": "{{ el.property }}",
          "file_name": "{{ el.title }}",
          "mime_type": "{{ el.mimetype }}"
        }
      }
    },
    {
