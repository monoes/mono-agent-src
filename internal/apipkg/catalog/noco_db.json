          ]
        }
      ],
      "query": {
        "where": "{{ p.options.where }}"
      }
    },
    {
      "resource": "row",
      "operation": "upload",
      "title": "Upload an attachment to a cell",
      "method": "{{ p.uploadMode | eq:'url' | then:'PATCH' | default:'POST' }}",
      "path": "/api/v3/data/{{ p.projectId | rl }}/{{ p.table | rl }}/records{{ p.uploadMode | ne:'url' | then:(p.id | prefix:'/') | path }}{{ p.uploadMode | ne:'url' | then:(p.uploadFieldName | rl | prefix:'/fields/' | suffix:'/upload') | path }}",
      "before": {
        "when": "{{ p.uploadMode | eq:'url' }}",
        "method": "GET",
        "path": "/api/v3/data/{{ p.projectId | rl }}/{{ p.table | rl }}/records/{{ p.id }}"
      },
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "nocoDb",
          "options": [
            "nocoDbApiToken",
            "nocoDb"
          ],
          "help": "Kept for n8n compatibility; the connection decides."
        },
        {
          "key": "workspaceId",
          "label": "Workspace ID",
          "type": "text",
          "default": "",
          "help": "Optional; an n8n resource locator is accepted."
        },
        {
          "key": "projectId",
          "label": "Base ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "table",
          "label": "Table ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "id",
          "label": "Row ID",
          "type": "text",
          "default": "",
          "required": true
        },
        {
          "key": "uploadMode",
          "label": "Upload mode",
          "type": "select",
          "default": "base64",
          "required": true,
          "options": [
            "base64",
            "url"
          ]
        },
        {
          "key": "uploadFieldName",
          "label": "Attachment field",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "filename",
          "label": "File name",
          "type": "text",
          "default": "",
          "help": "base64 mode"
        },
        {
          "key": "contentType",
          "label": "Content type",
          "type": "text",
          "default": "",
          "help": "base64 mode"
        },
        {
          "key": "base64value",
          "label": "Base64 content",
          "type": "textarea",
          "default": "",
          "help": "base64 mode"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "text",
          "default": "",
          "help": "url mode"
        }
      ],
      "body": {
        "contentType": "{{ p.uploadMode | ne:'url' | then:p.contentType }}",
        "file": "{{ p.uploadMode | ne:'url' | then:p.base64value }}",
        "filename": "{{ p.uploadMode | ne:'url' | then:p.filename }}",
        "id": "{{ p.uploadMode | eq:'url' | then:p.id }}",
        "fields": {
          "$entries": "{{ p.uploadMode | eq:'url' | then:(p.uploadFieldName | rl) | split }}",
          "$key": "{{ el }}",
          "$value": {
            "$concat": [
              "{{ pre.fields | get:el | fromjson }}",
              [
                {
                  "url": "{{ p.url }}"
                }
              ]
            ]
          }
        }
      }
    },
    {
      "resource": "linkrow",
      "operation": "list",
      "title": "List linked rows",
      "method": "GET",
      "path": "/api/v3/data/{{ p.projectId | rl }}/{{ p.table | rl }}/links/{{ p.linkFieldName | rl }}/{{ p.id }}",
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "nocoDb",
          "options": [
            "nocoDbApiToken",
