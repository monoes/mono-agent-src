        {
          "key": "projectId",
          "label": "Base ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "table",
          "label": "Table ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "dataToSend",
          "label": "Data to send",
          "type": "select",
          "default": "mapWithFields",
          "options": [
            "autoMapInputData",
            "mapWithFields"
          ]
        },
        {
          "key": "id",
          "label": "Row ID",
          "type": "text",
          "default": "",
          "help": "Empty creates a new row."
        },
        {
          "key": "inputsToIgnore",
          "label": "Input fields to ignore",
          "type": "text",
          "default": "",
          "help": "Comma-separated, with autoMapInputData (reads the item's fields object)."
        },
        {
          "key": "fieldsMapper",
          "label": "Columns",
          "type": "json",
          "default": {
            "mappingMode": "defineBelow",
            "value": null
          },
          "help": "n8n resource mapper: {\"value\": {\"Title\": \"x\"}}"
        }
      ],
      "body": [
        {
          "id": "{{ p.id }}",
          "fields": {
            "$merge": [
              "{{ p.dataToSend | eq:'autoMapInputData' | then:(item.fields | omit:p.inputsToIgnore) }}",
              "{{ p.dataToSend | ne:'autoMapInputData' | then:p.fieldsMapper.value }}"
            ]
          }
        }
      ],
      "output": {
        "path": "records"
