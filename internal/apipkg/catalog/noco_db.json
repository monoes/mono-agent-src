        },
        {
          "key": "linkFieldName",
          "label": "Link field ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 100
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "fields",
            "sort",
            "where"
          ],
          "help": "fields: {\"items\": [{\"field\": \"Title\"}]}"
        }
      ],
      "query": {
        "fields": {
