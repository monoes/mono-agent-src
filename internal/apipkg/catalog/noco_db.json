{
  "$schema": "apipkg.v1",
  "id": "noco_db",
  "title": "NocoDB",
  "description": "Rows, links and bases in NocoDB (n8n node version 4, NocoDB API v3)",
  "category": "app",
  "docs_url": "https://nocodb.com/apis/v3/data",
  "n8n_types": [
    "n8n-nodes-base.nocoDb"
  ],
  "base_url": "{{ cred.host }}",
  "credentials": [
    {
      "platform": "nocodb",
      "name": "NocoDB (API token)",
      "n8n_credential": "nocoDbApiToken",
      "n8n_field_map": {
        "apiToken": "api_token",
        "host": "host"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "host",
          "label": "Host",
          "required": true,
          "help": "e.g. https://app.nocodb.com (no trailing slash)"
        },
        {
          "key": "api_token",
          "label": "API token",
          "secret": true,
          "required": true
        }
      ],
      "inject": {
        "headers": {
          "xc-token": "{{ cred.api_token }}"
        }
      }
    },
    {
      "platform": "nocodb_user",
      "name": "NocoDB (user token)",
      "n8n_credential": "nocoDb",
      "n8n_field_map": {
        "apiToken": "user_token",
        "host": "host"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "host",
          "label": "Host",
          "required": true,
          "help": "e.g. https://app.nocodb.com (no trailing slash)"
        },
        {
          "key": "user_token",
          "label": "User token",
          "secret": true,
          "required": true
        }
      ],
      "inject": {
        "headers": {
          "xc-auth": "{{ cred.user_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "row",
      "label": "Row"
    },
    {
      "value": "linkrow",
      "label": "Link row"
    },
    {
      "value": "base",
      "label": "Base"
    }
  ],
  "operations": [
    {
      "resource": "row",
      "operation": "get",
      "title": "Get a row",
      "method": "GET",
      "path": "/api/v3/data/{{ p.projectId | rl }}/{{ p.table | rl }}/records/{{ p.id }}",
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "nocoDb",
          "options": [
            "nocoDbApiToken",
            "nocoDb"
          ],
          "help": "Kept for n8n compatibility; the connection decides."
        },
        {
          "key": "workspaceId",
          "label": "Workspace ID",
          "type": "text",
          "default": "",
          "help": "Optional; an n8n resource locator is accepted."
        },
        {
          "key": "projectId",
          "label": "Base ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "table",
          "label": "Table ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "id",
          "label": "Row ID",
          "type": "text",
          "default": "",
          "required": true
        },
        {
          "key": "downloadAttachments",
          "label": "Download attachments",
          "type": "boolean",
          "default": false,
          "help": "Download the files of the attachment fields below onto the item (binary <field>_<index>)."
        },
        {
          "key": "downloadFieldNames",
          "label": "Attachment fields",
          "type": "array",
          "default": [],
          "item_type": "text"
        }
      ],
      "output": {
        "download": {
          "when": "{{ p.downloadAttachments }}",
          "files": {
            "$map": "{{ p.downloadFieldNames | split }}",
            "$to": {
              "$map": "{{ up.fields | get:el | fromjson }}",
              "$to": {
                "url": "{{ el.signedUrl | default:el.url }}",
                "property": "{{ up }}_{{ idx }}",
                "title": "{{ el.title }}",
                "mimetype": "{{ el.mimetype }}"
              }
            }
          },
          "method": "GET",
          "path": "{{ el.url }}",
          "property": "{{ el.property }}",
          "file_name": "{{ el.title }}",
          "mime_type": "{{ el.mimetype }}"
        }
      }
    },
    {
      "resource": "row",
      "operation": "create",
      "title": "Create a row",
      "method": "POST",
      "path": "/api/v3/data/{{ p.projectId | rl }}/{{ p.table | rl }}/records",
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "nocoDb",
          "options": [
            "nocoDbApiToken",
            "nocoDb"
          ],
          "help": "Kept for n8n compatibility; the connection decides."
        },
        {
          "key": "workspaceId",
          "label": "Workspace ID",
          "type": "text",
          "default": "",
          "help": "Optional; an n8n resource locator is accepted."
        },
        {
          "key": "projectId",
          "label": "Base ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "table",
          "label": "Table ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "dataToSend",
          "label": "Data to send",
          "type": "select",
          "default": "mapWithFields",
          "options": [
            "autoMapInputData",
            "mapWithFields"
          ]
        },
        {
          "key": "inputsToIgnore",
          "label": "Input fields to ignore",
          "type": "text",
          "default": "",
          "help": "Comma-separated, with autoMapInputData (reads the item's fields object)."
        },
        {
          "key": "fieldsMapper",
          "label": "Columns",
          "type": "json",
          "default": {
            "mappingMode": "defineBelow",
            "value": null
          },
          "help": "n8n resource mapper: {\"value\": {\"Title\": \"x\"}}"
        }
      ],
      "body": [
        {
          "fields": {
            "$merge": [
              "{{ p.dataToSend | eq:'autoMapInputData' | then:(item.fields | omit:p.inputsToIgnore) }}",
              "{{ p.dataToSend | ne:'autoMapInputData' | then:p.fieldsMapper.value }}"
            ]
          }
        }
      ],
      "output": {
        "path": "records"
      }
    },
    {
      "resource": "row",
