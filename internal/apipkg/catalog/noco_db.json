      "path": "/api/v3/data/{{ p.projectId | rl }}/{{ p.table | rl }}/records",
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "nocoDb",
          "options": [
            "nocoDbApiToken",
            "nocoDb"
          ],
          "help": "Kept for n8n compatibility; the connection decides."
        },
        {
          "key": "workspaceId",
          "label": "Workspace ID",
          "type": "text",
          "default": "",
          "help": "Optional; an n8n resource locator is accepted."
        },
        {
          "key": "projectId",
          "label": "Base ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "table",
          "label": "Table ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "An n8n resource locator is accepted."
        },
        {
          "key": "id",
          "label": "Row ID",
          "type": "text",
