{
  "$schema": "apipkg.v1",
  "id": "aws_cognito",
  "node_type": "app.aws_cognito",
  "title": "AWS Cognito",
  "description": "Users, groups and user pools in Amazon Cognito",
  "category": "app",
  "docs_url": "https://docs.aws.amazon.com/cognito-user-identity-pools/latest/APIReference/API_Operations.html",
  "n8n_types": [
    "n8n-nodes-base.awsCognito"
  ],
  "base_url": "https://cognito-idp.{{ cred.region | default:'us-east-1' }}.amazonaws.com{{ cred.region | matches:'^cn-' | then:'.cn' }}",
  "credentials": [
    {
      "platform": "aws",
      "reuse_platform": "aws",
      "name": "AWS",
      "n8n_credential": "aws",
      "n8n_field_map": {
        "accessKeyId": "access_key_id",
        "secretAccessKey": "secret_access_key",
        "sessionToken": "session_token",
        "region": "region",
        "stsAccessKeyId": "access_key_id",
        "stsSecretAccessKey": "secret_access_key",
        "stsSessionToken": "session_token",
        "roleArn": "role_arn",
        "externalId": "external_id",
        "roleSessionName": "role_session_name"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "access_key_id",
          "label": "Access key ID",
          "required": true
        },
        {
          "key": "secret_access_key",
          "label": "Secret access key",
          "secret": true,
          "required": true
        },
        {
          "key": "region",
          "label": "Region",
          "help": "Default us-east-1"
        },
        {
          "key": "session_token",
          "label": "Session token",
          "secret": true,
          "help": "Only for temporary credentials"
        }
      ],
      "inject": {
        "aws_sigv4": {
          "service": "cognito-idp",
          "region": "{{ cred.region | default:'us-east-1' }}"
        }
      },
      "n8n_credential_alt": [
        "awsAssumeRole"
      ]
    }
  ],
  "resources": [
    {
      "value": "user",
      "label": "User"
    },
    {
      "value": "group",
      "label": "Group"
    },
    {
      "value": "userPool",
      "label": "User Pool"
    }
  ],
  "operations": [
    {
      "resource": "user",
      "operation": "getAll",
      "title": "Get many users",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Amz-Target": "AWSCognitoIdentityProviderService.ListUsers",
        "Content-Type": "application/x-amz-json-1.1"
      },
      "body_type": "json",
      "body": {
        "UserPoolId": "{{ p.userPool | rl }}",
        "Filter": {
          "$join": [
            "{{ p.filters.filter.value | then:(p.filters.filter.attribute | default:'email') | replace:'\"','\\\"' }}",
            "{{ p.filters.filter.value | replace:'\"','\\\"' }}"
          ],
          "$sep": "\"^=\"",
          "$prefix": "\"",
          "$suffix": "\""
        }
      },
      "fields": [
        {
          "key": "userPool",
          "label": "User pool",
          "type": "text",
          "required": true,
          "help": "User pool ID, e.g. us-east-1_AbC123"
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 60
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "filter"
          ],
          "help": "{filter: {attribute, value}}: users whose attribute starts with value"
        }
      ],
      "output": {
        "to": {
          "$merge": [
            "{{ el | omit:'Attributes' }}",
            {
              "$entries": "{{ el.Attributes }}",
              "$key": "{{ el.Name }}",
              "$value": "{{ el.Value | default:'' }}"
            }
          ]
        },
        "to_when": "{{ p.simple }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "PaginationToken",
        "cursor_path": "PaginationToken",
        "limit_param": "Limit",
        "page_size": 60,
        "param_in": "body",
        "results_path": "Users"
      }
    },
    {
      "resource": "user",
      "operation": "addToGroup",
      "title": "Add a user to a group",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Amz-Target": "AWSCognitoIdentityProviderService.AdminAddUserToGroup",
        "Content-Type": "application/x-amz-json-1.1"
      },
      "body_type": "json",
      "body": {
        "UserPoolId": "{{ p.userPool | rl }}",
        "Username": "{{ pres.0.Users.0.Username | default:(p.user | rl) }}",
        "GroupName": "{{ p.group | rl }}"
      },
      "fields": [
        {
          "key": "userPool",
          "label": "User pool",
          "type": "text",
          "required": true,
          "help": "User pool ID, e.g. us-east-1_AbC123"
        },
        {
          "key": "user",
          "label": "User",
          "type": "text",
          "required": true,
          "help": "User name, email/phone (when the pool signs in with them) or sub"
        },
        {
          "key": "group",
          "label": "Group",
          "type": "text",
          "required": true,
          "help": "Group name"
        }
      ],
      "output": {
        "to": {
          "addedToGroup": true
        }
      },
      "before": [
        {
          "method": "POST",
          "path": "/",
          "headers": {
            "X-Amz-Target": "AWSCognitoIdentityProviderService.ListUsers",
            "Content-Type": "application/x-amz-json-1.1"
          },
          "body": {
            "UserPoolId": "{{ p.userPool | rl }}",
            "Filter": "sub = \"{{ p.user | rl | replace:'\"','' }}\""
          }
        }
      ]
    },
    {
      "resource": "user",
      "operation": "create",
      "title": "Create a user",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Amz-Target": "AWSCognitoIdentityProviderService.AdminCreateUser",
        "Content-Type": "application/x-amz-json-1.1"
      },
      "body_type": "json",
      "body": {
        "UserPoolId": "{{ p.userPool | rl }}",
        "Username": "{{ p.newUserName }}",
        "MessageAction": "{{ p.additionalFields.messageAction | eq:'SUPPRESS' | then:'SUPPRESS' }}",
        "ForceAliasCreation": "{{ p.additionalFields.forceAliasCreation }}",
        "DesiredDeliveryMediums": "{{ p.additionalFields.desiredDeliveryMediums }}",
        "TemporaryPassword": "{{ p.additionalFields.temporaryPasswordOptions }}",
        "UserAttributes": {
          "$map": "{{ p.additionalFields.userAttributes.attributes }}",
          "$to": {
            "Name": "{{ el.attributeType | eq:'custom' | then:(el.customName | re:'^(?:custom:)?(.*)$' | prefix:'custom:') | default:(el.standardName | default:'address') }}",
            "Value": "{{ el.value }}"
          }
        }
      },
      "fields": [
        {
          "key": "userPool",
          "label": "User pool",
          "type": "text",
          "required": true,
          "help": "User pool ID, e.g. us-east-1_AbC123"
        },
        {
          "key": "newUserName",
          "label": "User name",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "desiredDeliveryMediums",
            "forceAliasCreation",
            "messageAction",
            "temporaryPasswordOptions",
            "userAttributes"
          ],
          "help": "messageAction: RESEND or SUPPRESS; desiredDeliveryMediums: [\"SMS\", \"EMAIL\"]; userAttributes: {attributes: [{attributeType: standard|custom, standardName, customName, value}]}; standard names: address, birthdate, email, email_verified, family_name, gender, given_name, locale, middle_name, name, nickname, phone_number, phone_number_verified, preferred_username, profilepicture, updated_at, sub, website, zoneinfo"
        }
      ],
      "output": {
        "path": "User"
      }
    },
