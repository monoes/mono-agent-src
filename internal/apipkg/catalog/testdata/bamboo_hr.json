      "options": {
        "fields": [
          "firstName",
          "jobTitle"
        ]
      }
    },
    "expect": {
      "method": "GET",
      "path": "/api/gateway.php/test-subdomain/v1/employees/5",
      "query": {
        "fields": "firstName,jobTitle"
      }
    }
  },
