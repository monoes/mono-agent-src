{
  "employee.create": {
    "params": {
      "firstName": "Ann",
      "lastName": "Lee",
      "additionalFields": {
        "workEmail": "a@b.co",
        "gender": "female",
        "maritalStatus": "domesticPartnership",
        "payRate": {
          "value": {
            "value": "100",
            "currency": "USD"
          }
        }
      }
    },
    "expect": {
      "method": "POST",
      "path": "/api/gateway.php/test-subdomain/v1/employees",
      "body": {
        "firstName": "Ann",
        "lastName": "Lee",
        "workEmail": "a@b.co",
        "gender": "Female",
        "maritalStatus": "Domestic Partnership",
        "payRate": {
          "value": "100",
          "currency": "USD"
        }
      }
    }
  },
  "employee.get": {
