  "employeeDocument.update": {
    "params": {
      "employeeId": "5",
      "fileId": "9",
      "updateFields": {
        "name": "cv.pdf",
        "shareWithEmployee": false
      }
    },
    "expect": {
      "method": "POST",
      "path": "/api/gateway.php/test-subdomain/v1/employees/5/files/9",
      "body": {
        "name": "cv.pdf",
        "shareWithEmployee": "no"
      }
    }
  },
  "employeeDocument.upload": {
    "params": {
      "employeeId": "5",
      "categoryId": "12"
    },
    "input": {
      "file_name": "cv.pdf",
      "data": "aGVsbG8="
    },
    "expect": {
      "method": "POST",
      "path": "/api/gateway.php/test-subdomain/v1/employees/5/files",
      "body": {
        "fileName": "cv.pdf",
        "category": "12",
        "share": "yes",
        "file": "file:cv.pdf:hello"
      }
    }
  },
