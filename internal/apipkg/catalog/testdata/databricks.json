        "value": "w1"
      },
      "query": "select 1 as a",
      "queryParameters": {
        "parameters": [
          {
            "name": "x",
            "value": "1",
            "type": "INT"
          }
        ]
      }
    },
    "response": {
      "statement_id": "s1",
      "status": {
        "state": "SUCCEEDED"
      },
      "manifest": {
        "schema": {
          "columns": [
            {
              "name": "a"
            }
          ]
        }
      },
      "result": {
        "data_array": [
          [
            "1"
          ],
          [
            "2"
          ]
        ]
      }
    },
    "expect": {
      "method": "POST",
      "path": "/api/2.0/sql/statements",
      "body": {
        "warehouse_id": "w1",
        "statement": "select 1 as a",
        "wait_timeout": "50s",
        "on_wait_timeout": "CONTINUE",
        "parameters": [
          {
            "name": "x",
            "value": "1",
            "type": "INT"
          }
        ]
      },
      "items": 2
    },
    "credential": {
      "host": "https://adb-1.azuredatabricks.net",
      "access_token": "dapi1"
    }
  },
