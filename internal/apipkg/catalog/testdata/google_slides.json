{
  "presentation.create": {
    "params": {
      "title": "Deck"
    },
    "expect": {
      "method": "POST",
      "path": "/v1/presentations",
      "body": {
        "title": "Deck"
      }
    }
  },
  "presentation.get": {
    "params": {
      "presentationId": "https://docs.google.com/presentation/d/1PresAbcdefgh/edit"
    },
    "expect": {
      "method": "GET",
      "path": "/v1/presentations/1PresAbcdefgh"
    }
  },
  "presentation.getSlides": {
    "params": {
      "presentationId": "1PresAbcdefgh",
      "limit": 1
    },
    "response": {
      "slides": [
        {
          "objectId": "a"
        },
        {
          "objectId": "b"
        }
      ]
    },
    "expect": {
      "method": "GET",
      "path": "/v1/presentations/1PresAbcdefgh",
      "query": {
        "fields": "slides"
      },
      "items": 1
    }
  },
  "presentation.replaceText": {
    "params": {
      "presentationId": "1PresAbcdefgh",
      "textUi": {
        "textValues": [
          {
            "text": "[name]",
            "replaceText": "Ada",
            "pageObjectIds": [
              "p1"
            ]
          }
        ]
      },
      "options": {
        "revisionId": "r1"
      }
    },
    "expect": {
      "method": "POST",
      "path": "/v1/presentations/1PresAbcdefgh:batchUpdate",
      "body": {
        "requests": [
          {
            "replaceAllText": {
              "replaceText": "Ada",
              "pageObjectIds": [
                "p1"
              ],
              "containsText": {
                "text": "[name]",
                "matchCase": false
              }
            }
          }
        ],
        "writeControl": {
          "requiredRevisionId": "r1"
        }
      }
    }
  },
  "page.get": {
    "params": {
      "presentationId": "1PresAbcdefgh",
      "pageObjectId": "p1"
    },
    "expect": {
      "method": "GET",
      "path": "/v1/presentations/1PresAbcdefgh/pages/p1"
    }
  },
  "page.getThumbnail": {
    "params": {
      "presentationId": "1PresAbcdefgh",
      "pageObjectId": "p1",
      "download": true
    },
    "expect": {
      "method": "GET",
      "path": "/v1/presentations/1PresAbcdefgh/pages/p1/thumbnail",
      "items": 1
    },
    "response": {
      "contentUrl": "https://lh3.googleusercontent.test/thumb1",
      "width": 800
    }
  }
}
