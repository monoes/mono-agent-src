{
  "file.upload": {
    "params": {
      "fileName": "a.txt",
      "binaryData": true,
      "parentId": "12"
    },
    "response": {
      "entries": [
        {
          "id": "f1"
        }
      ]
    },
    "input": {
      "data": "aGk="
    },
    "expect": {
      "method": "POST",
      "path": "/api/2.0/files/content",
      "body": {
        "attributes": "{\"name\":\"a.txt\",\"parent\":{\"id\":\"12\"}}",
        "file": "file:a.txt:hi"
      },
      "items": 1
    }
  },
  "file.copy": {
    "params": {
      "fileId": "f1",
      "additionalFields": {
        "name": "b.txt",
        "fields": "name"
      }
    },
    "expect": {
      "method": "POST",
      "path": "/2.0/files/f1/copy",
      "query": {
        "fields": "name"
      },
      "body": {
        "name": "b.txt",
        "parent": {
          "id": "0"
        }
      }
    }
  },
