  "file.search": {
    "params": {
      "query": "report",
      "limit": 5,
      "additionalFields": {
        "contet_types": "name,description",
        "sort": "modified_at",
        "createdRangeUi": {
          "createdRangeValuesUi": {
            "from": "2024-01-01T00:00:00Z",
            "to": "2024-02-01T00:00:00Z"
          }
        }
      }
    },
    "response": {
      "entries": [
        {
          "id": 1
        }
      ]
    },
    "expect": {
      "method": "GET",
      "path": "/2.0/search",
      "query": {
        "type": "file",
        "query": "report",
        "sort": "modified_at",
        "content_types": "name,description",
        "created_at_range": "2024-01-01T00:00:00Z,2024-02-01T00:00:00Z",
        "offset": "0",
        "limit": "5"
      },
      "items": 1
    }
  },
  "file.share": {
    "params": {
      "fileId": "f1",
      "accessibleBy": "user",
      "email": "a@b.co",
      "role": "previewerUploader",
      "options": {
        "notify": true
      }
    },
    "expect": {
      "method": "POST",
      "path": "/2.0/collaborations",
      "query": {
        "notify": "true"
      },
      "body": {
        "item": {
          "id": "f1",
          "type": "file"
        },
        "role": "previewer uploader",
        "accessible_by": {
          "type": "user",
          "login": "a@b.co"
        }
      }
    }
  },
