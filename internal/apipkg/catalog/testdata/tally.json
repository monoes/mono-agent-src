        {
          "id": "s2"
        },
        {
          "id": "s3"
        }
      ]
    },
    "expect": {
      "method": "GET",
      "path": "/forms/nW8xYz/submissions",
      "query": {
        "filter": "completed",
        "startDate": "2026-10-01T00:00:00Z",
        "page": "1",
        "limit": "100"
      },
      "items": 3
    }
  },
  "submission.get": {
