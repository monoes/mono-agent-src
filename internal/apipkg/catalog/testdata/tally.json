        ],
        "signingSecret": "s3cret",
        "httpHeaders": [
          {
            "name": "X-Token",
            "value": "abc"
          }
        ]
      }
    }
  },
  "webhook.update": {
    "params": {
      "webhookId": "h1",
      "updateFields": {
        "url": "https://example.test/webhook/new",
        "isEnabled": "false"
      }
    },
    "expect": {
      "method": "PATCH",
      "path": "/webhooks/h1",
