{
  "file.upload": {
    "params": {
      "path": "/docs/a b.txt",
      "fileContent": "hello"
    },
    "expect": {
      "method": "PUT",
      "path": "/remote.php/webdav/docs/a%20b.txt",
      "body": "hello"
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "file.copy": {
    "params": {
      "path": "a.txt",
      "toPath": "/b.txt"
    },
    "expect": {
      "method": "COPY",
      "path": "/remote.php/webdav/a.txt",
      "headers": {
        "Destination": "https://cloud.example.com/remote.php/webdav/b.txt"
      }
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "file.delete": {
    "params": {
      "path": "a.txt"
    },
    "expect": {
      "method": "DELETE",
      "path": "/remote.php/webdav/a.txt"
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "file.download": {
    "params": {
      "path": "a.txt"
    },
    "expect": {
      "method": "GET",
      "path": "/remote.php/webdav/a.txt",
      "items": 1
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "file.move": {
    "params": {
      "path": "a.txt",
      "toPath": "x/b.txt"
    },
    "expect": {
      "method": "MOVE",
      "path": "/remote.php/webdav/a.txt",
      "headers": {
        "Destination": "https://cloud.example.com/remote.php/webdav/x/b.txt"
      }
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "file.share": {
    "params": {
      "path": "/a.txt",
      "shareType": 3,
      "options": {
        "password": "pw",
        "permissions": 1
      }
    },
    "expect": {
      "method": "POST",
      "path": "/ocs/v2.php/apps/files_sharing/api/v1/shares",
      "body": {
        "path": "/a.txt",
        "shareType": "3",
        "password": "pw",
        "permissions": "1"
      },
      "headers": {
        "OCS-APIRequest": "true"
      }
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "folder.create": {
    "params": {
      "path": "/new"
    },
    "expect": {
      "method": "MKCOL",
      "path": "/remote.php/webdav/new"
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "folder.copy": {
    "params": {
      "path": "/a",
      "toPath": "/b"
    },
    "expect": {
      "method": "COPY",
      "path": "/remote.php/webdav/a"
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "folder.delete": {
    "params": {
      "path": "/a"
    },
    "expect": {
      "method": "DELETE",
      "path": "/remote.php/webdav/a"
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "folder.list": {
    "params": {
      "path": "/docs"
    },
    "expect": {
      "method": "PROPFIND",
      "path": "/remote.php/webdav/docs",
      "headers": {
        "Depth": "1"
      },
      "items": 2
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    },
    "response": {
      "multistatus": {
        "response": [
          {
            "href": "/remote.php/webdav/docs/",
            "propstat": {
              "prop": {
                "resourcetype": {
                  "collection": ""
                },
                "getetag": "\"d1\""
              }
            }
          },
          {
            "href": "/remote.php/webdav/docs/a.txt",
            "propstat": {
              "prop": {
                "resourcetype": "",
                "getetag": "\"e1\"",
                "getcontentlength": "3"
              }
            }
          },
          {
            "href": "/remote.php/webdav/docs/sub/",
            "propstat": {
              "prop": {
                "resourcetype": {
                  "collection": ""
                },
                "getetag": "\"e2\""
              }
            }
          }
        ]
      }
    }
  },
  "folder.move": {
    "params": {
      "path": "/a",
      "toPath": "/b"
    },
    "expect": {
      "method": "MOVE",
      "path": "/remote.php/webdav/a"
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "folder.share": {
    "params": {
      "path": "/docs",
      "shareType": 0,
      "user": "bob"
    },
    "expect": {
      "method": "POST",
      "path": "/ocs/v2.php/apps/files_sharing/api/v1/shares",
      "body": {
        "path": "/docs",
        "shareType": "0",
        "shareWith": "bob"
      }
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "user.create": {
    "params": {
      "userId": "bob",
      "email": "b@x.io",
      "additionalFields": {
        "displayName": "Bob"
      }
    },
    "expect": {
      "method": "POST",
      "path": "/ocs/v1.php/cloud/users",
      "body": {
        "userid": "bob",
        "email": "b@x.io",
        "displayName": "Bob"
      }
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "user.delete": {
    "params": {
      "userId": "bob"
    },
    "expect": {
      "method": "DELETE",
      "path": "/ocs/v1.php/cloud/users/bob"
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "user.get": {
    "params": {
      "userId": "bob"
    },
    "expect": {
      "method": "GET",
      "path": "/ocs/v1.php/cloud/users/bob"
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "user.getAll": {
    "params": {
      "limit": 5,
      "options": {
        "search": "b"
      }
    },
    "expect": {
      "method": "GET",
      "path": "/ocs/v1.php/cloud/users",
      "query": {
        "search": "b",
        "limit": "5"
      }
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  },
  "user.update": {
    "params": {
      "userId": "bob",
      "updateFields": {
        "field": {
          "key": "email",
          "value": "n@x.io"
        }
      }
    },
    "expect": {
      "method": "PUT",
      "path": "/ocs/v1.php/cloud/users/bob",
      "body": {
        "key": "email",
        "value": "n@x.io"
      }
    },
    "credential": {
      "web_dav_url": "https://cloud.example.com/remote.php/webdav",
      "user": "u",
      "password": "p"
    }
  }
}
