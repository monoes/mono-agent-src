  "page.create": {
    "params": {
      "site": {
        "__rl": true,
        "mode": "list",
        "value": "c1"
      },
      "space": "9",
      "title": "Hello",
      "bodyPlainText": "a < b\n\nline 2",
      "parentPage": "7"
    },
    "expect": {
      "method": "POST",
      "path": "/ex/confluence/c1/wiki/api/v2/pages",
      "query": {},
      "body": {
        "spaceId": "9",
        "status": "current",
        "title": "Hello",
        "body": {
          "representation": "storage",
          "value": "<p>a &lt; b</p><p>line 2</p>"
        },
        "parentId": "7"
      }
    }
  },
