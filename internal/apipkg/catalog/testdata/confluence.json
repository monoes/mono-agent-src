  "search.query": {
    "params": {
      "site": {
        "__rl": true,
        "mode": "list",
        "value": "c1"
      },
      "cql": "type=page",
      "limit": 10,
      "options": {
        "fetchFullPageContent": true,
        "contentStatuses": [
          "current"
        ]
      }
    },
    "expect": {
      "method": "GET",
      "path": "/ex/confluence/c1/wiki/rest/api/search",
      "query": {
        "cql": "type=page",
        "expand": "content.body.storage",
        "cqlcontext": "{\"contentStatuses\":[\"current\"]}",
        "limit": "10"
      },
      "items": 1
    },
    "response": {
      "results": [
        {
          "id": 1
        }
      ]
    }
  },
