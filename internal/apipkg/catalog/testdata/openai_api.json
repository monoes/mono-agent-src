  "conversation.create": {
    "credential": {
      "api_key": "sk-test",
      "organization_id": "org-1"
    },
    "params": {
      "messages": {
        "values": [
          {
            "type": "text",
            "role": "system",
            "content": "Be brief"
          },
          {
            "type": "text",
            "role": "user",
            "content": "Hi"
          },
          {
            "type": "text",
            "role": "assistant",
            "content": "Hello"
          }
        ]
      },
      "options": {
        "metadata": "{\"topic\": \"demo\"}"
      }
    },
    "response": {
      "id": "conv_1",
      "object": "conversation"
    },
    "expect": {
      "method": "POST",
      "path": "/v1/conversations",
      "body": {
        "items": [
          {
            "role": "system",
            "content": [
              {
                "type": "input_text",
                "text": "Be brief"
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "input_text",
                "text": "Hi"
              }
            ]
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "output_text",
                "text": "Hello",
                "annotations": []
              }
            ]
          }
        ],
        "metadata": {
          "topic": "demo"
        }
      },
      "items": 1
    }
  },
