  },
  "image.analyze": {
    "credential": {
      "api_key": "sk-test",
      "organization_id": "org-1"
    },
    "params": {
      "modelId": "gpt-4o-mini",
      "text": "What is it?",
      "inputType": "base64",
      "binaryPropertyName": "data",
      "options": {
        "detail": "low"
      }
    },
    "input": {
      "binary": {
        "data": {
          "data": "UE5H",
          "mimeType": "image/png",
          "fileName": "a.png"
        }
      }
    },
    "response": {
      "id": "resp_1",
      "output": [
        {
          "type": "message",
          "role": "assistant",
          "content": [
            {
              "type": "output_text",
              "text": "a cat"
            }
          ]
        }
      ]
    },
    "expect": {
      "method": "POST",
      "path": "/v1/responses",
      "body": {
        "model": "gpt-4o-mini",
        "max_output_tokens": 300,
        "input": [
          {
            "role": "user",
            "content": [
              {
                "type": "input_text",
                "text": "What is it?"
              },
              {
                "type": "input_image",
                "detail": "low",
                "image_url": "data:image/png;base64,UE5H"
              }
            ]
          }
        ]
      },
      "items": 1
    }
  },
  "image.edit": {
    "credential": {
      "api_key": "sk-test",
      "organization_id": "org-1"
    },
    "params": {
      "modelId": "gpt-image-1",
      "prompt": "add a hat",
      "images": {
        "values": [
          {
            "binaryPropertyName": "data"
          }
        ]
      },
      "outputFormat": "webp",
      "outputCompression": 80,
      "options": {
        "imageMask": "mask",
        "background": "transparent"
      }
    },
    "input": {
      "binary": {
        "data": {
          "data": "SU1H",
          "mimeType": "image/png",
          "fileName": "a.png"
        },
        "mask": {
          "data": "TUFTSw==",
          "mimeType": "image/png",
          "fileName": "m.png"
        }
      }
    },
    "response": {
      "data": [
        {
          "b64_json": "RURJVEVE"
        }
      ]
    },
    "expect": {
      "method": "POST",
      "path": "/v1/images/edits",
      "body": {
        "prompt": "add a hat",
        "model": "gpt-image-1",
        "n": "1",
        "size": "1024x1024",
        "background": "transparent",
        "output_format": "webp",
        "output_compression": "80",
        "quality": "auto",
        "image[]": "file:a.png:IMG",
        "mask": "file:m.png:MASK"
      },
      "items": 1
    }
  },
