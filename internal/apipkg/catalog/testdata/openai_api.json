  "video.generate": {
    "credential": {
      "api_key": "sk-test",
      "organization_id": "org-1"
    },
    "params": {
      "modelId": {
        "__rl": true,
        "mode": "list",
        "value": "sora-2"
      },
      "prompt": "a dog surfing",
      "seconds": 8,
      "size": "720x1280",
      "options": {
        "binaryPropertyNameReference": "ref",
        "fileName": "surf.mp4"
      }
    },
    "input": {
      "binary": {
        "ref": {
          "data": "UkVG",
          "mimeType": "image/png",
          "fileName": "ref.png"
        }
      }
    },
    "responses": [
      {
        "id": "video_1",
        "status": "completed"
      },
      {
        "ok": true
      }
    ],
    "expect": {
      "method": "POST",
      "path": "/v1/videos",
      "body": {
        "model": "sora-2",
        "prompt": "a dog surfing",
        "seconds": "8",
        "size": "720x1280",
        "input_reference": "file:ref.png:REF"
      },
      "items": 1
