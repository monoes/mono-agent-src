{
  "organization.create": {
    "params": {
      "name": "Acme",
      "domain": "acme.io",
      "additionalFields": {
        "persons": [
          1,
          2
        ]
      }
    },
    "expect": {
      "method": "POST",
      "path": "/organizations",
      "body": {
        "name": "Acme",
        "domain": "acme.io",
        "person_ids": [
          1,
          2
        ]
      }
    }
  },
  "organization.delete": {
    "params": {
      "organizationId": "5"
    },
    "expect": {
      "method": "DELETE",
      "path": "/organizations/5"
    }
  },
  "organization.get": {
    "params": {
      "organizationId": "5",
      "options": {
        "withInteractionDates": true
      }
    },
    "expect": {
      "method": "GET",
      "path": "/organizations/5",
      "query": {
        "with_interaction_dates": "true"
      }
    }
  },
  "organization.getAll": {
    "params": {
      "limit": 5,
      "options": {
        "term": "ac"
      }
    },
    "response": {
      "organizations": [
        {
          "id": 1
        }
      ],
      "page_token": null
    },
    "expect": {
      "method": "GET",
      "path": "/organizations",
      "query": {
        "term": "ac",
        "page_size": "5"
      },
      "items": 1
    }
  },
  "organization.update": {
    "params": {
      "organizationId": "5",
      "updateFields": {
        "name": "B"
      }
    },
    "expect": {
      "method": "PUT",
      "path": "/organizations/5",
      "body": {
        "name": "B"
      }
    }
  },
