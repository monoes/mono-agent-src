{
  "conversation.create": {
    "params": {
      "mailboxId": "5",
      "status": "active",
      "subject": "Hi",
      "type": "email",
      "additionalFields": {
        "customerEmail": "c@x",
        "tags": [
          "vip"
        ]
      },
      "threadsUi": {
        "threadsValues": [
          {
            "type": "customer",
            "text": "hello"
          },
          {
            "type": "note",
            "text": "n"
          }
        ]
      }
    },
    "response_status": 201,
    "expect": {
      "method": "POST",
      "path": "/v2/conversations",
      "body": {
        "mailboxId": 5,
        "status": "active",
        "subject": "Hi",
        "type": "email",
        "tags": [
          "vip"
        ],
        "customer": {
          "email": "c@x"
        },
        "threads": [
          {
            "type": "customer",
            "text": "hello",
            "customer": {
              "email": "c@x"
            }
          },
          {
            "type": "note",
            "text": "n"
          }
        ]
      }
    },
    "credential": {
      "access_token": "t"
    }
  },
  "conversation.delete": {
    "params": {
      "conversationId": "1"
    },
    "expect": {
      "method": "DELETE",
      "path": "/v2/conversations/1"
    },
    "credential": {
      "access_token": "t"
    }
  },
  "conversation.get": {
    "params": {
      "conversationId": "1"
    },
    "response": {
      "id": 1
    },
    "expect": {
      "method": "GET",
      "path": "/v2/conversations/1",
      "items": 1
    },
    "credential": {
      "access_token": "t"
    }
  },
  "conversation.getAll": {
    "params": {
      "limit": 2,
      "options": {
        "status": "all",
        "tags": [
          "a",
          "b"
        ]
      }
    },
    "response": {
      "_embedded": {
        "conversations": [
          {
            "id": 1
          },
          {
            "id": 2
          },
          {
            "id": 3
          }
        ]
      }
    },
    "expect": {
      "method": "GET",
      "path": "/v2/conversations",
      "query": {
        "status": "all",
        "tag": "a,b"
      },
      "items": 2
    },
    "credential": {
      "access_token": "t"
    }
  },
