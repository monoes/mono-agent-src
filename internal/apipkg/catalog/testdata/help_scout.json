  "thread.create": {
    "params": {
      "conversationId": "9",
      "type": "note",
      "text": "t",
      "additionalFields": {
        "customerId": 4
      },
      "attachmentsUi": {
        "attachmentsBinary": [
          {
            "property": "data"
          },
          {
            "property": "data2"
          }
        ]
      }
    },
    "input": {
      "data": "aGk=",
