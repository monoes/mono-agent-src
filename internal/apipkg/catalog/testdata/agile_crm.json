    },
    "expect": {
      "method": "DELETE",
      "path": "/dev/api/contacts/2"
    }
  },
  "company.getAll": {
    "params": {
      "returnAll": true
    },
    "expect": {
      "method": "POST",
      "path": "/dev/api/filters/filter/dynamic-filter",
      "body": {
        "filterJson": "{\"contact_type\":\"COMPANY\"}",
        "page_size": "100"
      }
    }
  },
  "company.update": {
    "params": {
      "companyId": "2",
      "jsonParameters": true,
      "additionalFieldsJson": "{\"properties\": [{\"type\": \"SYSTEM\", \"name\": \"phone\", \"value\": \"1\"}]}"
    },
    "expect": {
