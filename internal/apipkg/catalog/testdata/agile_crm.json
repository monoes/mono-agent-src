{
  "contact.get": {
    "params": {
      "contactId": "1"
    },
    "expect": {
      "method": "GET",
      "path": "/dev/api/contacts/1"
    }
  },
  "contact.create": {
    "params": {
      "additionalFields": {
        "firstName": "Ann",
        "starValue": "3",
        "tags": [
          "vip"
        ],
        "emailOptions": {
          "emailProperties": [
            {
              "subtype": "work",
              "email": "a@b.co"
            }
          ]
        },
        "customProperties": {
          "customProperty": [
            {
              "name": "Role",
              "subtype": "",
              "value": "CEO"
            }
          ]
        }
      }
    },
    "expect": {
      "method": "POST",
      "path": "/dev/api/contacts",
      "body": {
        "star_value": "3",
        "tags": [
          "vip"
        ],
        "properties": [
          {
            "type": "SYSTEM",
            "name": "first_name",
            "value": "Ann"
          },
          {
            "type": "SYSTEM",
            "subtype": "work",
            "name": "email",
            "value": "a@b.co"
          },
          {
            "type": "CUSTOM",
            "name": "Role",
            "value": "CEO"
          }
        ]
      }
    }
  },
  "contact.delete": {
    "params": {
      "contactId": "1"
    },
    "expect": {
      "method": "DELETE",
      "path": "/dev/api/contacts/1"
    }
  },
  "contact.getAll": {
    "params": {
      "limit": 5,
      "filterType": "manual",
      "matchType": "allFilters",
      "filters": {
        "conditions": [
          {
            "field": "tags",
            "condition_type": "EQUALS",
            "value": "vip"
          }
        ]
      },
      "options": {
        "sort": {
          "sort": {
            "direction": "DESC",
            "field": "created_time"
          }
        }
      }
    },
    "response": [
      {
        "id": 1
      },
      {
        "id": 2,
        "cursor": "c"
      }
    ],
    "expect": {
      "method": "POST",
      "path": "/dev/api/filters/filter/dynamic-filter",
      "body": {
        "filterJson": "{\"contact_type\":\"PERSON\",\"rules\":[{\"CONDITION\":\"EQUALS\",\"LHS\":\"tags\",\"RHS\":\"vip\"}]}",
        "global_sort_key": "-created_time",
        "page_size": "5"
      },
      "items": 2
    }
  },
  "contact.update": {
    "params": {
      "contactId": "1",
      "additionalFields": {
        "lastName": "Lee",
        "tags": [
          "a"
        ]
      }
    },
    "expect": {
      "method": "PUT",
      "path": "/dev/api/contacts/edit-properties",
      "body": {
        "id": "1",
        "properties": [
          {
            "type": "SYSTEM",
            "name": "last_name",
            "value": "Lee"
          }
        ]
      }
    }
  },
