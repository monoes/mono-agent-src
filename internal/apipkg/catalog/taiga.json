    {
      "resource": "epic",
      "operation": "getAll",
      "title": "Get many epics",
      "method": "GET",
      "path": "/epics",
      "before": {
        "method": "POST",
        "path": "/auth",
        "body": {
          "type": "normal",
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "headers": {
        "x-disable-pagination": "True"
      },
      "fields": [
        {
          "key": "projectId",
          "label": "Project ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "assigned_to",
            "statusIsClosed"
          ]
        }
      ],
      "query": {
        "project": "{{ p.projectId }}",
        "$merge": "{{ p.filters | omit:'statusIsClosed' }}",
        "status__is_closed": "{{ p.filters.statusIsClosed }}"
      },
      "output": {
        "limit": true
      }
    },
    {
      "resource": "epic",
      "operation": "update",
