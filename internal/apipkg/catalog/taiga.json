        "$merge": "{{ p.filters | omit:'statusIsClosed,userStory' }}",
        "status__is_closed": "{{ p.filters.statusIsClosed }}",
        "user_story": "{{ p.filters.userStory }}"
      },
      "output": {
        "limit": true
      }
    },
    {
