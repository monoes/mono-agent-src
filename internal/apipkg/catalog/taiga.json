          ]
        }
      ],
      "query": {
        "project": "{{ p.projectId }}",
        "$merge": "{{ p.filters | omit:'statusIsClosed,statusIsArchived' }}",
        "status__is_closed": "{{ p.filters.statusIsClosed }}",
        "status__is_archived": "{{ p.filters.statusIsArchived }}"
