{
  "$schema": "apipkg.v1",
  "id": "taiga",
  "title": "Taiga",
  "description": "Epics, issues, tasks and user stories in Taiga (cloud or self-hosted)",
  "category": "app",
  "docs_url": "https://docs.taiga.io/api.html",
  "n8n_types": [
    "n8n-nodes-base.taiga"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.taigaTrigger"
  ],
  "base_url": "{{ cred.url | re:'^(.*?)/*$' | default:'https://api.taiga.io' }}/api/v1",
  "credentials": [
    {
      "platform": "taiga",
      "name": "Taiga",
      "n8n_credential": "taigaApi",
      "n8n_field_map": {
        "username": "username",
        "password": "password",
        "url": "url"
      },
      "methods": [
        "basic"
      ],
      "fields": [
        {
          "key": "username",
          "label": "Username",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "secret": true,
          "required": true
        },
        {
          "key": "url",
          "label": "Self-hosted URL",
          "help": "Leave empty for taiga.io cloud"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ pres.0.auth_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "issue",
      "label": "Issue"
    },
    {
      "value": "epic",
      "label": "Epic"
    },
    {
      "value": "task",
      "label": "Task"
    },
    {
      "value": "userStory",
      "label": "User Story"
    }
  ],
  "operations": [
    {
      "resource": "issue",
      "operation": "create",
      "title": "Create a issue",
      "method": "POST",
      "path": "/issues",
      "before": {
        "method": "POST",
        "path": "/auth",
        "body": {
          "type": "normal",
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "fields": [
        {
          "key": "projectId",
          "label": "Project ID",
          "type": "text",
          "required": true
        },
        {
          "key": "subject",
          "label": "Subject",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "assigned_to",
            "blocked_note",
            "description",
            "is_blocked",
            "milestone",
            "priority",
            "severity",
            "status",
            "tags",
            "type"
          ]
        }
      ],
      "body": {
        "project": "{{ p.projectId }}",
        "subject": "{{ p.subject }}",
        "$merge": "{{ p.additionalFields }}"
      }
    },
    {
      "resource": "issue",
      "operation": "delete",
      "title": "Delete a issue",
      "method": "DELETE",
      "path": "/issues/{{ p.issueId }}",
      "before": {
        "method": "POST",
        "path": "/auth",
        "body": {
          "type": "normal",
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "fields": [
        {
          "key": "issueId",
          "label": "Issue ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "issue",
      "operation": "get",
      "title": "Get a issue",
      "method": "GET",
      "path": "/issues/{{ p.issueId }}",
      "before": {
        "method": "POST",
        "path": "/auth",
        "body": {
          "type": "normal",
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "fields": [
        {
          "key": "issueId",
          "label": "Issue ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "issue",
      "operation": "getAll",
      "title": "Get many issues",
      "method": "GET",
      "path": "/issues",
      "before": {
        "method": "POST",
        "path": "/auth",
        "body": {
          "type": "normal",
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "headers": {
        "x-disable-pagination": "True"
      },
      "fields": [
        {
          "key": "projectId",
          "label": "Project ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "assigned_to",
            "orderBy",
            "owner",
            "priority",
            "role",
            "severity",
            "status",
            "tags",
            "type"
          ]
        }
      ],
      "query": {
        "project": "{{ p.projectId }}",
        "$merge": "{{ p.filters | omit:'orderBy' }}",
        "order_by": "{{ p.filters.orderBy }}"
      },
      "output": {
        "limit": true
      }
    },
    {
      "resource": "issue",
      "operation": "update",
      "title": "Update a issue",
      "description": "Reads the current version first, as Taiga requires it",
      "method": "PATCH",
      "path": "/issues/{{ p.issueId }}",
      "before": [
        {
          "method": "POST",
          "path": "/auth",
          "body": {
            "type": "normal",
            "username": "{{ cred.username }}",
            "password": "{{ cred.password }}"
          }
        },
        {
          "method": "GET",
          "path": "/issues/{{ p.issueId }}"
        }
      ],
      "fields": [
        {
          "key": "issueId",
          "label": "Issue ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "assigned_to",
            "blocked_note",
            "description",
            "is_blocked",
            "milestone",
            "priority",
            "severity",
            "status",
            "subject",
            "tags",
            "type"
          ]
        }
      ],
      "body": {
        "$merge": "{{ p.updateFields }}",
        "version": "{{ pres.1.version }}"
      }
    },
