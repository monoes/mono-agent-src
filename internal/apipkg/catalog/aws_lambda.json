{
  "$schema": "apipkg.v1",
  "id": "aws_lambda",
  "node_type": "app.aws_lambda",
  "title": "AWS Lambda",
  "description": "Invoke AWS Lambda functions",
  "category": "app",
  "docs_url": "https://docs.aws.amazon.com/lambda/latest/api/API_Invoke.html",
  "n8n_types": [
    "n8n-nodes-base.awsLambda"
  ],
  "base_url": "https://lambda.{{ cred.region | default:'us-east-1' }}.amazonaws.com{{ cred.region | matches:'^cn-' | then:'.cn' }}",
  "credentials": [
    {
      "platform": "aws",
      "reuse_platform": "aws",
      "name": "AWS",
      "n8n_credential": "aws",
      "n8n_field_map": {
        "accessKeyId": "access_key_id",
        "secretAccessKey": "secret_access_key",
        "sessionToken": "session_token",
        "region": "region",
        "stsAccessKeyId": "access_key_id",
        "stsSecretAccessKey": "secret_access_key",
        "stsSessionToken": "session_token",
        "roleArn": "role_arn",
        "externalId": "external_id",
        "roleSessionName": "role_session_name"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "access_key_id",
          "label": "Access key ID",
          "required": true
        },
        {
          "key": "secret_access_key",
          "label": "Secret access key",
          "secret": true,
          "required": true
        },
        {
          "key": "region",
          "label": "Region",
          "help": "Default us-east-1"
        },
        {
          "key": "session_token",
          "label": "Session token",
          "secret": true,
          "help": "Only for temporary credentials"
        }
      ],
      "inject": {
        "aws_sigv4": {
          "service": "lambda",
          "region": "{{ cred.region | default:'us-east-1' }}"
        }
      },
      "n8n_credential_alt": [
        "awsAssumeRole"
      ]
    }
  ],
  "operations": [
    {
      "resource": "",
      "operation": "invoke",
      "title": "Invoke a function",
      "method": "POST",
      "path": "/2015-03-31/functions/{{ p.function }}/invocations",
      "query": {
        "Qualifier": "{{ p.qualifier }}"
      },
      "headers": {
        "X-Amz-Invocation-Type": "{{ p.invocationType }}",
        "Content-Type": "application/x-amz-json-1.0"
      },
      "body_type": "raw",
      "body": "{{ p.payload }}",
      "fields": [
        {
          "key": "function",
          "label": "Function",
          "type": "text",
          "required": true,
          "help": "Function name or ARN"
        },
        {
          "key": "qualifier",
          "label": "Qualifier",
          "type": "text",
          "required": true,
          "default": "$LATEST",
          "help": "Version or alias to run"
        },
        {
          "key": "invocationType",
          "label": "Invocation type",
          "type": "select",
          "default": "RequestResponse",
          "options": [
            "RequestResponse",
            "Event"
          ],
          "help": "RequestResponse waits for the result; Event queues the call and returns at once"
        },
        {
          "key": "payload",
          "label": "JSON input",
          "type": "textarea",
          "default": "",
          "help": "JSON event passed to the function"
        }
      ],
      "output": {
        "to": {
          "result": "{{ el }}"
        }
      },
      "error_when": "{{ hdr.X-Amz-Function-Error | default:res.errorMessage }}",
      "error_message": "{{ res.errorType | suffix:': ' }}{{ res.errorMessage | default:hdr.X-Amz-Function-Error }}"
    }
  ]
}
