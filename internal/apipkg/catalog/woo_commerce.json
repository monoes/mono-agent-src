      "body": {
        "currency": "{{ p.additionalFields.currency }}",
        "customer_id": "{{ p.additionalFields.customerId }}",
        "customer_note": "{{ p.additionalFields.customerNote }}",
        "parent_id": "{{ p.additionalFields.parentId }}",
        "payment_method": "{{ p.additionalFields.paymentMethodId }}",
        "payment_method_title": "{{ p.additionalFields.paymentMethodTitle }}",
        "set_paid": "{{ p.additionalFields.setPaid }}",
        "status": "{{ p.additionalFields.status }}",
        "transaction_id": "{{ p.additionalFields.transactionID }}",
        "billing": {
          "$entries": "{{ p.billingUi.billingValues | entries }}",
          "$key": "{{ el.key | snake }}",
          "$value": "{{ el.value }}"
        },
        "shipping": {
          "$entries": "{{ p.shippingUi.shippingValues | entries }}",
