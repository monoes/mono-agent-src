    {
      "resource": "customer",
      "operation": "create",
      "title": "Create a customer",
      "method": "POST",
      "path": "/customers",
      "body": {
        "email": "{{ p.email }}",
        "$merge": "{{ p.additionalFields | omit:'meta_data' }}",
        "meta_data": "{{ p.additionalFields.meta_data.meta_data_fields }}"
      },
      "fields": [
        {
          "key": "email",
          "label": "Email",
          "type": "text",
          "required": true
