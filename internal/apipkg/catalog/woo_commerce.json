        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "billing",
            "first_name",
            "last_name",
            "meta_data",
            "password",
            "shipping",
            "username"
          ],
          "help": "billing/shipping: address objects; meta_data: {\"meta_data_fields\": [{\"key\", \"value\"}]}"
        }
      ]
    },
    {
      "resource": "customer",
      "operation": "delete",
      "title": "Delete a customer",
      "method": "DELETE",
      "path": "/customers/{{ p.customerId }}",
      "query": {
        "force": "true"
      },
      "fields": [
        {
          "key": "customerId",
          "label": "Customer ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "customer",
      "operation": "get",
      "title": "Get a customer",
      "method": "GET",
      "path": "/customers/{{ p.customerId }}",
      "fields": [
        {
          "key": "customerId",
          "label": "Customer ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "customer",
      "operation": "getAll",
      "title": "Get many customers",
      "method": "GET",
      "path": "/customers",
      "query": {
        "$merge": "{{ p.filters }}"
      },
      "pagination": {
        "type": "link_header",
        "limit_param": "per_page",
        "page_size": 100
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "email",
            "order",
            "orderby"
          ]
        }
      ]
    },
    {
      "resource": "customer",
      "operation": "update",
      "title": "Update a customer",
      "method": "PUT",
      "path": "/customers/{{ p.customerId }}",
      "body": {
        "$merge": "{{ p.updateFields | omit:'meta_data' }}",
        "meta_data": "{{ p.updateFields.meta_data.meta_data_fields }}"
      },
      "fields": [
        {
          "key": "customerId",
          "label": "Customer ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "billing",
            "first_name",
            "last_name",
            "meta_data",
            "password",
            "shipping",
            "username"
          ]
        }
      ]
    }
  ],
  "webhook": {
    "fields": [
      {
        "key": "event",
        "label": "Event",
        "type": "text",
        "required": true
      }
    ],
    "create": [
      {
        "method": "POST",
        "path": "/webhooks",
        "body": {
          "delivery_url": "{{ hook.url }}",
          "topic": "{{ p.event }}",
          "secret": "{{ hook.secret }}"
        }
      }
    ],
    "id": "{{ res.id }}",
    "delete": [
      {
        "method": "DELETE",
        "path": "/webhooks/{{ hook.id }}",
        "query": {
          "force": "true"
        }
      }
    ],
    "verify": {
      "signature": "{{ hdr.X-WC-Webhook-Signature }}",
      "encoding": "base64"
    }
  }
}
