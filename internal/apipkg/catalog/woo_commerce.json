{
  "$schema": "apipkg.v1",
  "id": "woo_commerce",
  "title": "WooCommerce",
  "description": "Customers, orders and products in a WooCommerce store",
  "category": "app",
  "docs_url": "https://woocommerce.github.io/woocommerce-rest-api-docs/",
  "n8n_types": [
    "n8n-nodes-base.wooCommerce"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.wooCommerceTrigger"
  ],
  "base_url": "{{ cred.url | re:'^(.*?)/?$' }}/wp-json/wc/v3",
  "credentials": [
    {
      "platform": "woo_commerce",
      "name": "WooCommerce",
      "n8n_credential": "wooCommerceApi",
      "n8n_field_map": {
        "consumerKey": "consumer_key",
        "consumerSecret": "consumer_secret",
        "url": "url",
        "includeCredentialsInQuery": "include_credentials_in_query"
      },
      "methods": [
        "basic"
      ],
      "fields": [
        {
          "key": "url",
          "label": "Store URL",
          "required": true,
          "help": "e.g. https://shop.example.com"
        },
        {
          "key": "consumer_key",
          "label": "Consumer key",
          "required": true
        },
        {
          "key": "consumer_secret",
          "label": "Consumer secret",
          "secret": true,
          "required": true
        },
        {
          "key": "include_credentials_in_query",
          "label": "Send keys in the query string",
          "help": "true for servers that drop the Authorization header"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "{{ (cred.include_credentials_in_query | default:'false' | bool) | ne:'true' | then:(cred.consumer_key | suffix:':' | suffix:cred.consumer_secret | base64 | prefix:'Basic ') }}"
        },
        "query": {
          "consumer_key": "{{ (cred.include_credentials_in_query | default:'false' | bool) | eq:'true' | then:cred.consumer_key }}",
          "consumer_secret": "{{ (cred.include_credentials_in_query | default:'false' | bool) | eq:'true' | then:cred.consumer_secret }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "product",
      "label": "Product"
    },
    {
      "value": "customer",
      "label": "Customer"
    },
    {
      "value": "order",
      "label": "Order"
    }
  ],
  "operations": [
    {
      "resource": "product",
      "operation": "create",
      "title": "Create a product",
      "method": "POST",
      "path": "/products",
      "body": {
        "name": "{{ p.name }}",
        "$merge": {
          "$entries": "{{ p.additionalFields | omit:'tags,categories' | entries }}",
          "$key": "{{ el.key | snake }}",
          "$value": "{{ el.value }}"
        },
        "tags": {
          "$map": "{{ p.additionalFields.tags }}",
          "$to": {
            "id": "{{ el | int }}"
          }
        },
        "categories": {
          "$map": "{{ p.additionalFields.categories }}",
          "$to": {
            "id": "{{ el | int }}"
          }
        },
        "images": "{{ p.imagesUi.imagesValues }}",
        "dimensions": "{{ p.dimensionsUi.dimensionsValues }}",
        "meta_data": "{{ p.metadataUi.metadataValues }}"
      },
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "backorders",
            "buttonText",
            "catalogVisibility",
            "categories",
            "crossSellIds",
            "dateOnSaleFrom",
            "dateOnSaleTo",
            "description",
            "downloadable",
            "externalUrl",
            "featured",
            "manageStock",
            "menuOrder",
            "parentId",
            "purchaseNote",
            "regularPrice",
            "reviewsAllowed",
            "salePrice",
            "shippingClass",
            "shortDescription",
            "sku",
            "slug",
            "soldIndividually",
            "status",
            "stockQuantity",
            "stockStatus",
            "tags",
            "taxClass",
            "taxStatus",
            "type",
            "upsellIds",
            "virtual",
            "weight"
          ]
        },
        {
          "key": "dimensionsUi",
          "label": "Dimensions",
          "type": "collection",
          "default": {},
          "options": [
            "dimensionsValues"
          ],
          "help": "{\"dimensionsValues\": {\"height\", \"length\", \"width\"}}"
        },
        {
          "key": "imagesUi",
          "label": "Images",
          "type": "collection",
          "default": {},
          "options": [
            "imagesValues"
          ],
          "help": "{\"imagesValues\": [{\"alt\", \"src\", \"name\"}]}"
        },
        {
          "key": "metadataUi",
          "label": "Metadata",
          "type": "collection",
          "default": {},
          "options": [
            "metadataValues"
          ],
          "help": "{\"metadataValues\": [{\"key\", \"value\"}]}"
        }
      ]
    },
    {
      "resource": "product",
      "operation": "delete",
      "title": "Delete a product",
      "method": "DELETE",
      "path": "/products/{{ p.productId }}",
      "query": {
        "force": "true"
      },
      "fields": [
        {
          "key": "productId",
          "label": "Product ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "product",
      "operation": "get",
      "title": "Get a product",
      "method": "GET",
      "path": "/products/{{ p.productId }}",
      "fields": [
        {
          "key": "productId",
          "label": "Product ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "product",
      "operation": "getAll",
      "title": "Get many products",
      "method": "GET",
      "path": "/products",
      "query": {
        "after": "{{ p.options.after }}",
        "before": "{{ p.options.before }}",
        "category": "{{ p.options.category }}",
        "context": "{{ p.options.context }}",
        "featured": "{{ p.options.featured | eq:'true' }}",
        "max_price": "{{ p.options.maxPrice }}",
        "min_price": "{{ p.options.minPrice }}",
        "order": "{{ p.options.order }}",
        "orderby": "{{ p.options.orderBy }}",
        "search": "{{ p.options.search }}",
        "sku": "{{ p.options.sku }}",
        "slug": "{{ p.options.slug }}",
        "status": "{{ p.options.status }}",
        "stock_status": "{{ p.options.stockStatus }}",
        "tag": "{{ p.options.tag }}",
        "tax_class": "{{ p.options.taxClass }}",
        "type": "{{ p.options.type }}"
      },
      "pagination": {
        "type": "link_header",
        "limit_param": "per_page",
        "page_size": 100
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "after",
            "before",
            "category",
            "context",
            "featured",
            "maxPrice",
            "minPrice",
            "order",
            "orderBy",
            "search",
            "sku",
            "slug",
            "status",
            "stockStatus",
            "tag",
            "taxClass",
            "type"
          ]
        }
      ]
    },
