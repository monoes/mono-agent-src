{
  "$schema": "apipkg.v1",
  "id": "elasticsearch",
  "node_type": "app.elasticsearch",
  "title": "Elasticsearch",
  "description": "Documents and indices in Elasticsearch",
  "category": "app",
  "docs_url": "https://www.elastic.co/guide/en/elasticsearch/reference/current/rest-apis.html",
  "n8n_types": [
    "n8n-nodes-base.elasticsearch"
  ],
  "base_url": "{{ cred.base_url }}",
  "credentials": [
    {
      "platform": "elasticsearch",
      "name": "Elasticsearch",
      "n8n_credential": "elasticsearchApi",
      "n8n_field_map": {
        "username": "username",
        "password": "password",
        "baseUrl": "base_url",
        "ignoreSSLIssues": "allow_unauthorized_certs"
      },
      "methods": [
        "basic"
      ],
      "fields": [
        {
          "key": "username",
          "label": "Username",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "secret": true,
          "required": true
        },
        {
          "key": "base_url",
          "label": "Base URL",
          "required": true,
          "help": "e.g. https://my-deployment.es.us-east-1.aws.found.io:9243"
        },
        {
          "key": "allow_unauthorized_certs",
          "label": "Ignore SSL issues",
          "help": "true to accept self-signed or invalid TLS certificates (self-hosted servers)"
        }
      ],
      "inject": {
        "basic": {
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "document",
      "label": "Document"
    },
    {
      "value": "index",
      "label": "Index"
    }
  ],
  "operations": [
    {
      "resource": "document",
      "operation": "get",
      "title": "Get a document",
      "method": "GET",
      "path": "/{{ p.indexId }}/_doc/{{ p.documentId }}",
      "fields": [
        {
          "key": "indexId",
          "label": "Index ID",
          "type": "text",
          "required": true
        },
        {
          "key": "documentId",
          "label": "Document ID",
          "type": "text",
          "required": true
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Return _id plus the document source"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "_source_excludes",
            "_source_includes",
            "stored_fields"
          ]
        }
      ],
      "query": {
        "$merge": "{{ p.options }}",
        "_source": "{{ p.options | then:true }}"
      },
      "output": {
        "to": {
          "_id": "{{ el._id }}",
          "$merge": "{{ el._source }}"
        },
        "to_when": "{{ p.simple }}"
      }
    },
    {
      "resource": "document",
      "operation": "create",
      "title": "Index (create) a document",
      "method": "POST",
      "path": "/{{ p.indexId }}/_doc{{ p.additionalFields.documentId | then:'/' }}{{ p.additionalFields.documentId }}",
      "fields": [
        {
          "key": "indexId",
          "label": "Index ID",
          "type": "text",
          "required": true
        },
        {
          "key": "dataToSend",
          "label": "Data to send",
          "type": "select",
          "default": "defineBelow",
          "options": [
            "defineBelow",
            "autoMapInputData"
          ]
        },
        {
          "key": "inputsToIgnore",
          "label": "Input fields to ignore",
          "type": "text",
          "default": "",
          "help": "Comma-separated (auto-map)"
        },
        {
          "key": "fieldsUi",
          "label": "Fields",
          "type": "collection",
          "default": {},
          "options": [
            "fieldValues"
          ],
          "help": "{\"fieldValues\": [{\"fieldId\", \"fieldValue\"}]}"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "documentId",
            "routing",
            "timeout"
          ]
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "bulkOperation",
            "pipeline",
            "refresh"
          ],
          "help": "refresh: true, wait_for or false. bulkOperation is accepted but each item is still sent as its own request"
        }
      ],
      "query": {
        "$merge": "{{ p.additionalFields | omit:'documentId' }}",
        "pipeline": "{{ p.options.pipeline }}",
        "refresh": "{{ p.options.refresh }}"
      },
      "body": {
        "$merge": [
          "{{ p.dataToSend | eq:'autoMapInputData' | then:(item | omit:(p.inputsToIgnore | split)) }}",
          "{{ p.fieldsUi.fieldValues | kv:'fieldId,fieldValue' }}"
        ]
      }
    },
    {
      "resource": "document",
      "operation": "delete",
      "title": "Delete a document",
      "method": "DELETE",
      "path": "/{{ p.indexId }}/_doc/{{ p.documentId }}",
      "fields": [
        {
          "key": "indexId",
          "label": "Index ID",
          "type": "text",
          "required": true
        },
        {
          "key": "documentId",
          "label": "Document ID",
          "type": "text",
          "required": true
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "bulkOperation"
          ],
          "help": "bulkOperation is accepted but each item is still sent as its own request"
        }
      ]
    },
    {
      "resource": "document",
      "operation": "getAll",
      "title": "Search documents",
      "method": "POST",
      "path": "/{{ p.indexId }}/_search",
      "fields": [
        {
          "key": "indexId",
          "label": "Index ID",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false,
          "help": "Up to 10,000 hits"
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "simple",
          "label": "Simplify",
          "type": "boolean",
          "default": true,
          "help": "Return _id plus the document source"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "allow_no_indices",
            "allow_partial_search_results",
            "batched_reduce_size",
            "ccs_minimize_roundtrips",
            "docvalue_fields",
            "expand_wildcards",
            "explain",
            "ignore_throttled",
            "ignore_unavailable",
            "max_concurrent_shard_requests",
            "pre_filter_shard_size",
            "query",
            "queryParameters",
            "request_cache",
            "routing",
            "search_type",
            "seq_no_primary_term",
            "sort",
            "_source_excludes",
            "_source_includes",
            "stats",
            "stored_fields",
            "terminate_after",
            "timeout",
            "track_scores",
            "track_total_hits",
            "version"
          ],
          "help": "query: Elasticsearch query DSL as JSON, e.g. {\"query\": {\"match\": {\"title\": \"x\"}}}; other keys are search URL parameters"
        }
      ],
      "query": {
        "$merge": "{{ p.options | omit:'query,queryParameters' }}",
        "_source": "{{ p.options | then:true }}",
        "size": "{{ p.returnAll | eq:'true' | then:10000 | default:p.limit }}"
      },
      "body": {
        "$merge": "{{ p.options.query | fromjson }}"
      },
      "output": {
        "to": {
          "_id": "{{ el._id }}",
          "$merge": "{{ el._source }}"
        },
        "to_when": "{{ p.simple }}",
        "path": "hits.hits"
      }
    },
    {
      "resource": "document",
      "operation": "update",
      "title": "Update a document",
      "method": "POST",
      "path": "/{{ p.indexId }}/_update/{{ p.documentId }}",
      "fields": [
        {
          "key": "indexId",
          "label": "Index ID",
          "type": "text",
          "required": true
        },
        {
          "key": "documentId",
          "label": "Document ID",
          "type": "text",
          "required": true
        },
        {
          "key": "dataToSend",
          "label": "Data to send",
          "type": "select",
          "default": "defineBelow",
          "options": [
            "defineBelow",
            "autoMapInputData"
          ]
        },
        {
          "key": "inputsToIgnore",
          "label": "Input fields to ignore",
          "type": "text",
          "default": "",
          "help": "Comma-separated (auto-map)"
        },
        {
          "key": "fieldsUi",
          "label": "Fields",
          "type": "collection",
          "default": {},
          "options": [
            "fieldValues"
          ],
          "help": "{\"fieldValues\": [{\"fieldId\", \"fieldValue\"}]}"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "bulkOperation",
            "refresh"
          ],
          "help": "bulkOperation is accepted but each item is still sent as its own request"
        }
      ],
      "query": {
        "refresh": "{{ p.options.refresh }}"
      },
      "body": {
        "doc": {
          "$merge": [
            "{{ p.dataToSend | eq:'autoMapInputData' | then:(item | omit:(p.inputsToIgnore | split)) }}",
            "{{ p.fieldsUi.fieldValues | kv:'fieldId,fieldValue' }}"
          ]
        }
      }
    },
    {
      "resource": "index",
      "operation": "create",
      "title": "Create an index",
      "method": "PUT",
      "path": "/{{ p.indexId }}",
      "fields": [
        {
          "key": "indexId",
          "label": "Index ID",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "aliases",
            "include_type_name",
            "mappings",
            "master_timeout",
            "settings",
            "timeout",
            "wait_for_active_shards"
          ],
          "help": "aliases, mappings, settings: JSON such as {\"settings\": {\"index\": {\"number_of_shards\": 3}}}"
        }
      ],
      "query": {
        "$merge": "{{ p.additionalFields | omit:'aliases,mappings,settings' }}"
      },
      "body": {
        "$merge": [
          "{{ p.additionalFields.aliases | fromjson }}",
          "{{ p.additionalFields.mappings | fromjson }}",
          "{{ p.additionalFields.settings | fromjson }}"
        ]
      },
      "output": {
        "to": {
          "id": "{{ p.indexId }}",
          "$merge": "{{ el | omit:'index' }}"
        }
      }
    },
    {
      "resource": "index",
      "operation": "delete",
      "title": "Delete an index",
      "method": "DELETE",
      "path": "/{{ p.indexId }}",
      "fields": [
        {
          "key": "indexId",
          "label": "Index ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "index",
      "operation": "get",
      "title": "Get an index",
      "method": "GET",
      "path": "/{{ p.indexId }}",
      "fields": [
        {
          "key": "indexId",
          "label": "Index ID",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "allow_no_indices",
            "expand_wildcards",
            "flat_settings",
            "ignore_unavailable",
            "include_defaults",
            "local",
            "master_timeout"
          ]
        }
      ],
      "query": {
        "$merge": "{{ p.additionalFields }}"
      },
      "output": {
        "path": "{{ p.indexId }}",
        "to": {
          "id": "{{ p.indexId }}",
          "$merge": "{{ el }}"
        }
      }
    },
    {
      "resource": "index",
      "operation": "getAll",
      "title": "Get many indices",
      "method": "GET",
      "path": "/_cat/indices",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "query": {
        "format": "json",
        "h": "index"
      },
      "pagination": {
        "type": "next_url",
        "next_url_path": "__single_page__",
        "results_path": ""
      },
      "output": {
        "to": {
          "indexId": "{{ el.index }}"
        }
      }
    }
  ]
}
