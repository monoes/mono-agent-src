{
  "name": "GitHub Issues to Linear",
  "description": "Webhook-triggered: each time an issue is opened in a GitHub repo, create a matching Linear issue. In the repo's Settings → Webhooks, point a webhook at http(s)://<host>:9321/webhook/github-issues with content type application/json, the \"Issues\" event and the same secret as the trigger's hmac_secret (GitHub's X-Hub-Signature-256 is checked). Set the Linear credential (credential_id) and team_id before activating.",
  "version": 1,
  "is_active": false,
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger.webhook",
      "name": "GitHub Webhook",
      "position": { "x": 0, "y": 0 },
      "disabled": false,
      "config": {
        "path": "github-issues",
        "method": "POST",
        "hmac_secret": "REPLACE_WITH_SECRET"
      }
    },
    {
      "id": "only_opened",
      "type": "core.filter",
      "name": "Only Opened Issues",
      "position": { "x": 320, "y": 0 },
      "disabled": false,
      "config": {
        "condition": "{{ eq (toString $json.action) \"opened\" }}"
      }
    },
    {
      "id": "create_linear",
      "type": "service.linear",
      "name": "Create Linear Issue",
      "position": { "x": 640, "y": 0 },
      "disabled": false,
      "config": {
        "credential_id": "",
        "team_id": "REPLACE_WITH_TEAM_ID",
        "operation": "create_issue",
        "title": "[gh] {{ $json.issue.title }}",
        "description": "Mirrored from GitHub issue #{{ $json.issue.number }}: {{ $json.issue.html_url }}",
        "priority": "2"
      }
    }
  ],
  "connections": [
    {
      "id": "trigger-to-only_opened",
      "source": "trigger",
      "source_handle": "main",
      "target": "only_opened",
      "target_handle": "main"
    },
    {
      "id": "only_opened-to-create_linear",
      "source": "only_opened",
      "source_handle": "main",
      "target": "create_linear",
      "target_handle": "main"
    }
  ]
}
