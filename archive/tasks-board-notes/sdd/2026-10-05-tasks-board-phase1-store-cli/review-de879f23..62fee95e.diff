 // byte order mark.
 func hidden(r rune) bool {
 	switch {
 	case r >= 0xE0000 && r <= 0xE007F:
 		return true
 	case r >= 0x202A && r <= 0x202E, r >= 0x2066 && r <= 0x2069:
 		return true
 	}
 	return r == 0xFEFF
