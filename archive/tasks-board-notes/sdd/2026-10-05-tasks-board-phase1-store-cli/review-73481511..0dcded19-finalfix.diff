 // operator returns the operator's actor, or the refusal an agent-driven caller gets.
 func (c taskCaller) operator(what string) (tasks.Actor, error) {
 	if !c.isAgent() {
 		return c.actor, nil
 	}
 	why := "--as or MONOAGENT_ACTOR names an agent"
