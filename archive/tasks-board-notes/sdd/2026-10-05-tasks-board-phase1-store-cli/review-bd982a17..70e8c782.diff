+		}
+	}
+	if historyNotice == untrustedNotice || strings.Contains(historyNotice, "\n") || strings.Contains(notesEnd, "\n") {
+		t.Errorf("the notices are one line each and the history's is its own: %q, %q", historyNotice, notesEnd)
