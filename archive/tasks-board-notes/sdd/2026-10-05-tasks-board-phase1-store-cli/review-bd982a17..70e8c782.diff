+// taskCut shortens s to at most n characters, ending in an ellipsis. With no room
+// (n below 1) it gives nothing.
 func taskCut(s string, n int) string {
+	if n < 1 {
+		return ""
+	}
 	if utf8.RuneCountInString(s) <= n {
 		return s
 	}
 	return string([]rune(s)[:n-1]) + "…"
 }
 
