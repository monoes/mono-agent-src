+	_, events, _ := s.Get(bg, "default", held.ID)
+	last := events[len(events)-1]
+	if last.Kind != "comment" || strings.ContainsRune(last.Note, 0x1b) || last.Actor != "one" {
+		t.Errorf("last event: %+v", last)
