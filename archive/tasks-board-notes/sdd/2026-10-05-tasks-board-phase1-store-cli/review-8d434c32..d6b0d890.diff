+
+func TestEventCapRefusesCommentsOnly(t *testing.T) {
+	s, db, _ := newTestStore(t)
+	task := mustAdd(t, s, "default", "chatty", true)
+	if _, err := s.Claim(bg, "default", task.ID, bot("one"), 0); err != nil {
